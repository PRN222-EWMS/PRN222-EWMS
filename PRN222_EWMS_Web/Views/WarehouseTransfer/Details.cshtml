@model PRN222_EWMS_Web.ViewModels.WarehouseTransfer.WarehouseTransferDetail
@using PRN222_EWMS_Web.ViewModels.Shared
@{
    ViewData["Title"] = Model.IsSource ? "Gửi chuyển kho" : "Nhận chuyển kho";
    if (ViewData["PickingFragment"] is true) { Layout = null; }
    var work = Model.Documents.FirstOrDefault(document => document.CanScan || document.CanScanReceipt);
    var selectedSerials = work?.Serials.Select(serial => serial.SerialNumber).ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
    var canAdd = work is not null && (Model.IsSource ? Model.DispatchSerialOptions.Count > 0
        : Model.ReceiptSerialOptions.Any(option => !selectedSerials.Contains(option.SerialNumber)));
    string Condition(string? value) => value switch { "GOOD" => "Tốt", "DAMAGED" => "Hỏng", null => "Chưa ghi nhận", _ => value };
    string Status(string value) => value switch { "DRAFT" => "Nháp", "RELEASED" => "Đã phát hành", "IN_PROGRESS" => "Đang thực hiện", "COMPLETED" or "DONE" => "Hoàn tất", "CANCELLED" => "Đã hủy", _ => value };
    string Location(int? id) => id.HasValue ? Model.PickLocations.GetValueOrDefault(id.Value, "Vị trí không còn trong cấu trúc kho") : "Hàng chờ xếp kho";
}
<div class="outbound-page outbound-picking-page outbound-transfer-page" data-outbound-workbench
     data-work-mode="@(Model.IsSource ? "transfer-dispatch" : "transfer-receive")"
     data-refresh-url="@Url.Action("Details", new { id = Model.Id, fragment = true })"
     data-version="" data-can-add="@canAdd.ToString().ToLowerInvariant()">
    <header class="workspace-heading">
        <div><p class="eyebrow">ĐIỀU CHUYỂN KHO · @Status(Model.Status)</p><h1>@ViewData["Title"]</h1><p class="outbound-document-reference mb-0">@Model.Code</p></div>
        <div class="outbound-toolbar" data-outbound-fragment="actions">
            <a asp-action="Index" class="workspace-button sales-button-secondary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Danh sách chuyển kho</a>
            @if (work is not null)
            {
                <button type="button" class="workspace-button sales-button-secondary" data-outbound-refresh><i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>Cập nhật</button>
                <form asp-action="@(Model.IsSource ? "CompleteDispatch" : "CompleteReceipt")" asp-route-id="@Model.Id" method="post"
                      data-outbound-submit-once data-outbound-confirm="@(Model.IsSource ? "Hoàn tất gửi các serial đã chọn? Hàng sẽ rời kho nguồn và chuyển sang đang vận chuyển." : "Hoàn tất nhận các serial đã ghi nhận? Hàng sẽ được nhập vào kho và chờ xếp vị trí.")">
                    @if (Model.IsSource) { <input type="hidden" name="dispatchId" value="@work.DispatchId" /> }
                    else { <input type="hidden" name="receiptId" value="@work.ReceiptId" /> }
                    <button type="submit" class="workspace-button" disabled="@(work.Serials.Count == 0)"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>@(Model.IsSource ? "Hoàn tất gửi hàng" : "Hoàn tất nhận hàng")</button>
                </form>
            }
            @if (Model.CanClaimDispatch || Model.CanClaimReceipt)
            {
                <form asp-action="@(Model.IsSource ? "ClaimDispatch" : "ClaimReceipt")" asp-route-id="@Model.Id" method="post" data-outbound-submit-once>
                    <button type="submit" class="workspace-button">@(Model.IsSource ? "Nhận việc gửi hàng" : "Nhận việc nhận hàng")</button>
                </form>
            }
        </div>
    </header>
    <div id="outbound-work-message" class="outbound-notice" role="status" aria-live="polite" hidden></div>
    <section class="workspace-card outbound-transfer-summary">
        <dl class="outbound-transfer-facts">
            <div><dt>Kho nguồn</dt><dd>@Model.FromWarehouse</dd></div>
            <div><dt>Kho đích</dt><dd>@Model.ToWarehouse</dd></div>
            <div><dt>Tình trạng theo lệnh</dt><dd>@Condition(Model.ItemCondition)</dd></div>
            <div><dt>Người thực hiện phiếu hiện tại</dt><dd>@(work?.StaffName ?? "Chưa nhận việc")</dd></div>
        </dl>
        @if (work is not null) { <p class="outbound-document-reference mb-0">@work.Code · @work.Date.ToString("dd/MM/yyyy")</p> }
    </section>
    <section class="workspace-card outbound-line-overview" data-outbound-fragment="progress">
        <div class="outbound-panel-heading"><h2 class="h5 mb-0">Tiến độ theo sản phẩm</h2><span class="muted small">@(work?.Serials.Count ?? 0) serial trên phiếu hiện tại</span></div>
        <div class="table-wrap"><table class="workspace-table"><thead><tr><th>Sản phẩm</th><th>Yêu cầu</th><th>Đã gửi</th><th>Kho đích đã nhận</th>
            @if (Model.IsSource) { <th>Còn phải gửi</th><th>Đã chọn phiếu này</th><th>Còn có thể chọn</th> }
            else { <th>Đang chuyển đến</th><th>Đã quét phiếu này</th> }
        </tr></thead><tbody>
        @foreach (var line in Model.Lines)
        {
            <tr><td><strong>@line.ProductName</strong><small class="d-block muted">@line.ProductCode</small></td><td>@(line.Requested - line.Cancelled)</td><td>@line.Dispatched</td><td>@line.Received</td>
                @if (Model.IsSource) { <td>@line.RemainingToDispatch</td><td>@(work?.Serials.Count(serial => serial.ProductCode == line.ProductCode) ?? 0)</td><td class="text-primary fw-semibold">@(work is null ? "—" : line.ReadyToPick.ToString())</td> }
                else { <td>@line.InTransit</td><td>@(work?.Serials.Count(serial => serial.ProductCode == line.ProductCode) ?? 0)</td> }
            </tr>
        }
        </tbody></table></div>
    </section>
    @if (work is not null)
    {
        <div class="outbound-picking-grid" id="my-transfer-work">
            <section class="workspace-card outbound-suggestions-panel" data-outbound-fragment="suggestions">
                @if (Model.IsSource)
                {
                    <form asp-action="ScanDispatchBatch" asp-route-id="@Model.Id" method="post" id="bulkPickForm" data-outbound-ajax data-outbound-batch>
                        <input type="hidden" name="dispatchId" value="@work.DispatchId" />
                        <header class="outbound-panel-heading">
                            <div><h2 class="h5 mb-1">Vị trí và serial có thể lấy</h2><p class="muted small mb-0">Tích các serial cần gửi, sau đó thêm vào phiếu.</p></div>
                            <div class="outbound-search-box"><label for="outbound-serial-search" class="visually-hidden">Tìm serial, sản phẩm, vị trí hoặc nguồn</label><input type="search" id="outbound-serial-search" class="form-control" maxlength="150" placeholder="Serial, sản phẩm, vị trí hoặc nguồn..." /></div>
                        </header>
                        @if (Model.Lines.Count > 1)
                        {
                            <div class="outbound-filters-bar outbound-product-filters"><button type="button" class="outbound-filter-pill active" data-product-filter="ALL" aria-pressed="true">Tất cả sản phẩm</button>
                            @foreach (var line in Model.Lines) { <button type="button" class="outbound-filter-pill" data-product-filter="@line.ProductId" aria-pressed="false">@line.ProductCode</button> }</div>
                        }
                        <div class="outbound-bulk-toolbar">
                            <label class="outbound-check-label" for="outbound-select-all"><input type="checkbox" id="outbound-select-all" />Tích tất cả trong hạn mức</label>
                            <span class="muted small" id="outbound-checked-count" aria-live="polite">Chưa tích serial</span>
                            <button type="submit" class="workspace-button sales-button-small" id="outbound-add-checked" disabled>Thêm vào phiếu <span data-checked-total>(0)</span></button>
                        </div>
                        <div class="table-wrap outbound-suggestion-scroll" data-outbound-scroll="suggestions"><table class="workspace-table" id="suggestedSerialsTable">
                            <thead><tr><th class="outbound-check-column">Tích</th><th>Serial / sản phẩm</th><th>Vị trí lấy hàng</th><th>Sản xuất</th><th>Nguồn hàng</th></tr></thead><tbody>
                            @foreach (var option in Model.DispatchSerialOptions)
                            {
                                <tr class="suggested-serial-row" data-product-id="@option.ProductId" data-suggestion-search="@option.SerialNumber @option.ProductCode @option.ProductName @option.Location @option.SourceCode">
                                    <td class="outbound-check-column"><input type="checkbox" name="serialNumbers" value="@option.SerialNumber" class="outbound-pick-check" data-selectable="true"
                                        data-product-id="@option.ProductId" data-source-id="@option.SupplySourceId" data-product-limit="@option.LineRemaining" data-source-limit="@option.SourceRemaining" aria-label="Chọn serial @option.SerialNumber" /></td>
                                    <td><strong class="font-monospace">@option.SerialNumber</strong><small class="d-block muted">@option.ProductName</small></td>
                                    <td><span class="outbound-location-chip"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@option.Location</span></td><td><span class="outbound-mfg-chip">@option.ManufacturingDateDisplay</span></td><td class="outbound-suggestion-source"><span class="small">@option.SourceCode</span></td>
                                </tr>
                            }
                            @if (Model.DispatchSerialOptions.Count == 0) { <tr><td colspan="5" class="text-center muted py-4">@(Model.IsDispatchQuantityCovered ? "Đã chọn đủ số lượng cần gửi cho lệnh." : "Chưa có serial hợp lệ còn trống tại nguồn hoặc vị trí được phép lấy.")</td></tr> }
                            </tbody>
                        </table></div>
                        <p id="outbound-suggestions-empty" class="muted text-center p-3 mb-0 d-none" role="status">Không có serial phù hợp bộ lọc.</p>
                    </form>
                }
                else
                {
                    <header class="outbound-panel-heading">
                        <div><h2 class="h5 mb-1">Serial đang chuyển đến</h2><p class="muted small mb-0">Chọn hoặc quét serial, kiểm tra tình trạng rồi ghi nhận.</p></div>
                        <div class="outbound-search-box"><label for="outbound-serial-search" class="visually-hidden">Tìm serial hoặc sản phẩm</label><input type="search" id="outbound-serial-search" class="form-control" maxlength="150" placeholder="Tìm serial hoặc sản phẩm..." /></div>
                    </header>
                    <div class="table-wrap outbound-suggestion-scroll" data-outbound-scroll="suggestions"><table class="workspace-table" id="suggestedSerialsTable">
                        <thead><tr><th>Serial / sản phẩm</th><th>Sản xuất</th><th>Tình trạng khi gửi</th><th>Nhận hàng</th></tr></thead><tbody>
                        @foreach (var option in Model.ReceiptSerialOptions)
                        {
                            var picked = selectedSerials.Contains(option.SerialNumber);
                            <tr class="suggested-serial-row @(picked ? "outbound-picked-row" : "")" data-product-id="@option.ProductId" data-suggestion-search="@option.SerialNumber @option.ProductCode @option.ProductName">
                                <td><strong class="font-monospace">@option.SerialNumber</strong><small class="d-block muted">@option.ProductName</small></td><td>@option.ManufacturingDateDisplay</td><td>@Condition(option.DispatchedCondition)</td>
                                <td>@if (picked) { <span class="outbound-badge outbound-badge-draft">Đã ghi nhận</span> } else { <button type="button" class="workspace-button sales-button-small" data-transfer-receive-pick="@option.SerialNumber">Chọn nhận</button> }</td>
                            </tr>
                        }
                        @if (Model.ReceiptSerialOptions.Count == 0) { <tr><td colspan="4" class="text-center muted py-4">Không có serial đang chuyển đến theo lệnh này.</td></tr> }
                        </tbody>
                    </table></div>
                    <p id="outbound-suggestions-empty" class="muted text-center p-3 mb-0 d-none" role="status">Không có serial phù hợp bộ lọc.</p>
                }
            </section>
            <aside class="outbound-picking-sidebar">
                <section class="workspace-card outbound-scan-panel">
                    <h2 class="h5 mb-3">@(Model.IsSource ? "Quét hoặc nhập serial gửi" : "Ghi nhận hàng thực nhận")</h2>
                    <p class="muted small" data-outbound-scan-limit hidden="@canAdd">@(Model.IsSource ? "Không còn serial đủ điều kiện chọn thêm trong đợt này." : "Đã ghi nhận các serial đang chuyển đến.")</p>
                    <form asp-action="@(Model.IsSource ? "ScanDispatch" : "ScanReceipt")" asp-route-id="@Model.Id" method="post" id="scanSerialForm" data-outbound-ajax>
                        @if (Model.IsSource) { <input type="hidden" name="dispatchId" value="@work.DispatchId" /> }
                        else { <input type="hidden" name="receiptId" value="@work.ReceiptId" /> }
                        <partial name="_SerialCapture" model="@(new SerialCaptureViewModel { SerialName = "serialNumber", HelpText = "Dùng máy quét, camera hoặc ảnh tem.", Hint = Model.IsSource ? "Nhập serial rồi nhấn Enter để thêm." : "Đối chiếu serial và tình trạng thực nhận." })" />
                        @if (!Model.IsSource)
                        {
                            <div class="mt-3"><label for="receivedCondition" class="form-label">Tình trạng thực nhận</label><select id="receivedCondition" name="receivedCondition" class="form-select" required><option value="">Chọn tình trạng</option><option value="GOOD">Tốt</option><option value="DAMAGED">Hỏng</option></select></div>
                            <div class="mt-3"><label for="conditionNote" class="form-label">Ghi chú tình trạng</label><textarea id="conditionNote" name="conditionNote" class="form-control" maxlength="1000" rows="2"></textarea></div>
                        }
                        <button type="submit" class="workspace-button w-100 mt-3" data-outbound-scan-submit disabled="@(!canAdd)">@(Model.IsSource ? "Thêm serial" : "Ghi nhận serial")</button>
                    </form>
                </section>
                <section class="workspace-card outbound-selected-panel" data-outbound-fragment="selected">
                    <div class="outbound-panel-heading"><h2 class="h5 mb-0">@(Model.IsSource ? "Đã chọn" : "Đã ghi nhận") <span class="outbound-badge outbound-badge-picking">@work.Serials.Count</span></h2></div>
                    <div class="table-wrap outbound-selected-scroll" data-outbound-scroll="selected"><table class="workspace-table outbound-selected-table">
                        <thead><tr><th>Serial / sản phẩm</th><th>@(Model.IsSource ? "Vị trí / tình trạng" : "Thực nhận / ghi chú")</th><th></th></tr></thead><tbody>
                        @foreach (var item in work.Serials)
                        {
                            <tr><td><strong class="font-monospace">@item.SerialNumber</strong><small class="d-block muted">@item.ProductName</small></td>
                                <td>@Condition(item.Condition)<small class="d-block muted">@(Model.IsSource ? Location(item.LocationId) : item.ConditionNote)</small></td>
                                <td><form asp-action="@(Model.IsSource ? "RemoveDispatchSerial" : "RemoveReceiptSerial")" asp-route-id="@Model.Id" method="post" data-outbound-ajax>
                                    <input type="hidden" name="documentId" value="@(work.DispatchId ?? work.ReceiptId)" /><input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Gỡ serial @item.SerialNumber"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form></td>
                            </tr>
                        }
                        @if (work.Serials.Count == 0) { <tr><td colspan="3" class="text-center muted py-4">@(Model.IsSource ? "Chưa chọn serial nào." : "Chưa ghi nhận serial nào.")</td></tr> }
                        </tbody>
                    </table></div>
                </section>
            </aside>
        </div>
    }
    else if (Model.Documents.Count == 0)
    {
        <section class="workspace-card"><p class="muted mb-0">@(Model.CanClaimDispatch || Model.CanClaimReceipt ? "Nhận việc để bắt đầu xử lý phiếu của kho." : "Chưa có phiếu sẵn sàng để xử lý tại kho của bạn.")</p></section>
    }
    @foreach (var document in Model.Documents.Where(document => document != work).OrderByDescending(document => document.Date))
    {
        <details class="workspace-card outbound-transfer-history">
            <summary><strong>@document.Code</strong><span class="muted"> · @Status(document.Status) · @document.Serials.Count serial · @(document.StaffName ?? "Chưa nhận việc")</span></summary>
            <div class="table-wrap mt-3"><table class="workspace-table">
                <thead><tr><th>Serial / sản phẩm</th><th>Tình trạng</th><th>@(Model.IsSource ? "Vị trí khi lấy" : "Ghi chú thực nhận")</th></tr></thead><tbody>
                @foreach (var item in document.Serials)
                { <tr><td><strong>@item.SerialNumber</strong><small class="d-block muted">@item.ProductName</small></td><td>@Condition(item.Condition)</td><td>@(Model.IsSource ? Location(item.LocationId) : item.ConditionNote ?? "—")</td></tr> }
                @if (document.Serials.Count == 0) { <tr><td colspan="3" class="muted text-center">Phiếu không có serial đang hiệu lực.</td></tr> }
                </tbody>
            </table></div>
        </details>
    }
</div>
@section Scripts {
    @if (work is not null) { <partial name="_SerialCaptureScripts" /> }
    <script src="~/js/outbound.js" asp-append-version="true"></script>
}
