@model PRN222_EWMS_Web.ViewModels.WarehouseTransfer.WarehouseTransferDetail
@using PRN222_EWMS_Web.ViewModels.Shared

@{
    ViewData["Title"] = $"Lệnh điều chuyển {Model.Code}";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <h1 class="mb-0 text-break">Lệnh @Model.Code</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Danh sách điều chuyển
    </a>
</div>

<section class="workspace-card mb-4" aria-label="Thông tin điều chuyển">
    <div class="row g-4">
        <div class="col-md-5">
            <p class="small text-muted mb-2">Kho nguồn</p>
            <p class="fw-semibold text-break mb-0">@Model.FromWarehouse</p>
        </div>
        <div class="col-md-2 d-flex align-items-center justify-content-md-center text-primary">
            <i class="bi bi-arrow-right fs-4 d-none d-md-block" aria-hidden="true"></i>
            <i class="bi bi-arrow-down fs-4 d-md-none" aria-hidden="true"></i>
        </div>
        <div class="col-md-5">
            <p class="small text-muted mb-2">Kho đích</p>
            <p class="fw-semibold text-break mb-0">@Model.ToWarehouse</p>
        </div>
    </div>
    <dl class="d-flex flex-wrap gap-4 border-top pt-3 mt-4 mb-0">
        <div>
            <dt class="small text-muted fw-normal mb-2">Trạng thái lệnh</dt>
            <dd class="mb-0"><span class="badge bg-light text-dark border rounded-pill px-3 py-2">@Model.Status</span></dd>
        </div>
        <div>
            <dt class="small text-muted fw-normal mb-2">Tình trạng hàng yêu cầu</dt>
            <dd class="mb-0">@(Model.ItemCondition switch { "GOOD" => "Tốt", "DAMAGED" => "Hư hỏng", _ => Model.ItemCondition })</dd>
        </div>
        <div>
            <dt class="small text-muted fw-normal mb-2">Việc của kho</dt>
            <dd class="mb-0">@(Model.IsSource ? "Xuất hàng" : "Nhận hàng")</dd>
        </div>
    </dl>
</section>

<section class="workspace-card mb-4" aria-labelledby="transfer-progress-heading">
<h2 id="transfer-progress-heading" class="h5 mb-4">Tiến độ theo sản phẩm</h2>
<div class="table-wrap" tabindex="0" role="region" aria-label="Tiến độ sản phẩm, có thể cuộn ngang">
<table class="workspace-table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Yêu cầu</th>
            <th>Đã hủy</th>
            <th>Đã xuất</th>
            <th>Kho đích đã nhận</th>
            <th>Đang vận chuyển</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.ProductCode – @line.ProductName</td>
                <td>@line.Requested</td>
                <td>@line.Cancelled</td>
                <td>@line.Dispatched</td>
                <td>@line.Received</td>
                <td>@line.InTransit</td>
            </tr>
        }
    </tbody>
</table>
</div>
@if (Model.Lines.Count == 0)
{
    <p class="text-muted mt-3 mb-0">Lệnh chưa có sản phẩm.</p>
}
</section>

@if (!Model.IsSource)
{
    <section class="workspace-card mb-4" aria-labelledby="incoming-serials-heading">
    <h2 id="incoming-serials-heading" class="h5 mb-3">Serial đang chuyển đến kho</h2>
    @if (Model.IncomingSerials.Count == 0)
    {
        <p class="text-muted mb-0">Không có serial đang chuyển đến.</p>
    }
    else
    {
        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
            @foreach (var serial in Model.IncomingSerials)
            {
                <li class="border rounded px-3 py-2 text-break bg-light">@serial</li>
            }
        </ul>
    }
    </section>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
<h2 class="h4 mb-0">@(Model.IsSource ? "Phiếu xuất của kho" : "Phiếu nhận của kho")</h2>
@if (Model.CanClaimDispatch)
{
    <form asp-action="ClaimDispatch" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary rounded-pill">Nhận việc xuất</button>
    </form>
}
@if (Model.CanClaimReceipt)
{
    <form asp-action="ClaimReceipt" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary rounded-pill">Nhận việc nhận hàng</button>
    </form>
}
</div>
@if (Model.Documents.Count == 0)
{
    <p class="workspace-card text-muted">Kho chưa có phiếu cho lệnh này.</p>
}

@foreach (var doc in Model.Documents)
{
    <section class="workspace-card mb-4" aria-label="Phiếu @doc.Code">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom pb-3 mb-4">
        <div>
            <h3 class="h5 mb-2 text-break" id="@(doc.CanScan || doc.CanScanReceipt ? "my-transfer-work" : null)">@doc.Code</h3>
            <p class="small text-muted mb-0">@doc.Date.ToString("dd/MM/yyyy") · @(doc.StaffName ?? "Chưa có người phụ trách")</p>
        </div>
        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@doc.Status</span>
    </div>
    @if (doc.CanScan)
    {
        <form asp-action="ScanDispatch" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="dispatchId" value="@doc.DispatchId" />
            @if (Model.DispatchSerialOptions.Count > 0)
            {
                <label class="form-label" for="serial-options-@doc.DispatchId">Chọn serial theo vị trí</label>
                <select class="form-select mb-3" id="serial-options-@doc.DispatchId" data-dispatch-options>
                    <option value="">Chọn serial trong kho</option>
                    @foreach (var group in Model.DispatchSerialOptions.GroupBy(s => new { s.ProductCode, s.ProductName, s.Location }))
                    {
                        <optgroup label="@($"{group.Key.ProductCode} · {group.Key.ProductName} · {group.Key.Location}")">
                            @foreach (var serial in group)
                            {
                                <option value="@serial.SerialNumber">@serial.SerialNumber</option>
                            }
                        </optgroup>
                    }
                </select>
            }
            else
            {
                <p class="text-muted">Không còn serial đủ điều kiện để gợi ý cho phiếu này.</p>
            }
            <partial name="_SerialCapture" model="@(new SerialCaptureViewModel
            {
                SerialName = "serialNumber",
                HelpText = "Quét hoặc tải ảnh tem của máy cần xuất. Đối chiếu mã trước khi thêm vào phiếu.",
                Hint = "Bạn cũng có thể nhập tay hoặc dùng máy quét USB/Bluetooth."
            })" />
            <button type="submit" class="btn btn-primary rounded-pill mt-3">Thêm serial</button>
        </form>
    }
    @if (doc.CanScanReceipt)
    {
        <form asp-action="ScanReceipt" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="receiptId" value="@doc.ReceiptId" />
            <partial name="_SerialCapture" model="@(new SerialCaptureViewModel
            {
                SerialName = "serialNumber",
                HelpText = "Quét hoặc tải ảnh tem của máy vừa nhận. Đối chiếu mã rồi chọn tình trạng thực tế.",
                Hint = "Bạn cũng có thể nhập tay hoặc dùng máy quét USB/Bluetooth."
            })" />
            <label class="form-label mt-3" for="condition-@doc.ReceiptId">Tình trạng thực nhận</label>
            <select id="condition-@doc.ReceiptId" name="receivedCondition" class="form-select" required>
                <option value="">Chọn tình trạng</option>
                <option value="GOOD">Tốt</option>
                <option value="DAMAGED">Hư hỏng</option>
            </select>
            <label class="form-label mt-3" for="note-@doc.ReceiptId">Ghi chú tình trạng</label>
            <input id="note-@doc.ReceiptId" name="conditionNote" class="form-control" maxlength="1000" />
            <button type="submit" class="btn btn-primary rounded-pill mt-3">Thêm serial nhận</button>
        </form>
    }
    @if (doc.Serials.Count == 0)
    {
        <p class="text-muted mt-3 mb-0">Phiếu chưa có serial.</p>
    }
    else
    {
        <div class="table-wrap mt-4" tabindex="0" role="region" aria-label="Serial trong phiếu @doc.Code, có thể cuộn ngang">
        <table class="workspace-table">
            <thead>
                <tr>
                    <th>Mã sản phẩm</th>
                    <th>Serial</th>
                    <th>@(Model.IsSource ? "Tình trạng lúc xuất" : "Tình trạng thực nhận")</th>
                    @if (!Model.IsSource)
                    {
                        <th>Ghi chú tình trạng</th>
                    }
                    @if (doc.CanScan || doc.CanScanReceipt)
                    {
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in doc.Serials)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>@item.SerialNumber</td>
                        <td>@(item.Condition ?? "Chưa ghi nhận")</td>
                        @if (!Model.IsSource)
                        {
                            <td>@item.ConditionNote</td>
                        }
                        @if (doc.CanScan || doc.CanScanReceipt)
                        {
                            <td>
                                <form asp-action="@(doc.CanScan ? "RemoveDispatchSerial" : "RemoveReceiptSerial")"
                                      asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="documentId" value="@(doc.DispatchId ?? doc.ReceiptId)" />
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill text-nowrap"
                                            aria-label="Gỡ serial @item.SerialNumber">Gỡ serial</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @if (doc.CanScan)
        {
            <form asp-action="CompleteDispatch" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="dispatchId" value="@doc.DispatchId" />
                <button type="submit" class="btn btn-primary rounded-pill mt-4">Hoàn tất xuất</button>
            </form>
        }
        @if (doc.CanScanReceipt)
        {
            <form asp-action="CompleteReceipt" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="receiptId" value="@doc.ReceiptId" />
                <button type="submit" class="btn btn-primary rounded-pill mt-4">Hoàn tất nhận</button>
            </form>
        }
    }
    </section>
}

@section Scripts {
    @if (Model.Documents.Any(doc => doc.CanScan || doc.CanScanReceipt))
    {
        <partial name="_SerialCaptureScripts" />
        <script>
            document.querySelectorAll('[data-dispatch-options]').forEach(select => {
                select.addEventListener('change', () => {
                    if (!select.value) return;
                    const input = select.form.querySelector('[data-serial-input]');
                    input.value = select.value;
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    input.focus();
                    select.selectedIndex = 0;
                });
            });
        </script>
    }
}
