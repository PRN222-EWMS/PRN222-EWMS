@model PRN222_EWMS_Web.ViewModels.WarehouseTransfer.WarehouseTransferDetail
@using PRN222_EWMS_Web.ViewModels.Shared

@{
    ViewData["Title"] = $"Lệnh điều chuyển {Model.Code}";
}

<a asp-action="Index">← Danh sách điều chuyển</a>
<h1>Lệnh @Model.Code</h1>
<p>Kho nguồn: @Model.FromWarehouse → Kho đích: @Model.ToWarehouse</p>
<p>Trạng thái: @Model.Status · Tình trạng hàng yêu cầu: @Model.ItemCondition</p>

<h2>Tiến độ theo sản phẩm</h2>
<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Yêu cầu</th>
            <th>Đã hủy</th>
            <th>Đã xuất</th>
            <th>Kho đích đã nhận</th>
            <th>Đang vận chuyển</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.ProductCode – @line.ProductName</td>
                <td>@line.Requested</td>
                <td>@line.Cancelled</td>
                <td>@line.Dispatched</td>
                <td>@line.Received</td>
                <td>@line.InTransit</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.IsSource)
{
    <h2>Serial đang chuyển đến kho</h2>
    @if (Model.IncomingSerials.Count == 0)
    {
        <p>Không có serial đang chuyển đến.</p>
    }
    else
    {
        <ul>
            @foreach (var serial in Model.IncomingSerials)
            {
                <li>@serial</li>
            }
        </ul>
    }
}

<h2>@(Model.IsSource ? "Phiếu xuất của kho" : "Phiếu nhận của kho")</h2>
@if (Model.CanClaimDispatch)
{
    <form asp-action="ClaimDispatch" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary">Nhận việc xuất</button>
    </form>
}
@if (Model.CanClaimReceipt)
{
    <form asp-action="ClaimReceipt" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary">Nhận việc nhận hàng</button>
    </form>
}
@if (Model.Documents.Count == 0)
{
    <p>Kho chưa có phiếu cho lệnh này.</p>
}

@foreach (var doc in Model.Documents)
{
    <h3 id="@(doc.CanScan || doc.CanScanReceipt ? "my-transfer-work" : null)">@doc.Code</h3>
    @if (doc.CanScan)
    {
        <form asp-action="ScanDispatch" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="dispatchId" value="@doc.DispatchId" />
            <partial name="_SerialCapture" model="@(new SerialCaptureViewModel
            {
                SerialName = "serialNumber",
                HelpText = "Quét hoặc tải ảnh tem của máy cần xuất. Đối chiếu mã trước khi thêm vào phiếu.",
                Hint = "Bạn cũng có thể nhập tay hoặc dùng máy quét USB/Bluetooth."
            })" />
            <button type="submit" class="btn btn-primary mt-2">Thêm serial</button>
        </form>
    }
    @if (doc.CanScanReceipt)
    {
        <form asp-action="ScanReceipt" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="receiptId" value="@doc.ReceiptId" />
            <partial name="_SerialCapture" model="@(new SerialCaptureViewModel
            {
                SerialName = "serialNumber",
                HelpText = "Quét hoặc tải ảnh tem của máy vừa nhận. Đối chiếu mã rồi chọn tình trạng thực tế.",
                Hint = "Bạn cũng có thể nhập tay hoặc dùng máy quét USB/Bluetooth."
            })" />
            <label for="condition-@doc.ReceiptId">Tình trạng thực nhận</label>
            <select id="condition-@doc.ReceiptId" name="receivedCondition" class="form-select" required>
                <option value="">Chọn tình trạng</option>
                <option value="GOOD">Tốt</option>
                <option value="DAMAGED">Hư hỏng</option>
            </select>
            <label for="note-@doc.ReceiptId">Ghi chú tình trạng</label>
            <input id="note-@doc.ReceiptId" name="conditionNote" class="form-control" maxlength="1000" />
            <button type="submit" class="btn btn-primary mt-2">Thêm serial nhận</button>
        </form>
    }
    <p>@doc.Date.ToString("dd/MM/yyyy") · @doc.Status · @(doc.StaffName ?? "Chưa có người phụ trách")</p>
    @if (doc.Serials.Count == 0)
    {
        <p>Phiếu chưa có serial.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Mã sản phẩm</th>
                    <th>Serial</th>
                    <th>@(Model.IsSource ? "Tình trạng lúc xuất" : "Tình trạng thực nhận")</th>
                    @if (!Model.IsSource)
                    {
                        <th>Ghi chú tình trạng</th>
                    }
                    @if (doc.CanScan || doc.CanScanReceipt)
                    {
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in doc.Serials)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>@item.SerialNumber</td>
                        <td>@(item.Condition ?? "Chưa ghi nhận")</td>
                        @if (!Model.IsSource)
                        {
                            <td>@item.ConditionNote</td>
                        }
                        @if (doc.CanScan || doc.CanScanReceipt)
                        {
                            <td>
                                <form asp-action="@(doc.CanScan ? "RemoveDispatchSerial" : "RemoveReceiptSerial")"
                                      asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="documentId" value="@(doc.DispatchId ?? doc.ReceiptId)" />
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            aria-label="Gỡ serial @item.SerialNumber">Gỡ serial</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (doc.CanScan)
        {
            <form asp-action="CompleteDispatch" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="dispatchId" value="@doc.DispatchId" />
                <button type="submit" class="btn btn-primary">Hoàn tất xuất</button>
            </form>
        }
        @if (doc.CanScanReceipt)
        {
            <form asp-action="CompleteReceipt" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="receiptId" value="@doc.ReceiptId" />
                <button type="submit" class="btn btn-primary">Hoàn tất nhận</button>
            </form>
        }
    }
}

@section Scripts {
    @if (Model.Documents.Any(doc => doc.CanScan || doc.CanScanReceipt))
    {
        <partial name="_SerialCaptureScripts" />
    }
}
