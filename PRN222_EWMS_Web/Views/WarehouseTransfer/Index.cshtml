@model List<PRN222_EWMS_Web.ViewModels.WarehouseTransfer.TransferListRow>

@{
    ViewData["Title"] = "Lệnh điều chuyển";
    string search = ViewBag.Search ?? "";
    string work = ViewBag.Work ?? "all";
    string direction = ViewBag.Direction ?? "all";
    bool hasFilters = search.Length > 0 || work != "all" || direction != "all";
    var workOptions = new[]
    {
        (Value: "all", Label: "Tất cả"),
        (Value: "available", Label: "Chờ nhận việc"),
        (Value: "mine", Label: "Việc của tôi")
    };
}

<h1>Lệnh điều chuyển</h1>

<form asp-action="Index" method="get" aria-label="Bộ lọc lệnh điều chuyển" class="workspace-card mb-4">
    <div class="p-0">
      <div class="row g-3">
        <div class="col-12 col-md-4">
            <label for="transfer-search" class="form-label">Mã chuyển kho</label>
            <input id="transfer-search" name="search" value="@search" type="search"
                   class="form-control" placeholder="Nhập mã hoặc một phần mã" />
        </div>
        <div class="col-12 col-md-4">
            <label for="transfer-direction" class="form-label">Việc của kho</label>
            <select id="transfer-direction" name="direction" class="form-select">
                <option value="all" selected="@(direction == "all")">Tất cả</option>
                <option value="dispatch" selected="@(direction == "dispatch")">Xuất hàng</option>
                <option value="receive" selected="@(direction == "receive")">Nhận hàng</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label for="transfer-work" class="form-label">Công việc</label>
            <select id="transfer-work" name="work" class="form-select">
                @foreach (var option in workOptions)
                {
                    <option value="@option.Value" selected="@(work == option.Value)">@option.Label</option>
                }
            </select>
        </div>
      </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Xóa bộ lọc</a>
        </div>
    </div>
</form>

<section aria-label="Danh sách lệnh điều chuyển" class="workspace-card">
<div class="p-0">
<div class="table-wrap">
@if (Model.Count == 0)
{
    <p class="mb-0">@(hasFilters ? "Không tìm thấy lệnh chuyển kho phù hợp với bộ lọc." : "Kho của bạn chưa có lệnh điều chuyển.")</p>
}
else
{
    <table class="workspace-table">
        <thead>
            <tr>
                <th>Mã lệnh</th>
                <th>Kho nguồn</th>
                <th>Kho đích</th>
                <th>Việc của kho</th>
                <th>Trạng thái lệnh</th>
                <th>Đã xuất</th>
                <th>Đã nhận</th>
                <th>Đang vận chuyển</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@row.Id">@row.Code</a>
                    </td>
                    <td>@row.FromWarehouse</td>
                    <td>@row.ToWarehouse</td>
                    <td>@(row.IsSource ? "Xuất hàng" : "Nhận hàng")</td>
                    <td>@row.Status</td>
                    <td>@row.Dispatched</td>
                    <td>@row.Received</td>
                    <td>@row.InTransit</td>
                    <td>
                        @if (row.CanContinue)
                        {
                            <a class="workspace-button workspace-button-small" asp-action="Details" asp-route-id="@row.Id"
                               asp-fragment="my-transfer-work"><i class="bi bi-arrow-right" aria-hidden="true"></i> @(row.IsSource ? "Tiếp tục xuất" : "Tiếp tục nhận")</a>
                        }
                        else if (row.CanClaim)
                        {
                            <form asp-action="@(row.IsSource ? "ClaimDispatch" : "ClaimReceipt")"
                                  asp-route-id="@row.Id" method="post">
                                <button type="submit" class="workspace-button workspace-button-small">
                                    <i class="bi bi-clipboard-check" aria-hidden="true"></i> @(row.IsSource ? "Nhận việc xuất" : "Nhận việc nhận hàng")
                                </button>
                            </form>
                        }
                        else if (row.IsReleased && row.OpenCount == 1 && row.OwnerName != null)
                        {
                            <span>@row.OwnerName @(row.IsSource ? "đang xuất" : "đang nhận")</span>
                        }
                        else if (!row.IsSource && row.IsReleased && row.Dispatched == 0 && row.HasRemainingToDispatch)
                        {
                            <span>Chờ kho nguồn xuất</span>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@row.Id" class="workspace-button workspace-button-small"><i class="bi bi-eye" aria-hidden="true"></i> Chi tiết</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</div>
</div>
</section>
