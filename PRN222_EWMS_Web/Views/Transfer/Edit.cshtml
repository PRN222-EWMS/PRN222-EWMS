@model PRN222_EWMS_Web.ViewModels.Transfer.EditTransferOrderViewModel
@{ ViewData["Title"] = "Lệnh chuyển " + Model.TransferCode; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.TransferCode <span class="badge bg-secondary fs-6">@Model.Status</span></h1>
    <a asp-controller="ManagerTransfer" asp-action="Details" asp-route-id="@Model.TransferOrderId" class="btn btn-outline-secondary">Chi tiết lệnh</a>
</div>
@if (!Model.CanEdit) { <div class="alert alert-warning" role="alert">@Model.LockReason</div> }
@if (TempData["TransferWarnings"] is string warning && !string.IsNullOrWhiteSpace(warning))
{ <div class="alert alert-warning" role="status" style="white-space:pre-line">@warning</div> }
<form asp-action="Edit" asp-route-id="@Model.TransferOrderId" method="post" id="transfer-form" data-preview-url="@Url.Action("Preview")" data-products-url="@Url.Action("GetAvailableProducts")" data-order-id="@Model.TransferOrderId" data-released="@(Model.Status == "RELEASED" ? "true" : "false")">
    <input asp-for="TransferOrderId" type="hidden" />
    <input asp-for="RowVersionBase64" type="hidden" />
    <fieldset disabled="@(!Model.CanEdit)">
        <partial name="_Form" model="Model" />
        @if (Model.CanEdit)
        {
            <div class="d-flex gap-2 my-3">
                @if (Model.Status == "DRAFT") { <button type="submit" name="IsRelease" value="false" class="btn btn-outline-primary">Lưu nháp</button> }
                <button type="submit" name="IsRelease" value="true" class="btn btn-primary">@(Model.Status == "DRAFT" ? "Phát hành và giữ chỗ" : "Lưu thay đổi và giữ chỗ lại")</button>
            </div>
        }
    </fieldset>
</form>
@if (Model.CanCancel)
{
    <form asp-action="Cancel" asp-route-id="@Model.TransferOrderId" method="post" class="mt-3" onsubmit="return confirm('Hủy lệnh và giải phóng toàn bộ giữ chỗ?')">
        <button type="submit" class="btn btn-outline-danger">Hủy lệnh</button>
    </form>
}
@section Scripts { @if (Model.CanEdit) { <script src="~/js/transfer-form.js" asp-append-version="true"></script> } }
