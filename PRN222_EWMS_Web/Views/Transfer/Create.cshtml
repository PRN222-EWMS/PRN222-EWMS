@model PRN222_EWMS_Web.ViewModels.Transfer.CreateTransferOrderViewModel
@{ ViewData["Title"] = "Tạo lệnh chuyển kho"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tạo lệnh chuyển kho</h1>
    <a asp-controller="ManagerTransfer" asp-action="Index" class="btn btn-outline-secondary">Danh sách</a>
</div>
<form asp-action="Create" method="post" id="transfer-form" data-preview-url="@Url.Action("Preview")" data-products-url="@Url.Action("GetAvailableProducts")">
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2 my-3">
        <button type="submit" name="IsRelease" value="false" class="btn btn-outline-primary">Lưu nháp</button>
        <button type="submit" name="IsRelease" value="true" class="btn btn-primary">Phát hành và giữ chỗ</button>
    </div>
</form>
@section Scripts { <script src="~/js/transfer-form.js" asp-append-version="true"></script> }
