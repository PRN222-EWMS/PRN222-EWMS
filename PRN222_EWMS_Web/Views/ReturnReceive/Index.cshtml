@model PRN222_EWMS_Web.ViewModels.Returns.ReturnReceivePage
@{ViewData["Title"]="Nhận hàng trả";}
<div class="return-page"><header><p>WAREHOUSE RETURNS</p><h1>Nhận hàng trả</h1><span>Đối chiếu Serial với hàng đã xuất trước khi nhận lại vào kho.</span></header><form method="get" class="return-filter"><input name="search" value="@Model.Search" placeholder="Tìm mã đơn trả hoặc đơn bán" maxlength="100" /><button>Lọc</button></form><h2>Đơn trả cần nhận</h2><div class="return-list">@foreach(var order in Model.Orders){<article><div><strong>@order.Code</strong><p>@order.SalesCode · @order.Customer</p><small>@order.Status · Đề nghị @order.Requested · Đã nhận @order.Received</small></div>@if(order.Status is not("CLOSED" or "CANCELLED")&&order.Received<order.Requested){<form asp-action="Start" method="post"><input type="hidden" name="returnOrderId" value="@order.Id" /><label>Phiếu xuất<select name="outboundId" required>@foreach(var outbound in order.Outbounds){<option value="@outbound.Id">@outbound.Code</option>}</select></label><button disabled="@(order.Outbounds.Count==0)">Nhận hàng</button></form>}</article>}</div>@if(Model.Orders.Count==0){<p>Chưa có đơn trả hàng phù hợp.</p>}<nav class="return-pages">@if(Model.Page>1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)">Trước</a>}<span>Trang @Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)">Sau</a>}</nav><h2>Phiếu nhận trả gần đây</h2><div class="return-list">@foreach(var receipt in Model.Receipts){<article><div><strong>@receipt.Code</strong><p>@receipt.ReturnCode · @receipt.Status · @receipt.Scanned Serial</p></div><a asp-action="Details" asp-route-id="@receipt.Id">@(receipt.Status=="DRAFT"?"Tiếp tục":"Chi tiết") →</a></article>}</div></div>
