@model PRN222_EWMS_Web.ViewModels.Manager.ManagerInboundDetailViewModel
@{ ViewData["Title"] = "Chi tiết phiếu nhập"; }

<div class="manager-inbound-page"><a asp-action="Index" class="manager-inbound-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Phiếu nhập kho</a><header class="manager-inbound-header"><div><p class="manager-inbound-kicker">CHI TIẾT PHIẾU NHẬP</p><h1>@Model.ReceiptCode</h1><p>@Model.PoCode · @Model.Supplier</p></div><span class="manager-inbound-status manager-inbound-status-@Model.Status.ToLowerInvariant()">@(Model.Status switch { "DRAFT" => "Đang tiếp nhận", "DONE" => "Đã hoàn tất", "CANCELLED" => "Đã hủy", _ => Model.Status })</span></header>
    <section class="manager-inbound-info"><h2>Thông tin phiếu</h2><dl><div><dt>Đơn mua hàng</dt><dd>@Model.PoCode</dd></div><div><dt>Kho nhận</dt><dd>@Model.Warehouse</dd></div><div><dt>Ngày nhận</dt><dd>@Model.ReceiptDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Người tạo</dt><dd>@Model.CreatedBy</dd></div><div><dt>Thời gian tạo</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</dd></div><div><dt>Hoàn tất</dt><dd>@(Model.CompletedAt?.ToLocalTime().ToString("HH:mm dd/MM/yyyy") ?? "Chưa hoàn tất")</dd></div>@if (!string.IsNullOrWhiteSpace(Model.Note)) { <div><dt>Ghi chú</dt><dd>@Model.Note</dd></div> }@if (!string.IsNullOrWhiteSpace(Model.CancelReason)) { <div><dt>Lý do hủy</dt><dd>@Model.CancelReason</dd></div> }</dl></section>
    <div class="manager-inbound-section-title"><h2>Tiến độ tiếp nhận</h2><span>Đã nhận chính thức chỉ tính phiếu hoàn tất</span></div><div class="manager-inbound-stats"><div><span>PO đã đặt</span><strong>@Model.PoOrdered</strong></div><div><span>PO đã nhận</span><strong>@Model.PoReceived</strong></div><div><span>PO còn chờ</span><strong>@Model.PoOutstanding</strong></div><div><span>PO đã đóng</span><strong>@Model.PoClosed</strong></div><div><span>Trong phiếu: đã quét</span><strong>@Model.Scanned</strong></div><div><span>Trong phiếu: nhận chính thức</span><strong>@Model.Accepted</strong></div></div>
    <div class="manager-inbound-section-title"><h2>Theo sản phẩm</h2><span>@Model.Lines.Count dòng PO</span></div><div class="manager-inbound-table-wrap" role="region" aria-label="Tiến độ theo sản phẩm" tabindex="0"><table class="manager-inbound-table"><thead><tr><th>Sản phẩm</th><th>PO đặt</th><th>PO nhận</th><th>PO còn chờ</th><th>Đã đóng</th><th>Phiếu này đã quét</th><th>Phiếu này đã nhận</th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td><strong>@line.ProductCode</strong><small>@line.ProductName</small></td><td>@line.Ordered</td><td>@line.Received</td><td>@line.Outstanding</td><td>@line.Closed</td><td>@line.InThisReceiptScanned</td><td>@line.InThisReceiptAccepted</td></tr> }</tbody></table></div>
    <div class="manager-inbound-section-title manager-inbound-serial-heading"><h2>Serial đã quét</h2><span>@Model.Serials.Count Serial đang hiệu lực</span></div><div class="manager-inbound-table-wrap" role="region" aria-label="Serial trên phiếu nhập" tabindex="0"><table class="manager-inbound-table"><thead><tr><th>Serial</th><th>Sản phẩm</th><th>Tháng / năm sản xuất</th><th>Tình trạng</th><th>Nguồn quét</th><th>Ghi nhận</th></tr></thead><tbody>@foreach (var serial in Model.Serials) { <tr><td><strong>@serial.Serial</strong></td><td>@serial.ProductCode<small>@serial.ProductName</small></td><td>@serial.ManufacturingMonth/@serial.ManufacturingYear</td><td>@(serial.Condition ?? "—")@if (!string.IsNullOrWhiteSpace(serial.ConditionNote)) { <small>@serial.ConditionNote</small> }</td><td>@(serial.CaptureMethod ?? "—")</td><td>@(serial.Accepted ? "Đã nhận" : "Nháp")<small>@serial.ScannedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</small></td></tr> }@if (Model.Serials.Count == 0) { <tr><td colspan="6" class="manager-inbound-empty">Chưa có Serial đang hiệu lực trên phiếu này.</td></tr> }</tbody></table></div>
</div>
