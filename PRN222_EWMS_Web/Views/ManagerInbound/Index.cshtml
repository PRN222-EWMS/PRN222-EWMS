@model PRN222_EWMS_Web.ViewModels.Manager.ManagerInboundListViewModel
@{ ViewData["Title"] = "Theo dõi phiếu nhập"; var filter = Model.Filter; var firstPage = Math.Max(1, Math.Min(filter.Page - 2, Model.TotalPages - 4)); var lastPage = Math.Min(Model.TotalPages, firstPage + 4); }

<div class="manager-inbound-page">
    <header class="manager-inbound-header"><div><p class="manager-inbound-kicker">RECEIVING OVERVIEW</p><h1>Phiếu nhập kho</h1><p>Theo dõi phiếu nhập và tiến độ tiếp nhận thực tế của đơn mua hàng.</p></div><span class="manager-inbound-readonly"><i class="bi bi-eye" aria-hidden="true"></i> Chỉ xem</span></header>
    <form asp-action="Index" method="get" class="manager-inbound-filter" aria-label="Lọc phiếu nhập"><label>Mã phiếu / PO<input name="search" value="@filter.Search" maxlength="100" placeholder="Tìm mã phiếu hoặc PO..." /></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="DRAFT" selected="@(filter.Status == "DRAFT")">Đang tiếp nhận</option><option value="DONE" selected="@(filter.Status == "DONE")">Đã hoàn tất</option><option value="CANCELLED" selected="@(filter.Status == "CANCELLED")">Đã hủy</option></select></label><label>Kho<select name="warehouseId"><option value="">Tất cả kho</option>@foreach (var warehouse in Model.Warehouses) { <option value="@warehouse.Id" selected="@(filter.WarehouseId == warehouse.Id)">@warehouse.Name</option> }</select></label><label>Từ ngày<input type="date" name="fromDate" value="@filter.FromDate?.ToString("yyyy-MM-dd")" /></label><label>Đến ngày<input type="date" name="toDate" value="@filter.ToDate?.ToString("yyyy-MM-dd")" /></label><button type="submit" class="manager-inbound-button">Lọc</button><a asp-action="Index" class="manager-inbound-reset">Đặt lại</a></form>

    <div class="manager-inbound-section-title"><h2>Danh sách phiếu nhập</h2><span>@Model.TotalCount phiếu</span></div>
    <div class="manager-inbound-list">
        @foreach (var receipt in Model.Receipts)
        {
            <article class="manager-inbound-card"><div class="manager-inbound-card-main"><a asp-action="Details" asp-route-id="@receipt.Id">@receipt.ReceiptCode</a><p>@receipt.PoCode · @receipt.Supplier</p><small>@receipt.Warehouse · Ngày nhận @receipt.ReceiptDate.ToString("dd/MM/yyyy")</small></div><div class="manager-inbound-card-state"><span class="manager-inbound-status manager-inbound-status-@receipt.Status.ToLowerInvariant()">@(receipt.Status switch { "DRAFT" => "Đang tiếp nhận", "DONE" => "Đã hoàn tất", "CANCELLED" => "Đã hủy", _ => receipt.Status })</span><small>@receipt.Scanned Serial đã quét · @receipt.Accepted đã nhận chính thức</small></div><div class="manager-inbound-card-progress"><div><span>PO đã đặt</span><strong>@receipt.PoOrdered</strong></div><div><span>Đã nhận</span><strong>@receipt.PoReceived</strong></div><div><span>Còn chờ</span><strong>@receipt.PoOutstanding</strong></div><div><span>Đã đóng</span><strong>@receipt.PoClosed</strong></div></div><a asp-action="Details" asp-route-id="@receipt.Id" class="manager-inbound-detail-link">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a></article>
        }
        @if (Model.Receipts.Count == 0) { <div class="manager-inbound-empty">Không có phiếu nhập phù hợp với bộ lọc.</div> }
    </div>
    <nav class="manager-inbound-pagination" aria-label="Phân trang phiếu nhập"><span>Trang @filter.Page / @Model.TotalPages</span><div>@if (filter.Page > 1) { <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-warehouseId="@filter.WarehouseId" asp-route-fromDate="@filter.FromDate" asp-route-toDate="@filter.ToDate" asp-route-page="@(filter.Page - 1)">Trước</a> }@for (var number = firstPage; number <= lastPage; number++) { if (number == filter.Page) { <span aria-current="page">@number</span> } else { <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-warehouseId="@filter.WarehouseId" asp-route-fromDate="@filter.FromDate" asp-route-toDate="@filter.ToDate" asp-route-page="@number">@number</a> } }@if (filter.Page < Model.TotalPages) { <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-warehouseId="@filter.WarehouseId" asp-route-fromDate="@filter.FromDate" asp-route-toDate="@filter.ToDate" asp-route-page="@(filter.Page + 1)">Sau</a> }</div></nav>
</div>
