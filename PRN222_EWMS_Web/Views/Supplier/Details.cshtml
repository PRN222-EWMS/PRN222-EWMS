@model PRN222_EWMS_Web.ViewModels.Supplier.SupplierDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết nhà cung cấp";
}

<div class="workspace-heading">
    <div>
        <p class="eyebrow">MUA HÀNG / NHÀ CUNG CẤP</p>
        <h1>Chi tiết nhà cung cấp</h1>
        <p class="muted">Thông tin định danh và liên hệ của đối tác cung ứng.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsActive)
        {
            <a class="workspace-button" asp-controller="Supplier" asp-action="Edit"
               asp-route-id="@Model.SupplierId"
               asp-route-search="@Model.ReturnFilter.Search"
               asp-route-status="@Model.ReturnFilter.Status"
               asp-route-page="@Model.ReturnFilter.Page">
                <i class="bi bi-pencil" aria-hidden="true"></i> Chỉnh sửa
            </a>
        }
        else
        {
            <button type="button" class="btn btn-secondary disabled" disabled
                    title="Nhà cung cấp đang ngừng hoạt động, không thể chỉnh sửa.">
                <i class="bi bi-pencil" aria-hidden="true"></i> Chỉnh sửa
            </button>
        }
        <a class="workspace-link" asp-controller="Supplier" asp-action="Index"
           asp-route-search="@Model.ReturnFilter.Search"
           asp-route-status="@Model.ReturnFilter.Status"
           asp-route-page="@Model.ReturnFilter.Page">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại
        </a>
    </div>
</div>

@if (!Model.IsActive)
{
    <div class="alert alert-warning d-flex align-items-center mb-4" role="status">
        <i class="bi bi-info-circle-fill me-2 fs-5" aria-hidden="true"></i>
        <div>
            Nhà cung cấp này đang ở trạng thái <strong>Ngừng hoạt động</strong>. Để chỉnh sửa thông tin, vui lòng kích hoạt lại đối tác từ danh sách nhà cung cấp.
        </div>
    </div>
}

<section class="workspace-card" aria-label="Thông tin nhà cung cấp">
    <div class="workspace-form mt-0">
        <div class="form-grid">
            <div>
                <label>Mã nhà cung cấp (ID)</label>
                <input type="text" value="#@Model.SupplierId" disabled class="form-control bg-light" />
            </div>

            <div>
                <label>Trạng thái</label>
                <select disabled class="form-select bg-light">
                    <option selected>@Model.StatusLabel</option>
                </select>
            </div>

            <div class="col-span-2">
                <label>Tên nhà cung cấp</label>
                <input type="text" value="@Model.SupplierName" disabled class="form-control bg-light fw-semibold" />
            </div>

            <div>
                <label>Tên gợi nhớ (Nickname)</label>
                <input type="text" value="@(string.IsNullOrWhiteSpace(Model.Nickname) ? "—" : Model.Nickname)" disabled class="form-control bg-light" />
            </div>

            <div>
                <label>Số điện thoại</label>
                <input type="text" value="@Model.PhoneDisplay" disabled class="form-control bg-light" />
            </div>

            <div class="col-span-2">
                <label>Email</label>
                <input type="text" value="@Model.EmailDisplay" disabled class="form-control bg-light" />
            </div>

            <div class="col-span-2">
                <label>Địa chỉ</label>
                <textarea rows="3" disabled class="form-control bg-light">@Model.AddressDisplay</textarea>
            </div>
        </div>
    </div>
</section>
