@model PRN222_EWMS_Web.ViewModels.Supplier.EditSupplierViewModel
@{
    ViewData["Title"] = "Chỉnh sửa nhà cung cấp";
}

<div class="workspace-heading">
    <div>
        <p class="eyebrow">MUA HÀNG / NHÀ CUNG CẤP</p>
        <h1>Chỉnh sửa nhà cung cấp</h1>
        <p class="muted">Cập nhật thông tin định danh, liên hệ và trạng thái hoạt động của đối tác.</p>
    </div>
    <a class="workspace-link" asp-controller="Supplier" asp-action="Details"
       asp-route-id="@Model.SupplierId"
       asp-route-search="@Model.ReturnFilter.Search"
       asp-route-status="@Model.ReturnFilter.Status"
       asp-route-page="@Model.ReturnFilter.Page">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại
    </a>
</div>


<section class="workspace-card" aria-label="Form chỉnh sửa nhà cung cấp">
    <form id="editSupplierForm" asp-controller="Supplier" asp-action="Edit" asp-route-id="@Model.SupplierId" method="post" class="workspace-form mt-0">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SupplierId" />
        <input type="hidden" asp-for="ReturnFilter.Search" />
        <input type="hidden" asp-for="ReturnFilter.Status" />
        <input type="hidden" asp-for="ReturnFilter.Page" />

        <div asp-validation-summary="ModelOnly" class="validation-message mb-3" role="alert"></div>

        @if (Model.HasDuplicatePhoneWarning)
        {
            <input type="hidden" asp-for="HasDuplicatePhoneWarning" />
            <div class="alert alert-warning mb-4" role="alert">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2" aria-hidden="true"></i>
                    <strong>Cảnh báo trùng số điện thoại:</strong>
                </div>
                <p class="mb-2">Số điện thoại <strong>@Model.Phone</strong> đã tồn tại trong hệ thống với một nhà cung cấp khác.</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="ConfirmDuplicatePhone" id="ConfirmDuplicatePhone" />
                    <label class="form-check-label text-dark fw-medium" for="ConfirmDuplicatePhone">
                        Tôi xác nhận vẫn muốn cập nhật nhà cung cấp với số điện thoại này.
                    </label>
                </div>
                <span asp-validation-for="ConfirmDuplicatePhone" class="text-danger small d-block mt-1"></span>
            </div>
        }

        <div class="form-grid">
            <div>
                <label>Mã nhà cung cấp (ID)</label>
                <input type="text" value="#@Model.SupplierId" disabled class="form-control bg-light" />
            </div>

            <div>
                <label asp-for="Status">Trạng thái <span class="text-danger">*</span></label>
                <select asp-for="Status" class="form-select">
                    <option value="ACTIVE">Đang hoạt động</option>
                    <option value="INACTIVE">Ngừng hoạt động</option>
                </select>
                <span asp-validation-for="Status"></span>
            </div>

            <div class="col-span-2">
                <label asp-for="SupplierName">Tên nhà cung cấp <span class="text-danger">*</span></label>
                <input asp-for="SupplierName" placeholder="Nhập tên chính thức của nhà cung cấp" autocomplete="organization" />
                <span asp-validation-for="SupplierName"></span>
            </div>

            <div>
                <label asp-for="Nickname">Tên gợi nhớ (Nickname)</label>
                <input asp-for="Nickname" placeholder="Tên viết tắt hoặc tên giao dịch thường dùng" autocomplete="off" />
                <span asp-validation-for="Nickname"></span>
            </div>

            <div>
                <label asp-for="Phone">Số điện thoại</label>
                <input asp-for="Phone" maxlength="30" placeholder="Ví dụ: 0912345678" autocomplete="tel" />
                <span asp-validation-for="Phone"></span>
            </div>

            <div class="col-span-2">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" placeholder="Ví dụ: contact@supplier.com" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="col-span-2">
                <label asp-for="Address">Địa chỉ</label>
                <textarea asp-for="Address" rows="3" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>
                <span asp-validation-for="Address"></span>
            </div>
        </div>

        <div class="form-actions mt-4 justify-content-end">
            <button id="btnSubmitEdit" class="workspace-button" type="button" disabled>
                <i class="bi bi-save" aria-hidden="true"></i> Lưu thay đổi
            </button>
            <a class="workspace-link" asp-controller="Supplier" asp-action="Details"
               asp-route-id="@Model.SupplierId"
               asp-route-search="@Model.ReturnFilter.Search"
               asp-route-status="@Model.ReturnFilter.Status"
               asp-route-page="@Model.ReturnFilter.Page">Hủy</a>
        </div>
    </form>
</section>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmEditModal" tabindex="-1" aria-labelledby="confirmEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmEditModalLabel">Xác nhận cập nhật nhà cung cấp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn cập nhật thông tin nhà cung cấp này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnConfirmSubmit" class="workspace-button">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('editSupplierForm');
            const submitBtn = document.getElementById('btnSubmitEdit');
            const confirmBtn = document.getElementById('btnConfirmSubmit');
            const modalEl = document.getElementById('confirmEditModal');
            const modal = new bootstrap.Modal(modalEl);

            // Select only editable fields that have a name attribute
            const watchedInputs = form.querySelectorAll('input[name]:not([type="hidden"]):not([disabled]), textarea[name], select[name]');
            const initialValues = new Map();

            function getVal(el) {
                if (el.type === 'checkbox') return el.checked;
                return (el.value || '').trim();
            }

            watchedInputs.forEach(input => {
                initialValues.set(input.name, getVal(input));
            });

            function checkDirty() {
                let isDirty = false;
                watchedInputs.forEach(input => {
                    const initial = initialValues.get(input.name);
                    const current = getVal(input);
                    if (current !== initial) {
                        isDirty = true;
                    }
                });
                submitBtn.disabled = !isDirty;
            }

            watchedInputs.forEach(input => {
                input.addEventListener('input', checkDirty);
                input.addEventListener('change', checkDirty);
            });

            // Enforce dirty check on page load so initial state is disabled
            checkDirty();

            submitBtn.addEventListener('click', function () {
                if (submitBtn.disabled) return;
                if (window.jQuery && $(form).valid && !$(form).valid()) {
                    return;
                }
                modal.show();
            });

            confirmBtn.addEventListener('click', function () {
                modal.hide();
                form.submit();
            });
        });
    </script>
}

