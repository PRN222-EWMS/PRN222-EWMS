@* Shared client-side table handling for Create and Edit Return Orders *@
<script>
    window.ReturnOrderEngine = (function () {
        const body = () => document.getElementById("returnLinesBody");
        const alertBox = () => document.getElementById("noLinesAlert");

        function showWarning(msg) {
            document.getElementById("returnOrderWarning")?.remove();
            const el = document.createElement("div");
            el.id = "returnOrderWarning";
            el.className = "alert alert-warning alert-dismissible pe-auto mb-3";
            el.setAttribute("role", "alert");
            el.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i><span></span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>`;
            el.querySelector("span").textContent = msg;
            document.getElementById("inlineNotifications").appendChild(el);
            el.scrollIntoView({ behavior: "instant", block: "nearest" });
        }

        function selectedIds() {
            return Array.from(body().querySelectorAll(".soline-select, .soline-id-input")).map(el => el.value).filter(Boolean);
        }

        function syncDropdowns() {
            const used = selectedIds();
            body().querySelectorAll(".soline-select").forEach(sel => {
                Array.from(sel.options).forEach(opt => {
                    if (opt.value) opt.disabled = Number(opt.dataset.eligible) <= 0 || (opt.value !== sel.value && used.includes(opt.value));
                });
            });
        }

        function onLineChange(sel) {
            const tr = sel.closest("tr");
            const opt = sel.options[sel.selectedIndex];
            const max = parseInt(opt?.dataset.eligible || "0", 10);
            tr.querySelector(".unit-cell").textContent = opt?.dataset.unit || "-";
            tr.querySelector(".shipped-cell").textContent = opt?.dataset.shipped || "-";
            tr.querySelector(".eligible-cell").textContent = opt?.value ? max : "-";
            const qty = tr.querySelector(".requested-qty-input");
            qty.max = max || 999999;
            if (parseInt(qty.value, 10) > max || parseInt(qty.value, 10) < 1) qty.value = Math.min(1, max);
            tr.querySelector(".product-id-input").value = opt?.dataset.productId || "0";
            syncDropdowns();
        }

        function reindex() {
            body().querySelectorAll("tr").forEach((tr, i) => {
                tr.dataset.rowIndex = i;
                tr.querySelectorAll("[name]").forEach(el => el.name = el.name.replace(/Lines\[\d+\]/, `Lines[${i}]`));
            });
            if (alertBox()) alertBox().style.display = body().children.length ? "none" : "block";
            syncDropdowns();
        }

        function addRow(lines) {
            lines = (lines || []).filter(line => line.eligibleQuantity > 0);
            if (!lines.length) return showWarning("Đơn bán hàng không còn mặt hàng đủ điều kiện trả.");
            const used = selectedIds();
            const avail = lines.filter(l => !used.includes(l.solineId.toString()));
            if (!avail.length) return showWarning("Tất cả mặt hàng đủ điều kiện đã được thêm.");

            const idx = body().children.length;
            const tr = document.createElement("tr");
            tr.dataset.rowIndex = idx;

            tr.innerHTML = `
                <td>
                    <select name="Lines[${idx}].SolineId" class="form-select form-select-sm soline-select" required>
                        <option value="">-- Chọn mặt hàng --</option>
                    </select>
                    <input type="hidden" name="Lines[${idx}].ProductId" class="product-id-input" value="0" />
                </td>
                <td class="text-center unit-cell">-</td>
                <td class="text-center shipped-cell">-</td>
                <td class="text-center fw-semibold text-success eligible-cell">-</td>
                <td><input type="number" name="Lines[${idx}].RequestedQuantity" class="form-control form-control-sm text-center requested-qty-input" value="1" min="1" max="999999" required /></td>
                <td class="text-center"><button type="button" class="btn btn-sm text-danger p-0 border-0 btn-remove-line"><i class="bi bi-trash fs-6"></i></button></td>`;

            body().appendChild(tr);
            if (alertBox()) alertBox().style.display = "none";
            const sel = tr.querySelector(".soline-select");
            lines.forEach(line => {
                const option = document.createElement("option");
                option.value = line.solineId;
                option.dataset.productId = line.productId;
                option.dataset.unit = line.unit || "Cái";
                option.dataset.shipped = line.shippedQuantity;
                option.dataset.eligible = line.eligibleQuantity;
                option.textContent = `${line.productCode} — ${line.productName} (Khả dụng: ${line.eligibleQuantity})`;
                option.disabled = used.includes(line.solineId.toString());
                sel.appendChild(option);
            });
            sel.value = avail[0].solineId;
            onLineChange(sel);
        }

        function init(isCreate, fetchUrl, initialLines = []) {
            let lines = initialLines;
            body().addEventListener("change", e => e.target.classList.contains("soline-select") && onLineChange(e.target));
            body().addEventListener("click", e => {
                const btn = e.target.closest(".btn-remove-line");
                if (btn) { btn.closest("tr").remove(); reindex(); }
            });

            const btnAdd = document.getElementById("btnAddLine");
            if (btnAdd) btnAdd.onclick = () => addRow(lines);

            const soSelect = document.getElementById("salesOrderSelect");
            if (isCreate && soSelect) {
                let loadId = 0;
                soSelect.onchange = async function () {
                    const requestId = ++loadId;
                    const salesOrderId = this.value;
                    const opt = this.options[this.selectedIndex];
                    const cust = document.getElementById("customerNameDisplay");
                    const wh = document.getElementById("warehouseSelect");
                    document.getElementById("returnOrderWarning")?.remove();
                    lines = [];
                    body().replaceChildren();
                    btnAdd.style.display = "none";
                    reindex();
                    if (!salesOrderId) {
                        if (cust) cust.value = "Chưa chọn đơn bán hàng";
                        return;
                    }
                    if (cust) cust.value = opt.getAttribute("data-customer") || "Khách lẻ";
                    const defaultWh = opt.getAttribute("data-default-warehouse");
                    if (defaultWh && wh && !wh.value) wh.value = defaultWh;
                    try {
                        const res = await fetch(`${fetchUrl}?salesOrderId=${salesOrderId}`);
                        if (!res.ok) throw new Error("Không thể tải mặt hàng.");
                        const loadedLines = await res.json();
                        if (requestId !== loadId) return;
                        lines = loadedLines;
                        btnAdd.style.display = lines.some(line => line.eligibleQuantity > 0) ? "inline-block" : "none";
                        if (lines.length) addRow(lines); else reindex();
                    } catch {
                        if (requestId === loadId) showWarning("Không thể tải mặt hàng của đơn bán hàng. Vui lòng chọn lại đơn để thử lại.");
                    }
                };
            }
            syncDropdowns();
        }

        return { initCreate: (url, l) => init(true, url, l), initEdit: (l) => init(false, null, l) };
    })();
</script>
