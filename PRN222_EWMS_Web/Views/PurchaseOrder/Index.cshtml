@model PRN222_EWMS_Web.ViewModels.Purchasing.PoListViewModel
@{
    ViewData["Title"] = "Đơn mua hàng";
}

<div class="po-page order-workspace">
    <div class="workspace-heading">
        <div>
            <p class="eyebrow">MUA HÀNG & TIẾP NHẬN</p>
            <h1>Đơn mua hàng</h1>
            <p class="muted">Theo dõi số lượng đã nhận, còn chờ và đã đóng.</p>
        </div>
        @if (Model.CanCreateNew)
        {
            <div>
                <a class="workspace-button" asp-action="Create">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Tạo đơn mua hàng
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="po-alert po-alert-success" role="alert">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="po-alert po-alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <section class="workspace-card">
        <div asp-validation-summary="All" class="validation-message" role="alert"></div>

        <form method="get" asp-action="Index" class="po-filters">
            <div>
                <label for="SearchTerm">Tìm kiếm</label>
                <input id="SearchTerm" name="SearchTerm" value="@Model.SearchTerm" placeholder="Mã PO hoặc tên nhà cung cấp..." maxlength="100" />
            </div>

            <div>
                <label for="SupplierId">Nhà cung cấp</label>
                <select id="SupplierId" name="SupplierId">
                    <option value="">-- Tất cả nhà cung cấp --</option>
                    @foreach (var s in Model.Suppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>

            <div>
                <label for="WarehouseId">Kho tiếp nhận</label>
                <select id="WarehouseId" name="WarehouseId">
                    <option value="">-- Tất cả kho --</option>
                    @foreach (var w in Model.Warehouses)
                    {
                        <option value="@w.Id" selected="@(Model.WarehouseId == w.Id)">@w.Name</option>
                    }
                </select>
            </div>

            <div>
                <label for="Status">Trạng thái đơn</label>
                <select id="Status" name="Status">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="DRAFT" selected="@(Model.Status == "DRAFT")">Bản nháp</option>
                    <option value="CONFIRMED" selected="@(Model.Status == "CONFIRMED")">Đã xác nhận</option>
                    <option value="PARTIALLY_RECEIVED" selected="@(Model.Status == "PARTIALLY_RECEIVED")">Nhận một phần</option>
                    <option value="RECEIVED" selected="@(Model.Status == "RECEIVED")">Đã nhận đủ</option>
                    <option value="CLOSED" selected="@(Model.Status == "CLOSED")">Đã đóng đơn</option>
                    <option value="CANCELLED" selected="@(Model.Status == "CANCELLED")">Đã hủy</option>
                </select>
            </div>

            <div>
                <label for="FromDate">Ngày đặt từ</label>
                <input type="date" id="FromDate" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div>
                <label for="ToDate">Đến ngày</label>
                <input type="date" id="ToDate" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="d-flex align-items-center mt-2">
                <div class="checkbox-row">
                    <input type="checkbox" id="OnlyMyOrders" name="OnlyMyOrders" value="true" @(Model.OnlyMyOrders ? "checked" : "") />
                    <label for="OnlyMyOrders" class="mb-0 ms-2" style="cursor: pointer;">Chỉ hiển thị đơn do tôi tạo</label>
                </div>
            </div>

            <div class="po-toolbar">
                <button class="workspace-button" type="submit">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i> Lọc dữ liệu
                </button>
                <a class="workspace-button sales-button-secondary" asp-action="Index">
                    <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i> Xóa bộ lọc
                </a>
            </div>
        </form>

        <partial name="_PoTable" model="Model.Items" />

        <div class="sales-pagination">
            <span class="muted">
                Tổng cộng @Model.TotalItems đơn · Trang @Model.PageIndex / @Math.Max(1, Model.TotalPages)
            </span>
            <nav aria-label="Phân trang đơn mua hàng">
                @if (Model.PageIndex > 1)
                {
                    <a class="workspace-button sales-button-small"
                       asp-action="Index"
                       asp-route-PageIndex="@(Model.PageIndex - 1)"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-SupplierId="@Model.SupplierId"
                       asp-route-WarehouseId="@Model.WarehouseId"
                       asp-route-Status="@Model.Status"
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-OnlyMyOrders="@Model.OnlyMyOrders">
                        ← Trang trước
                    </a>
                }
                @if (Model.PageIndex < Model.TotalPages)
                {
                    <a class="workspace-button sales-button-small"
                       asp-action="Index"
                       asp-route-PageIndex="@(Model.PageIndex + 1)"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-SupplierId="@Model.SupplierId"
                       asp-route-WarehouseId="@Model.WarehouseId"
                       asp-route-Status="@Model.Status"
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-OnlyMyOrders="@Model.OnlyMyOrders">
                        Trang sau →
                    </a>
                }
            </nav>
        </div>
    </section>
</div>
