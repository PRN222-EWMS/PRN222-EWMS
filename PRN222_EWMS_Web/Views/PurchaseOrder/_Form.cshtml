@model PRN222_EWMS_Web.ViewModels.Purchasing.PoFormViewModel

<div asp-validation-summary="ModelOnly" class="po-alert po-alert-danger" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

@if (Model.IsEditMode)
{
    <input type="hidden" asp-for="PurchaseOrderId" />
    <input type="hidden" asp-for="Status" />
    <input type="hidden" name="RowVersion" value="@(Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : "")" />
}

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN CHÍNH -->
    <div class="col-lg-6">
        <h2 class="mb-3">Nhà cung cấp và kho nhận</h2>
        <div class="mb-3">
            <label asp-for="SupplierId" class="form-label fw-semibold">
                Nhà cung cấp <span class="text-danger">*</span>
            </label>
            @if (Model.IsEditMode && Model.IsConfirmedOrder)
            {
                <select asp-for="SupplierId" class="form-select" disabled>
                    @foreach (var s in Model.Suppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
                <input type="hidden" asp-for="SupplierId" id="SupplierIdHidden" />
                <div class="form-text text-muted">Đơn đã xác nhận không thể đổi Nhà cung cấp.</div>
            }
            else
            {
                <select asp-for="SupplierId" class="form-select" id="SupplierSelect" required>
                    <option value="">-- Chọn nhà cung cấp --</option>
                    @foreach (var s in Model.Suppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
            }
            <span asp-validation-for="SupplierId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="WarehouseId" class="form-label fw-semibold">
                Kho tiếp nhận <span class="text-danger">*</span>
            </label>
            <select asp-for="WarehouseId" class="form-select" required>
                <option value="">-- Chọn kho nhận hàng --</option>
                @foreach (var w in Model.Warehouses)
                {
                    <option value="@w.Id" selected="@(Model.WarehouseId == w.Id)">@w.Name</option>
                }
            </select>
            <span asp-validation-for="WarehouseId" class="text-danger small"></span>
        </div>
    </div>

    <!-- CỘT PHẢI: MỐC THỜI GIAN & GHI CHÚ -->
    <div class="col-lg-6">
        <h2 class="mb-3">Thông tin đơn hàng</h2>
        @if (Model.IsEditMode)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">Mã đơn mua (PO Code)</label>
                <input type="text" class="form-control" value="@Model.Pocode" readonly />
            </div>
        }
        else
        {
            <div class="mb-3">
                <label asp-for="Pocode" class="form-label fw-semibold">Mã đơn mua</label>
                <input asp-for="Pocode" class="form-control" id="PoCodeInput" placeholder="Để trống để tạo mã tự động" maxlength="40" autocomplete="off" />
                <span asp-validation-for="Pocode" class="text-danger small d-block mt-1" id="PoCodeValidationMsg"></span>
                <div class="form-text text-muted" id="PoCodeHint">Có thể nhập mã riêng, tối đa 40 ký tự.</div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="ExpectedArrivalDate" class="form-label fw-semibold">
                Ngày dự kiến đến kho <span class="text-danger">*</span>
            </label>
            <input type="date" asp-for="ExpectedArrivalDate" class="form-control" required />
            <span asp-validation-for="ExpectedArrivalDate" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Note" class="form-label fw-semibold">Ghi chú đơn hàng</label>
            <textarea asp-for="Note" class="form-control" rows="2" maxlength="1000" placeholder="Ghi chú thêm về đơn hàng hoặc thỏa thuận giao nhận..."></textarea>
            <span asp-validation-for="Note" class="text-danger small"></span>
        </div>
    </div>
</div>

<!-- KHU VỰC DÒNG SẢN PHẨM -->
<hr class="my-4" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="h5 mb-0">Danh sách sản phẩm đặt hàng <span class="text-danger">*</span></h3>
    </div>
    <button type="button" class="workspace-button sales-button-small" id="btnAddLine">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Thêm sản phẩm
    </button>
</div>

<p id="po-capacity-summary" class="text-muted small" role="status" aria-live="polite" hidden></p>
<div class="table-wrap">
    <table class="workspace-table po-lines-table" id="linesTable">
        <thead>
            <tr>
                <th style="width: 40px;">#</th>
                <th style="min-width: 320px;">Sản phẩm</th>
                <th style="width: 120px;">ĐVT</th>
                <th style="width: 180px;">Số lượng đặt</th>
                <th style="width: 60px; text-align: center;">Xóa</th>
            </tr>
        </thead>
        <tbody id="linesTbody">
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                <tr data-index="@i">
                    <td class="row-num fw-semibold text-muted">@(i + 1)</td>
                    <td>
                        <input type="hidden" name="Lines[@i].PolineId" value="@Model.Lines[i].PolineId" />
                        <select name="Lines[@i].ProductId" class="form-select product-select" required data-current="@Model.Lines[i].ProductId">
                            <option value="">-- Chọn sản phẩm --</option>
                            @foreach (var p in Model.AvailableProducts)
                            {
                                <option value="@p.ProductId" 
                                        selected="@(p.ProductId == Model.Lines[i].ProductId)" 
                                        data-unit="@p.Unit"
                                        data-code="@p.ProductCode"
                                        data-model="@p.Model">
                                    @p.ProductName
                                </option>
                            }
                        </select>
                    </td>
                    <td>
                        <span class="unit-label text-muted">@(Model.Lines[i].Unit ?? "—")</span>
                    </td>
                    <td>
                        <input type="number" 
                               name="Lines[@i].OrderedQuantity" 
                               class="form-control qty-input text-end" 
                               min="1" 
                               max="1000000" 
                               value="@Model.Lines[i].OrderedQuantity" 
                               required />
                        <div class="capacity-hint mt-1" style="font-size: 11px;"></div>
                    </td>
                    <td style="text-align: center;">
                        <button type="button" class="po-btn-danger-icon btn-remove-line" title="Xóa dòng">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="background: #fdfdfc; font-weight: 700;">
                <td colspan="3" style="text-align: right;">Tổng số lượng đặt hàng:</td>
                <td style="text-align: right;"><span id="totalQuantityDisplay">0</span></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

<div id="noLinesWarning" class="sales-empty" style="@(Model.Lines.Count > 0 ? "display: none;" : "")">
    <i class="bi bi-cart-x" style="font-size: 28px;"></i>
    <p class="mt-2 mb-0">Chưa có sản phẩm. Chọn <strong>Thêm sản phẩm</strong> để bắt đầu.</p>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const supplierSelect = document.getElementById('SupplierSelect');
        const supplierHidden = document.getElementById('SupplierIdHidden');
        const linesTbody = document.getElementById('linesTbody');
        const btnAddLine = document.getElementById('btnAddLine');
        const totalQtyDisplay = document.getElementById('totalQuantityDisplay');
        const noLinesWarning = document.getElementById('noLinesWarning');

        // Danh sách sản phẩm của nhà cung cấp hiện tại (dùng để render dropdown)
        let currentProducts = [];

        // Nạp danh sách ban đầu nếu có sẵn
        @if (Model.AvailableProducts.Count > 0)
        {
            <text>
            currentProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableProducts.Select(p => new {
                productId = p.ProductId,
                productCode = p.ProductCode,
                productName = p.ProductName,
                model = p.Model,
                unit = p.Unit
            })));
            </text>
        }

        function getSelectedSupplierId() {
            if (supplierSelect) return supplierSelect.value;
            if (supplierHidden) return supplierHidden.value;
            return null;
        }

        // Lấy sản phẩm theo Supplier khi đổi nhà cung cấp
        if (supplierSelect) {
            supplierSelect.addEventListener('change', async function () {
                const supId = this.value;
                if (!supId) {
                    currentProducts = [];
                    refreshAllProductDropdowns();
                    return;
                }

                try {
                    const response = await fetch(`/PurchaseOrder/GetSupplierProducts?supplierId=${supId}`);
                    if (response.ok) {
                        currentProducts = await response.json();
                        refreshAllProductDropdowns();
                    }
                } catch (e) {
                    console.error('Lỗi tải sản phẩm theo NCC:', e);
                }
            });
        }

        function refreshAllProductDropdowns() {
            const selects = linesTbody.querySelectorAll('.product-select');
            selects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = '<option value="">-- Chọn sản phẩm --</option>';
                currentProducts.forEach(p => {
                    const id = p.productId ?? p.ProductId;
                    const code = p.productCode ?? p.ProductCode ?? '';
                    const name = p.productName ?? p.ProductName ?? '';
                    const model = p.model ?? p.Model ?? '';
                    const unit = p.unit ?? p.Unit ?? '';

                    const opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = name;
                    opt.dataset.unit = unit;
                    opt.dataset.code = code;
                    opt.dataset.model = model;
                    if (id == currentVal) {
                        opt.selected = true;
                    }
                    select.appendChild(opt);
                });
                updateUnitForSelect(select);
            });
            recalcTotal();
            triggerCapacityCheck();
        }

        function updateUnitForSelect(select) {
            const row = select.closest('tr');
            const unitLabel = row.querySelector('.unit-label');
            const selectedOpt = select.options[select.selectedIndex];
            if (selectedOpt && selectedOpt.dataset.unit) {
                unitLabel.textContent = selectedOpt.dataset.unit;
            } else {
                unitLabel.textContent = '—';
            }
        }

        function recalcTotal() {
            let total = 0;
            const rows = linesTbody.querySelectorAll('tr');
            rows.forEach((row, idx) => {
                row.querySelector('.row-num').textContent = (idx + 1);
                // cập nhật lại thuộc tính name theo index tuần tự để MVC ModelBinder map đúng
                const polineHidden = row.querySelector('input[type="hidden"]');
                if (polineHidden) polineHidden.name = `Lines[${idx}].PolineId`;

                const prodSelect = row.querySelector('.product-select');
                if (prodSelect) prodSelect.name = `Lines[${idx}].ProductId`;

                const qtyInput = row.querySelector('.qty-input');
                if (qtyInput) {
                    qtyInput.name = `Lines[${idx}].OrderedQuantity`;
                    const val = parseInt(qtyInput.value) || 0;
                    total += val;
                }
            });

            totalQtyDisplay.textContent = total;

            if (rows.length === 0) {
                noLinesWarning.style.display = 'block';
            } else {
                noLinesWarning.style.display = 'none';
            }
        }

        // Thêm dòng mới
        btnAddLine.addEventListener('click', function () {
            const supId = getSelectedSupplierId();
            if (!supId) {
                alert('Vui lòng chọn Nhà cung cấp trước khi thêm sản phẩm.');
                if (supplierSelect) supplierSelect.focus();
                return;
            }

            if (currentProducts.length === 0) {
                alert('Nhà cung cấp này hiện chưa có sản phẩm nào trong danh mục hàng cung ứng.');
                return;
            }

            const newRow = document.createElement('tr');
            let optionsHtml = '<option value="">-- Chọn sản phẩm --</option>';
            currentProducts.forEach(p => {
                const id = p.productId ?? p.ProductId;
                const code = p.productCode ?? p.ProductCode ?? '';
                const name = p.productName ?? p.ProductName ?? '';
                const model = p.model ?? p.Model ?? '';
                const unit = p.unit ?? p.Unit ?? '';
                optionsHtml += `<option value="${id}" data-unit="${unit}" data-code="${code}" data-model="${model}">${name}</option>`;
            });

            newRow.innerHTML = `
                <td class="row-num fw-semibold text-muted"></td>
                <td>
                    <select class="form-select product-select" required>
                        ${optionsHtml}
                    </select>
                </td>
                <td>
                    <span class="unit-label text-muted">—</span>
                </td>
                <td>
                    <input type="number" class="form-control qty-input text-end" min="1" max="1000000" value="1" required />
                    <div class="capacity-hint mt-1" style="font-size: 11px;"></div>
                </td>
                <td style="text-align: center;">
                    <button type="button" class="po-btn-danger-icon btn-remove-line" title="Xóa dòng">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                    </button>
                </td>
            `;

            linesTbody.appendChild(newRow);
            recalcTotal();
            triggerCapacityCheck(newRow);
        });

        // Xóa dòng & thay đổi sản phẩm/số lượng
        linesTbody.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-remove-line');
            if (btn) {
                const row = btn.closest('tr');
                row.remove();
                recalcTotal();
                triggerCapacityCheck();
            }
        });

        linesTbody.addEventListener('change', function (e) {
            if (e.target.classList.contains('product-select')) {
                updateUnitForSelect(e.target);
                
                // Kiểm tra trùng lặp sản phẩm
                const selectedVal = e.target.value;
                if (selectedVal) {
                    let count = 0;
                    linesTbody.querySelectorAll('.product-select').forEach(s => {
                        if (s.value === selectedVal) count++;
                    });
                    if (count > 1) {
                        alert('Sản phẩm này đã được chọn trong đơn hàng. Vui lòng cộng gộp số lượng vào dòng đã có thay vì chọn trùng.');
                        e.target.value = '';
                        updateUnitForSelect(e.target);
                    }
                }
            }
        });

        linesTbody.addEventListener('input', function (e) {
            if (e.target.classList.contains('qty-input')) {
                recalcTotal();
                const row = e.target.closest('tr');
                if (row) triggerCapacityCheck(row);
            }
        });

        // One request evaluates every line against the same warehouse snapshot.
        const warehouseSelect = document.querySelector('select[name="WarehouseId"]');
        const arrivalInput = document.querySelector('input[name="ExpectedArrivalDate"]');
        const capacityForm = linesTbody.closest('form');
        const capacitySummary = document.getElementById('po-capacity-summary');
        let capacityTimer = null, capacityRequest = null, capacityVersion = 0;

        function capacityMessage(row, text, error = false, pending = false) {
            const hint = row.querySelector('.capacity-hint');
            const quantity = row.querySelector('.qty-input');
            if (hint) {
                const span = document.createElement('span');
                span.className = error ? 'text-danger' : pending ? 'text-muted' : 'text-success';
                span.textContent = text;
                hint.replaceChildren(span);
            }
            quantity?.classList.toggle('is-invalid', error);
            if (error || pending) {
                row.dataset.capacityError = 'true';
                row.dataset.errorMessage = text;
            } else {
                delete row.dataset.capacityError;
                delete row.dataset.errorMessage;
            }
        }

        function triggerCapacityCheck() {
            clearTimeout(capacityTimer);
            capacityRequest?.abort();
            const version = ++capacityVersion;
            const rows = [...linesTbody.querySelectorAll('tr')];
            if (capacitySummary) { capacitySummary.hidden = true; capacitySummary.textContent = ''; }
            if (!warehouseSelect?.value || rows.length === 0) {
                rows.forEach(row => capacityMessage(row, ''));
                return;
            }
            let complete = true;
            rows.forEach(row => {
                const id = parseInt(row.querySelector('.product-select')?.value);
                const quantity = Number(row.querySelector('.qty-input')?.value);
                if (!id) { complete = false; capacityMessage(row, ''); }
                else if (!Number.isInteger(quantity) || quantity < 1 || quantity > 1000000) {
                    complete = false; capacityMessage(row, 'Số lượng phải là số nguyên từ 1 đến 1.000.000.', true);
                } else capacityMessage(row, 'Đang kiểm tra sức chứa cho toàn bộ các dòng…', false, true);
            });
            if (!complete || !arrivalInput?.value) {
                rows.filter(row => row.dataset.capacityError === 'true' && !row.querySelector('.qty-input')?.classList.contains('is-invalid'))
                    .forEach(row => capacityMessage(row, 'Chọn đủ sản phẩm và ngày nhận để kiểm tra sức chứa.', false, true));
                return;
            }
            capacityTimer = setTimeout(async () => {
                capacityRequest = new AbortController();
                try {
                    const response = await fetch('/PurchaseOrder/CheckCapacity', {
                        method: 'POST', body: new FormData(capacityForm), credentials: 'same-origin',
                        signal: capacityRequest.signal, headers: { Accept: 'application/json' }
                    });
                    if (response.redirected)
                        throw new Error('Phiên đăng nhập thay đổi. Hãy tải lại trang.');
                    if (!response.headers.get('content-type')?.includes('application/json'))
                        throw new Error('Không tải được kết quả sức chứa. Hãy thử lại hoặc tải lại trang.');
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.message || 'Không kiểm tra được sức chứa.');
                    if (version !== capacityVersion) return;
                    const limits = new Map((data.lines || []).map(line => [String(line.productId), line]));
                    const problem = (data.errors || []).join(' ');
                    rows.forEach(row => {
                        const line = limits.get(row.querySelector('.product-select').value);
                        if (!line) capacityMessage(row, problem || 'Không tính được hạn mức. Hãy chọn lại sản phẩm.', true);
                        else {
                            const amount = Number(line.maxOrderQuantity).toLocaleString('vi-VN');
                            const detail = 'Dòng này tối đa ' + amount + ' chiếc với các dòng còn lại đang chọn. '
                                + 'Sàn: ' + Number(line.floorSlotCapacity).toLocaleString('vi-VN')
                                + ', kệ: ' + Number(line.rackTierCapacity).toLocaleString('vi-VN') + '.';
                            capacityMessage(row, line.isValid ? detail : detail + ' ' + (line.errorMessage || problem), !line.isValid);
                        }
                    });
                    if (capacitySummary) {
                        capacitySummary.textContent = 'Đã dự phòng hàng chưa nhận: mua hàng '
                            + Number(data.incomingPurchaseQuantity || 0).toLocaleString('vi-VN')
                            + ', chuyển kho ' + Number(data.incomingTransferQuantity || 0).toLocaleString('vi-VN')
                            + ', khách trả ' + Number(data.incomingReturnQuantity || 0).toLocaleString('vi-VN')
                            + ' chiếc. ' + (data.warnings || []).join(' ');
                        capacitySummary.hidden = false;
                    }
                } catch (error) {
                    if (error.name !== 'AbortError' && version === capacityVersion)
                        rows.filter(row => row.isConnected).forEach(row => capacityMessage(row, error.message || 'Không kiểm tra được sức chứa. Thử lại hoặc tải lại trang.', true));
                }
            }, 350);
        }

        warehouseSelect?.addEventListener('change', triggerCapacityCheck);
        arrivalInput?.addEventListener('change', triggerCapacityCheck);
        linesTbody.addEventListener('change', event => {
            if (event.target.classList.contains('product-select')) triggerCapacityCheck();
        });

        // Xử lý mã đơn mua (PO Code)
        const poCodeInput = document.getElementById('PoCodeInput');
        const poCodeMsg = document.getElementById('PoCodeValidationMsg');

        // Khi điền mã đơn mua: không kiểm tra báo đỏ, tự động xóa lỗi cũ khi người dùng gõ
        if (poCodeInput) {
            poCodeInput.addEventListener('input', function () {
                poCodeInput.classList.remove('is-invalid');
                if (poCodeMsg) {
                    poCodeMsg.innerHTML = '';
                }
            });
        }

        // Khởi tạo tính toán ban đầu
        recalcTotal();
        linesTbody.querySelectorAll('tr').forEach(r => triggerCapacityCheck(r));

        // Kiểm tra trước khi submit form (Lưu bản nháp hoặc Lưu & Xác nhận đơn)
        const form = document.getElementById('createPoForm') || document.getElementById('editPoForm');
        if (form) {
            let submitAction = 'draft';
            let isProgrammaticSubmit = false;

            // Ghi nhận nút submit nào được nhấn (Lưu bản nháp / Lưu & Xác nhận đơn)
            form.querySelectorAll('button[type="submit"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    submitAction = this.value || 'draft';
                });
            });

            form.addEventListener('submit', async function (e) {
                if (isProgrammaticSubmit) {
                    return true;
                }

                const rows = linesTbody.querySelectorAll('tr');
                if (rows.length === 0) {
                    e.preventDefault();
                    alert('Đơn mua hàng phải có ít nhất một dòng sản phẩm. Vui lòng bấm "Thêm sản phẩm" trước khi lưu.');
                    return false;
                }

                // Kiểm tra số lượng hợp lệ và sức chứa kho (bắt buộc cho cả Lưu bản nháp và Xác nhận đơn)
                let hasCapacityError = false;
                let capacityErrorMsg = '';
                let firstInvalidInput = null;

                rows.forEach((row) => {
                    const qtyInput = row.querySelector('.qty-input');
                    const qty = parseInt(qtyInput ? qtyInput.value : 0) || 0;
                    if (qty <= 0) {
                        hasCapacityError = true;
                        if (!capacityErrorMsg) capacityErrorMsg = 'Số lượng đặt hàng của mỗi sản phẩm phải là số nguyên dương lớn hơn 0.';
                        if (!firstInvalidInput && qtyInput) firstInvalidInput = qtyInput;
                        if (qtyInput) qtyInput.classList.add('is-invalid');
                    } else if (row.dataset.capacityError === 'true') {
                        hasCapacityError = true;
                        if (!capacityErrorMsg) {
                            capacityErrorMsg = row.dataset.errorMessage || 'Số lượng đặt hàng cho một số sản phẩm vượt quá sức chứa tối đa của kho tiếp nhận.';
                        }
                        if (!firstInvalidInput && qtyInput) firstInvalidInput = qtyInput;
                    }
                });

                if (hasCapacityError) {
                    e.preventDefault();
                    alert(capacityErrorMsg || 'Vui lòng kiểm tra lại sức chứa kho và số lượng đặt hàng trước khi lưu đơn.');
                    if (firstInvalidInput) firstInvalidInput.focus();
                    return false;
                }

                const poVal = poCodeInput ? poCodeInput.value.trim() : '';
                // Nếu người dùng nhập mã đơn mua, chỉ kiểm tra trùng khi submit form
                if (poVal) {
                    e.preventDefault();

                    try {
                        const res = await fetch(`/PurchaseOrder/CheckPoCode?poCode=${encodeURIComponent(poVal)}`);
                        if (res.ok) {
                            const data = await res.json();
                            if (data.isDuplicate) {
                                // Chỉ hiển thị thông báo đỏ ở thẻ span phía dưới, không báo đỏ viền ngoài ô nhập
                                if (poCodeInput) {
                                    poCodeInput.classList.remove('is-invalid');
                                    poCodeInput.focus();
                                }
                                if (poCodeMsg) {
                                    poCodeMsg.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>${data.message}`;
                                }
                                return false;
                            }
                        }
                    } catch (err) {
                        console.error('Lỗi khi kiểm tra mã đơn mua:', err);
                    }

                    // Không trùng lặp: tiếp tục gửi form với đúng action đã chọn
                    isProgrammaticSubmit = true;
                    let hiddenAction = form.querySelector('input[name="action"][type="hidden"]');
                    if (!hiddenAction) {
                        hiddenAction = document.createElement('input');
                        hiddenAction.type = 'hidden';
                        hiddenAction.name = 'action';
                        form.appendChild(hiddenAction);
                    }
                    hiddenAction.value = submitAction;
                    form.submit();
                }
            });
        }
    });
</script>
