@model PRN222_EWMS_Web.ViewModels.Purchasing.PoDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.Pocode;
    var statusClass = Model.Status switch
    {
        "DRAFT" => "po-status-draft",
        "CONFIRMED" => "po-status-confirmed",
        "PARTIALLY_RECEIVED" => "po-status-partially",
        "RECEIVED" => "po-status-received",
        "CLOSED" => "po-status-closed",
        "CANCELLED" => "po-status-cancelled",
        _ => "po-status-draft"
    };

    var statusText = Model.Status switch
    {
        "DRAFT" => "Bản nháp",
        "CONFIRMED" => "Đã xác nhận",
        "PARTIALLY_RECEIVED" => "Đang nhận một phần",
        "RECEIVED" => "Đã nhận đủ",
        "CLOSED" => "Đã đóng đơn",
        "CANCELLED" => "Đã hủy",
        _ => Model.Status
    };
}

<div class="po-page">
    <div class="workspace-heading">
        <div>
            <p class="eyebrow">MUA HÀNG / CHI TIẾT ĐƠN MUA</p>
            <div class="d-flex align-items-center gap-3">
                <h1 class="mb-0">@Model.Pocode</h1>
                <span class="po-status @statusClass">@statusText</span>
                @if (Model.IsOverdue)
                {
                    <span class="po-overdue-tag">
                        <i class="bi bi-clock-history" aria-hidden="true"></i> Quá hạn giao
                    </span>
                }
            </div>
            <p class="muted mt-1">Tạo ngày @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") bởi @Model.CreatedByName</p>
        </div>
        <div class="po-toolbar">
            <a class="workspace-button sales-button-secondary" asp-action="Index">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Danh sách đơn
            </a>
            @if (Model.CanEdit)
            {
                <a class="workspace-button" asp-action="Edit" asp-route-id="@Model.PurchaseOrderId">
                    <i class="bi bi-pencil me-1" aria-hidden="true"></i> Chỉnh sửa đơn
                </a>
            }
            @if (Model.CanConfirm)
            {
                <form method="post" asp-action="Confirm" asp-route-id="@Model.PurchaseOrderId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận đơn mua hàng này? Sau khi xác nhận, đơn sẽ sẵn sàng để kho tiếp nhận.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="workspace-button" style="background: #0e733b;">
                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Xác nhận đơn
                    </button>
                </form>
            }
            @if (Model.CanCloseRemainder)
            {
                <button type="button" class="workspace-button sales-button-secondary" onclick="openCloseModal()">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Đóng số lượng còn lại
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="po-alert po-alert-success" role="alert">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="po-alert po-alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (!Model.CanEdit && (Model.Status == "CONFIRMED" || Model.Status == "PARTIALLY_RECEIVED"))
    {
        <div class="po-alert po-alert-warning" role="status">
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
            <div>
                <strong>Quy tắc khóa đơn mua hàng (Inbound Lock):</strong>
                <span>Đơn mua hàng đã có đợt nhận hàng (Inbound) được lưu trong hệ thống. Để bảo toàn tính toàn vẹn của chuỗi cung ứng và lịch sử đối chiếu kho, đơn mua hàng này đã bị khóa sửa.</span>
            </div>
        </div>
    }

    <!-- 1. THÔNG TIN CHUNG (GRID 3 CỘT) -->
    <div class="po-details-grid">
        <div class="po-details-card">
            <h3><i class="bi bi-building me-1"></i> Nhà cung cấp</h3>
            <dl>
                <div>
                    <dt>Tên đối tác</dt>
                    <dd class="fw-semibold">@Model.SupplierName</dd>
                </div>
                <div>
                    <dt>Số điện thoại</dt>
                    <dd>@(Model.SupplierPhone ?? "—")</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd>@(Model.SupplierEmail ?? "—")</dd>
                </div>
                <div>
                    <dt>Địa chỉ</dt>
                    <dd>@(Model.SupplierAddress ?? "—")</dd>
                </div>
            </dl>
        </div>

        <div class="po-details-card">
            <h3><i class="bi bi-box-seam me-1"></i> Kho tiếp nhận</h3>
            <dl>
                <div>
                    <dt>Tên kho</dt>
                    <dd class="fw-semibold">@Model.WarehouseName</dd>
                </div>
                <div>
                    <dt>Loại kho</dt>
                    <dd>@Model.WarehouseType</dd>
                </div>
                <div>
                    <dt>Địa chỉ kho</dt>
                    <dd>@(Model.WarehouseAddress ?? "—")</dd>
                </div>
            </dl>
        </div>

        <div class="po-details-card">
            <h3><i class="bi bi-calendar3 me-1"></i> Tiến độ & Mốc thời gian</h3>
            <dl>
                <div>
                    <dt>Ngày đặt hàng</dt>
                    <dd>@Model.OrderDate.ToString("dd/MM/yyyy")</dd>
                </div>
                <div>
                    <dt>Ngày dự kiến giao hàng</dt>
                    <dd class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")">
                        @Model.ExpectedArrivalDate.ToString("dd/MM/yyyy")
                    </dd>
                </div>
                <div>
                    <dt>Thời điểm xác nhận</dt>
                    <dd>@(Model.ConfirmedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác nhận")</dd>
                </div>
                @if (Model.ClosedAt.HasValue)
                {
                    <div>
                        <dt>Thời điểm đóng đơn</dt>
                        <dd>@Model.ClosedAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                }
            </dl>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <section class="workspace-card">
            <h3 class="h6 mb-2 text-muted text-uppercase" style="font-size: 12px; letter-spacing: 0.5px;">Ghi chú đơn hàng</h3>
            <p class="mb-0" style="white-space: pre-wrap;">@Model.Note</p>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.CloseReason))
    {
        <section class="workspace-card" style="border-left: 4px solid #736f69;">
            <h3 class="h6 mb-2 text-muted text-uppercase" style="font-size: 12px; letter-spacing: 0.5px;">Lý do đóng đơn</h3>
            <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.CloseReason</p>
        </section>
    }

    <!-- 2. DANH SÁCH SẢN PHẨM (PRODUCT LINES) -->
    <section class="workspace-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Chi tiết sản phẩm đặt hàng</h2>
                <p class="muted mb-0">Theo dõi tiến độ nhận hàng thực tế theo từng dòng sản phẩm.</p>
            </div>
            <div class="text-end">
                <span class="muted small">Tiến độ chung:</span>
                <strong>@Model.TotalReceived / @Model.TotalOrdered</strong> (@Model.ProgressPercent%)
            </div>
        </div>

        <div class="table-wrap">
            <table class="workspace-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm / Model</th>
                        <th>Đặc tính (D x R x C | Khối lượng)</th>
                        <th>ĐVT</th>
                        <th style="text-align: right;">Đặt hàng</th>
                        <th style="text-align: right;">Đã nhận</th>
                        <th style="text-align: right;">Đã đóng</th>
                        <th style="text-align: right;">Còn lại</th>
                        <th>Trạng thái dòng</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@(idx++)</td>
                            <td><span class="fw-semibold">@line.ProductCode</span></td>
                            <td>
                                <div class="fw-medium">@line.ProductName</div>
                                <div class="small muted">Model: @line.Model | Nhãn: @line.BrandName</div>
                            </td>
                            <td>
                                <div class="small">@line.Dimensions</div>
                                <div class="small muted">@line.GrossWeightKg kg</div>
                            </td>
                            <td>@line.Unit</td>
                            <td style="text-align: right; font-weight: 600;">@line.OrderedQuantity</td>
                            <td style="text-align: right; color: #0e733b; font-weight: 600;">@line.ReceivedQuantity</td>
                            <td style="text-align: right; color: #736f69;">@line.ClosedQuantity</td>
                            <td style="text-align: right; font-weight: 700; color: @(line.RemainingQuantity > 0 ? "#0060b9" : "#615d59");">
                                @line.RemainingQuantity
                            </td>
                            <td>
                                <span class="badge @(line.RemainingQuantity == 0 ? "bg-success" : line.ReceivedQuantity > 0 ? "bg-primary" : "bg-light text-dark")">
                                    @line.LineStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background: #fdfdfc; font-weight: 700;">
                        <td colspan="5" style="text-align: right;">Tổng cộng:</td>
                        <td style="text-align: right;">@Model.TotalOrdered</td>
                        <td style="text-align: right; color: #0e733b;">@Model.TotalReceived</td>
                        <td style="text-align: right; color: #736f69;">@Model.TotalClosed</td>
                        <td style="text-align: right; color: #0060b9;">@Model.TotalRemaining</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

    <!-- 3. LỊCH SỬ CÁC ĐỢT NHẬN HÀNG (INBOUNDS) -->
    <section class="workspace-card">
        <h2>Lịch sử các đợt nhận hàng (Inbounds)</h2>
        <p class="muted">Danh sách các phiếu nhập kho đã thực hiện đối với đơn mua hàng này.</p>

        <div class="table-wrap">
            <table class="workspace-table">
                <thead>
                    <tr>
                        <th>Mã phiếu nhập</th>
                        <th>Ngày nhập kho</th>
                        <th>Người tiếp nhận</th>
                        <th>Số lượng serial nhận</th>
                        <th>Thời điểm hoàn tất</th>
                        <th>Trạng thái phiếu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inbound in Model.Inbounds)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@inbound.ReceiptCode</span>
                            </td>
                            <td>@inbound.ReceiptDate.ToString("dd/MM/yyyy")</td>
                            <td>@inbound.PerformedByName</td>
                            <td><strong>@inbound.ItemCount</strong> serial</td>
                            <td>@(inbound.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td>
                                <span class="po-status @(inbound.Status == "DONE" ? "po-status-received" : "po-status-confirmed")">
                                    @inbound.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Inbounds.Count == 0)
        {
            <div class="sales-empty">
                <i class="bi bi-box-arrow-in-down" style="font-size: 28px;" aria-hidden="true"></i>
                <p class="mt-2 mb-0">Chưa có đợt nhận hàng nào được ghi nhận cho đơn mua hàng này.</p>
            </div>
        }
    </section>
</div>

<!-- MODAL ĐÓNG SỐ LƯỢNG CÒN LẠI -->
@if (Model.CanCloseRemainder)
{
    <div id="closeRemainderModal" class="po-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="po-modal">
            <div class="po-modal-header">
                <h3 id="modalTitle">Đóng số lượng còn lại đơn mua</h3>
                <button type="button" class="btn-close" onclick="closeCloseModal()" aria-label="Đóng"></button>
            </div>
            <form method="post" asp-action="CloseRemainder">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PurchaseOrderId" value="@Model.PurchaseOrderId" />

                <p class="text-muted small">
                    Số lượng còn lại chưa giao là <strong>@Model.TotalRemaining</strong> sản phẩm. Khi đóng số lượng còn lại, nhà cung cấp sẽ không tiếp tục giao phần còn lại này và đơn sẽ được chuyển sang trạng thái ĐÃ ĐÓNG (CLOSED).
                </p>

                <div class="mb-3">
                    <label for="closeReasonInput" class="form-label fw-semibold">Lý do đóng đơn <span class="text-danger">*</span></label>
                    <textarea id="closeReasonInput" name="Reason" class="form-control" rows="3" required maxlength="500" placeholder="Ví dụ: Nhà cung cấp hết hàng đợt 2, hai bên thỏa thuận hủy phần còn lại..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="workspace-button sales-button-secondary" onclick="closeCloseModal()">Hủy bỏ</button>
                    <button type="submit" class="workspace-button" style="background: #c92a2a;">Xác nhận đóng đơn</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openCloseModal() {
            document.getElementById('closeRemainderModal').classList.add('show');
        }
        function closeCloseModal() {
            document.getElementById('closeRemainderModal').classList.remove('show');
        }
    </script>
}
