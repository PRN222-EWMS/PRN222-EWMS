@model PRN222_EWMS_Web.ViewModels.Sales.SalesOrderListViewModel
@using PRN222_EWMS_Web.ViewModels.Sales
@{ ViewData["Title"] = "Đơn bán hàng"; }

<div class="sales-page">
<div class="workspace-heading">
    <div>
        <p class="eyebrow">BÁN HÀNG</p>
        <h1>Đơn bán hàng</h1>
        <p class="muted">@(Model.IsWarehouseStaff ? "Tra cứu đơn bán hàng đã gửi thuộc kho được phân công." : Model.CanFilterMine ? "Tra cứu tất cả đơn hoặc theo dõi những đơn do bạn tạo." : "Theo dõi đơn bán hàng và tiến độ xuất của tất cả kho.")</p>
    </div>
    @if (User.IsInRole("SALES_STAFF"))
    {
        <div class="sales-toolbar">
            <a class="workspace-button" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i> Tạo đơn bán hàng
            </a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="sales-alert sales-alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="sales-warning" role="alert">@TempData["Error"]</div>
}

<section class="workspace-card">
@if (!string.IsNullOrEmpty(Model.ScopeMessage))
{
    <div class="sales-warning" role="status">@Model.ScopeMessage</div>
}
<div asp-validation-summary="All" class="validation-message" role="alert"></div>
<form method="get" asp-action="Index" class="sales-filters">
    <div><label for="Search">Tìm đơn bán hàng</label><input id="Search" name="Search" value="@Model.Search" placeholder="Mã đơn hoặc tên khách hàng" maxlength="200" /></div>
    <div><label for="Status">Trạng thái</label><select id="Status" name="Status"><option value="">Tất cả trạng thái</option>@foreach(var status in new[]{"DRAFT","SUBMITTED","PARTIALLY_FULFILLED","FULFILLED","CLOSED","CANCELLED"}.Where(s => !Model.IsWarehouseStaff || s != "DRAFT")){<option value="@status" selected="@(Model.Status == status)">@SalesDisplay.Status(status)</option>}</select></div>
    @if (Model.IsWarehouseStaff)
    {
        <div><label for="AssignedWarehouse">Kho được phân công</label><input id="AssignedWarehouse" value="@(Model.Warehouses.FirstOrDefault()?.Text ?? "Chưa được phân công kho")" readonly /></div>
    }
    else
    {
        <div><label asp-for="WarehouseId">Kho xuất</label><select asp-for="WarehouseId" asp-items="Model.Warehouses"><option value="">Tất cả kho</option></select></div>
    }
    <div><label for="From">Ngày đơn từ</label><input type="date" id="From" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" /></div>
    <div><label for="To">Đến ngày</label><input type="date" id="To" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" /></div>
    @if (Model.CanFilterMine)
    {
        <div><label for="Mine">Phạm vi</label><select id="Mine" name="Mine"><option value="false" selected="@(!Model.Mine)">Tất cả đơn</option><option value="true" selected="@Model.Mine">Đơn của tôi</option></select></div>
    }
    <div class="sales-toolbar"><button class="workspace-button" type="submit">Tìm kiếm</button><a class="workspace-button sales-button-secondary" asp-action="Index">Xóa bộ lọc</a></div>
</form>
<div class="table-wrap"><table class="workspace-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Kho xuất</th><th>Ngày đơn</th><th>Người tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var order in Model.Items){<tr><td><a class="workspace-button sales-button-small" asp-action="Details" asp-route-id="@order.Id">@order.Code</a></td><td>@order.CustomerName</td><td>@order.WarehouseName</td><td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@order.CreatedByName</td><td><span class="sales-status">@SalesDisplay.Status(order.Status)</span>@if(order.HasShortage){<div class="sales-muted-small text-danger">Thiếu nguồn</div>}</td><td><div class="d-flex gap-2"><a class="workspace-button sales-button-small" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a>@if(order.CanEdit && User.IsInRole("SALES_STAFF")){<a class="workspace-button sales-button-small sales-button-secondary" asp-action="Edit" asp-route-id="@order.Id">Sửa</a>}</div></td></tr>}
</tbody></table></div>
@if(Model.Items.Count == 0){<p class="sales-empty">Không có đơn bán hàng phù hợp với bộ lọc.</p>}
<div class="sales-pagination"><span class="muted">@Model.TotalCount đơn · Trang @Model.Page / @Model.TotalPages</span><nav aria-label="Phân trang đơn bán hàng">
@if(Model.Page > 1){<a class="workspace-button sales-button-small" asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-warehouseId="@Model.WarehouseId" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-mine="@Model.Mine">Trước</a>}
@if(Model.Page < Model.TotalPages){<a class="workspace-button sales-button-small" asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-warehouseId="@Model.WarehouseId" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-mine="@Model.Mine">Sau</a>}
</nav></div>
</section></div>
