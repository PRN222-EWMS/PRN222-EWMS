@model PRN222_EWMS_Web.ViewModels.Sales.SalesOrderFormViewModel

<div asp-validation-summary="All" class="sales-warning mb-4" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

@if (Model.IsEditMode)
{
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Status" />
    <input type="hidden" name="ConcurrencyToken" value="@Model.ConcurrencyToken" />
}

<div class="sales-form-grid">
    <!-- CỘT 1: THÔNG TIN KHÁCH HÀNG & KHO -->
    <div class="workspace-card">
        <h2 class="h5 mb-3">1. Thông tin giao dịch</h2>
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="CustomerId" class="form-label fw-semibold mb-0">
                    Khách hàng <span class="text-danger">*</span>
                </label>
                @if (!Model.IsEditMode || Model.Status == "DRAFT")
                {
                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" id="btnOpenQuickCustomer" style="font-size: 0.82rem;" data-bs-toggle="modal" data-bs-target="#quickCreateCustomerModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Tạo nhanh khách hàng
                    </button>
                }
            </div>
            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select" id="CustomerSelect" required>
                <option value="">-- Chọn khách hàng --</option>
            </select>
            <span asp-validation-for="CustomerId" class="text-danger small"></span>
            <div id="quickCustomerSuccessAlert" class="text-success small fw-semibold mt-1 d-none"></div>
        </div>

        <div class="mb-3">
            <label asp-for="WarehouseId" class="form-label fw-semibold">
                Kho xuất hàng <span class="text-danger">*</span>
            </label>
            @if (Model.IsEditMode && Model.Status == "SUBMITTED")
            {
                <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select" id="WarehouseSelect" required>
                </select>
            }
            else
            {
                <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select" id="WarehouseSelect" required>
                    <option value="">-- Chọn kho xuất hàng --</option>
                </select>
            }
            <span asp-validation-for="WarehouseId" class="text-danger small"></span>
        </div>
    </div>

    <!-- CỘT 2: MÃ ĐƠN, MỐC THỜI GIAN & GHI CHÚ -->
    <div class="workspace-card">
        <h2 class="h5 mb-3">2. Mốc thời gian & ghi chú</h2>
        <div class="mb-3">
            <label class="form-label fw-semibold">Mã đơn bán</label>
            <input type="hidden" asp-for="Code" />
            <input type="text" class="form-control" value="@Model.Code" readonly style="background:#f6f5f4;" />
        </div>

        <div class="row g-2 mb-3">
            <div class="col-6">
                <label asp-for="OrderDate" class="form-label fw-semibold">Ngày đặt</label>
                <input type="date" asp-for="OrderDate" class="form-control" readonly style="background:#f6f5f4;" />
            </div>
            <div class="col-6">
                <label asp-for="RequestedDate" class="form-label fw-semibold">
                    Ngày yêu cầu xuất <span class="text-danger" id="reqDateAsterisk">*</span>
                </label>
                <input type="date" asp-for="RequestedDate" class="form-control" id="RequestedDateInput" min="@Model.OrderDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="RequestedDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Note" class="form-label fw-semibold">Ghi chú đơn hàng</label>
            <textarea asp-for="Note" class="form-control" rows="2" maxlength="500"></textarea>
            <span asp-validation-for="Note" class="text-danger small"></span>
        </div>
    </div>
</div>

<!-- KHỐI SẢN PHẨM YÊU CẦU -->
<section class="workspace-card mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h5 mb-0">3. Danh sách sản phẩm yêu cầu <span class="text-danger">*</span></h2>
        </div>
        <button type="button" class="workspace-button sales-button-small" id="btnAddLine">
            <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm
        </button>
    </div>

    <div class="table-wrap">
        <table class="workspace-table sales-lines-table" id="linesTable">
            <thead>
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th style="min-width: 280px;">Sản phẩm</th>
                    <th style="width: 100px;">ĐVT</th>
                    <th style="width: 180px;">Tồn khả dụng</th>
                    <th style="width: 160px; text-align: right;">Số lượng yêu cầu</th>
                    <th style="width: 70px; text-align: center;">Xóa</th>
                </tr>
            </thead>
            <tbody id="linesTbody">
                @for (int i = 0; i < Model.Lines.Count; i++)
                {
                    <tr>
                        <td class="row-num text-muted fw-semibold">@(i + 1)</td>
                        <td>
                            <input type="hidden" name="Lines[@i].SolineId" value="@Model.Lines[i].SolineId" />
                            <select name="Lines[@i].ProductId" class="form-select product-select" required>
                                <option value="">-- Chọn sản phẩm --</option>
                                @foreach (var p in Model.AvailableProducts)
                                {
                                    <option value="@p.ProductId"
                                            data-unit="@p.Unit"
                                            data-code="@p.ProductCode"
                                            data-unreserved="@p.UnreservedQuantity"
                                            selected="@(Model.Lines[i].ProductId == p.ProductId)">
                                        [@p.ProductCode] @p.ProductName
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <span class="unit-label text-muted">@(Model.Lines[i].Unit ?? "—")</span>
                        </td>
                        <td>
                            <span class="stock-badge badge-stock">Khả dụng: <strong>@Model.Lines[i].AvailableQuantity</strong></span>
                        </td>
                        <td>
                            <input type="number"
                                   name="Lines[@i].RequestedQuantity"
                                   class="form-control qty-input text-end"
                                   min="1"
                                   max="1000000"
                                   value="@Model.Lines[i].RequestedQuantity"
                                   required />
                        </td>
                        <td style="text-align: center;">
                            <button type="button" class="btn-remove-line sales-danger-icon" title="Xóa dòng">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background: #fafaf9; font-weight: 600;">
                    <td colspan="4" class="text-end pe-3">Tổng số lượng yêu cầu:</td>
                    <td class="text-end" id="totalQtyDisplay">0</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div id="noLinesWarning" class="sales-muted-small text-danger mt-2" style="@(Model.Lines.Count == 0 ? "" : "display:none;")">
        <i class="bi bi-exclamation-circle me-1"></i> Đơn hàng phải có ít nhất 1 dòng sản phẩm yêu cầu.
    </div>
</section>

<!-- NÚT THAO TÁC CUỐI TRANG -->
<div class="sales-form-actions mt-4 justify-content-end">
    @if (!Model.IsEditMode)
    {
        <a asp-action="Index" class="workspace-button sales-button-secondary">Thoát</a>
        <button type="submit" name="action" value="draft" class="workspace-button sales-button-secondary">
            <i class="bi bi-file-earmark me-1"></i> Lưu nháp
        </button>
        <button type="submit" name="action" value="submit" class="workspace-button">
            <i class="bi bi-send-check me-1"></i> Gửi đơn hàng
        </button>
    }
    else
    {
        <a asp-action="Index" class="workspace-button sales-button-secondary">Thoát</a>
        @if (Model.CanCancel && (Model.Status == "DRAFT" || Model.Status == "SUBMITTED"))
        {
            <button type="button" class="workspace-button sales-button-secondary text-danger border-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Hủy đơn hàng
            </button>
        }
        @if (Model.Status == "DRAFT")
        {
            <button type="submit" name="action" value="draft" class="workspace-button sales-button-secondary">
                <i class="bi bi-file-earmark me-1"></i> Lưu nháp
            </button>
            <button type="submit" name="action" value="submit" class="workspace-button">
                <i class="bi bi-send-check me-1"></i> Gửi đơn hàng
            </button>
        }
        else
        {
            <button type="submit" name="action" value="save" class="workspace-button">
                <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi
            </button>
        }
    }
</div>

@* JSON cache danh mục sản phẩm ban đầu *@
<script id="initialProductsJson" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableProducts, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const warehouseSelect = document.getElementById('WarehouseSelect');
        const linesTbody = document.getElementById('linesTbody');
        const btnAddLine = document.getElementById('btnAddLine');
        const totalQtyDisplay = document.getElementById('totalQtyDisplay');
        const noLinesWarning = document.getElementById('noLinesWarning');
        const reqDateInput = document.getElementById('RequestedDateInput');

        let currentProducts = [];
        try {
            const rawJson = document.getElementById('initialProductsJson').textContent;
            currentProducts = JSON.parse(rawJson) || [];
        } catch (e) {
            currentProducts = [];
        }

        // Đổi kho xuất -> Gọi AJAX tải lại tồn khả dụng
        if (warehouseSelect) {
            warehouseSelect.addEventListener('change', async function () {
                const whId = this.value;
                if (!whId) {
                    currentProducts = [];
                    refreshAllProductDropdowns();
                    return;
                }

                try {
                    const response = await fetch(`/SalesOrder/GetAvailableProducts?warehouseId=${whId}`);
                    if (response.ok) {
                        currentProducts = await response.json();
                        refreshAllProductDropdowns();
                    }
                } catch (err) {
                    console.error('Lỗi khi tải tồn kho sản phẩm:', err);
                }
            });
        }

        function refreshAllProductDropdowns() {
            const selects = linesTbody.querySelectorAll('.product-select');
            selects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = '<option value="">-- Chọn sản phẩm --</option>';
                currentProducts.forEach(p => {
                    const id = p.productId ?? p.ProductId;
                    const code = p.productCode ?? p.ProductCode ?? '';
                    const name = p.productName ?? p.ProductName ?? '';
                    const unit = p.unit ?? p.Unit ?? '—';
                    const unreserved = p.unreservedQuantity ?? p.UnreservedQuantity ?? 0;

                    const opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = `[${code}] ${name}`;
                    opt.dataset.unit = unit;
                    opt.dataset.code = code;
                    opt.dataset.unreserved = unreserved;
                    if (id == currentVal) {
                        opt.selected = true;
                    }
                    select.appendChild(opt);
                });
                updateLineDetails(select);
            });
            recalcTotal();
        }

        function updateLineDetails(select) {
            const row = select.closest('tr');
            const unitLabel = row.querySelector('.unit-label');
            const stockBadge = row.querySelector('.stock-badge');
            const selectedOpt = select.options[select.selectedIndex];

            if (selectedOpt && selectedOpt.value) {
                const unit = selectedOpt.dataset.unit || '—';
                const unreserved = parseInt(selectedOpt.dataset.unreserved) || 0;
                unitLabel.textContent = unit;
                if (unreserved > 0) {
                    stockBadge.className = 'stock-badge badge-stock-ok';
                    stockBadge.innerHTML = `Khả dụng: <strong>${unreserved}</strong>`;
                } else {
                    stockBadge.className = 'stock-badge badge-stock-zero';
                    stockBadge.innerHTML = `Khả dụng: <strong>0</strong> (Thiếu nguồn)`;
                }
            } else {
                unitLabel.textContent = '—';
                stockBadge.className = 'stock-badge';
                stockBadge.innerHTML = 'Khả dụng: <strong>—</strong>';
            }
        }

        function recalcTotal() {
            let total = 0;
            const rows = linesTbody.querySelectorAll('tr');
            rows.forEach((row, idx) => {
                row.querySelector('.row-num').textContent = (idx + 1);

                const solineHidden = row.querySelector('input[type="hidden"]');
                if (solineHidden) solineHidden.name = `Lines[${idx}].SolineId`;

                const prodSelect = row.querySelector('.product-select');
                if (prodSelect) prodSelect.name = `Lines[${idx}].ProductId`;

                const qtyInput = row.querySelector('.qty-input');
                if (qtyInput) {
                    qtyInput.name = `Lines[${idx}].RequestedQuantity`;
                    const val = parseInt(qtyInput.value) || 0;
                    total += val;
                }
            });

            totalQtyDisplay.textContent = total;
            if (rows.length === 0) {
                noLinesWarning.style.display = 'block';
            } else {
                noLinesWarning.style.display = 'none';
            }
        }

        // Thêm dòng mới
        btnAddLine.addEventListener('click', function () {
            if (!warehouseSelect.value) {
                alert('Vui lòng chọn Kho xuất hàng trước khi thêm sản phẩm.');
                warehouseSelect.focus();
                return;
            }

            if (currentProducts.length === 0) {
                alert('Không có sản phẩm nào trong hệ thống hoặc kho hàng này.');
                return;
            }

            const newRow = document.createElement('tr');
            let optionsHtml = '<option value="">-- Chọn sản phẩm --</option>';
            currentProducts.forEach(p => {
                const id = p.productId ?? p.ProductId;
                const code = p.productCode ?? p.ProductCode ?? '';
                const name = p.productName ?? p.ProductName ?? '';
                const unit = p.unit ?? p.Unit ?? '—';
                const unreserved = p.unreservedQuantity ?? p.UnreservedQuantity ?? 0;
                optionsHtml += `<option value="${id}" data-unit="${unit}" data-code="${code}" data-unreserved="${unreserved}">[${code}] ${name}</option>`;
            });

            newRow.innerHTML = `
                <td class="row-num text-muted fw-semibold"></td>
                <td>
                    <input type="hidden" value="0" />
                    <select class="form-select product-select" required>
                        ${optionsHtml}
                    </select>
                </td>
                <td>
                    <span class="unit-label text-muted">—</span>
                </td>
                <td>
                    <span class="stock-badge">Khả dụng: <strong>—</strong></span>
                </td>
                <td>
                    <input type="number" class="form-control qty-input text-end" min="1" max="1000000" value="1" required />
                </td>
                <td style="text-align: center;">
                    <button type="button" class="btn-remove-line sales-danger-icon" title="Xóa dòng">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                    </button>
                </td>
            `;

            linesTbody.appendChild(newRow);
            recalcTotal();
        });

        // Xóa dòng
        linesTbody.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-remove-line');
            if (btn) {
                const row = btn.closest('tr');
                row.remove();
                recalcTotal();
            }
        });

        // Chọn sản phẩm -> kiểm tra trùng lặp
        linesTbody.addEventListener('change', function (e) {
            if (e.target.classList.contains('product-select')) {
                updateLineDetails(e.target);

                const selectedVal = e.target.value;
                if (selectedVal) {
                    let count = 0;
                    linesTbody.querySelectorAll('.product-select').forEach(s => {
                        if (s.value === selectedVal) count++;
                    });
                    if (count > 1) {
                        alert('Sản phẩm này đã có trong đơn hàng. Vui lòng cộng dồn số lượng vào dòng đã có thay vì chọn trùng.');
                        e.target.value = '';
                        updateLineDetails(e.target);
                    }
                }
            }
        });

        // Thay đổi số lượng
        linesTbody.addEventListener('input', function (e) {
            if (e.target.classList.contains('qty-input')) {
                recalcTotal();
            }
        });

        // Cập nhật chi tiết ban đầu cho các dòng đã có
        linesTbody.querySelectorAll('.product-select').forEach(select => {
            updateLineDetails(select);
        });
        recalcTotal();

        // Xử lý tạo nhanh khách hàng
        const quickModalEl = document.getElementById('quickCreateCustomerModal');
        const customerSelect = document.getElementById('CustomerSelect');
        const btnSaveQuickCustomer = document.getElementById('btnSaveQuickCustomer');
        const qcAlert = document.getElementById('quickCustomerAlert');
        const qcNameInput = document.getElementById('qcCustomerName');
        const qcNicknameInput = document.getElementById('qcNickname');
        const qcPhoneInput = document.getElementById('qcPhone');
        const qcAddressInput = document.getElementById('qcAddress');
        const qcNameError = document.getElementById('qcNameError');
        const qcPhoneError = document.getElementById('qcPhoneError');
        const qcAddressError = document.getElementById('qcAddressError');
        const qcSpinner = document.getElementById('qcSpinner');
        const qcIcon = document.getElementById('qcIcon');
        const quickCustomerSuccessAlert = document.getElementById('quickCustomerSuccessAlert');

        let quickModalInstance = null;
        if (quickModalEl) {
            quickModalInstance = new bootstrap.Modal(quickModalEl);

            quickModalEl.addEventListener('show.bs.modal', function () {
                qcAlert.classList.add('d-none');
                qcAlert.textContent = '';
                qcNameError.classList.add('d-none');
                qcPhoneError.classList.add('d-none');
                qcAddressError.classList.add('d-none');
                qcNameInput.classList.remove('is-invalid');
                qcPhoneInput.classList.remove('is-invalid');
                qcAddressInput.classList.remove('is-invalid');
            });
        }

        if (btnSaveQuickCustomer) {
            btnSaveQuickCustomer.addEventListener('click', async function () {
                let hasError = false;
                qcAlert.classList.add('d-none');
                qcAlert.textContent = '';

                const name = qcNameInput.value.trim();
                const nickname = qcNicknameInput ? qcNicknameInput.value.trim() : '';
                const phone = qcPhoneInput.value.trim();
                const address = qcAddressInput.value.trim();

                if (!name) {
                    qcNameError.classList.remove('d-none');
                    qcNameInput.classList.add('is-invalid');
                    hasError = true;
                } else {
                    qcNameError.classList.add('d-none');
                    qcNameInput.classList.remove('is-invalid');
                }

                const phonePattern = /^0[0-9]{9}$/;
                if (!phone || !phonePattern.test(phone)) {
                    qcPhoneError.textContent = 'Số điện thoại phải gồm 10 chữ số và bắt đầu bằng số 0.';
                    qcPhoneError.classList.remove('d-none');
                    qcPhoneInput.classList.add('is-invalid');
                    hasError = true;
                } else {
                    qcPhoneError.classList.add('d-none');
                    qcPhoneInput.classList.remove('is-invalid');
                }

                if (!address) {
                    qcAddressError.classList.remove('d-none');
                    qcAddressInput.classList.add('is-invalid');
                    hasError = true;
                } else {
                    qcAddressError.classList.add('d-none');
                    qcAddressInput.classList.remove('is-invalid');
                }

                if (hasError) return;

                btnSaveQuickCustomer.disabled = true;
                qcSpinner.classList.remove('d-none');
                qcIcon.classList.add('d-none');

                try {
                    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    const formData = new FormData();
                    formData.append('CustomerName', name);
                    formData.append('Nickname', nickname);
                    formData.append('Phone', phone);
                    formData.append('Address', address);
                    if (tokenEl) {
                        formData.append('__RequestVerificationToken', tokenEl.value);
                    }

                    const response = await fetch('/SalesOrder/QuickCreateCustomer', {
                        method: 'POST',
                        body: formData
                    });

                    const res = await response.json();
                    if (res.success) {
                        const newOpt = new Option(res.displayText, res.customerId, true, true);
                        customerSelect.appendChild(newOpt);
                        customerSelect.value = res.customerId;

                        quickModalInstance.hide();

                        qcNameInput.value = '';
                        if (qcNicknameInput) qcNicknameInput.value = '';
                        qcPhoneInput.value = '';
                        qcAddressInput.value = '';

                        if (quickCustomerSuccessAlert) {
                            quickCustomerSuccessAlert.textContent = `✓ Đã tạo và chọn khách hàng: ${res.displayText}`;
                            quickCustomerSuccessAlert.classList.remove('d-none');
                            setTimeout(() => {
                                quickCustomerSuccessAlert.classList.add('d-none');
                            }, 5000);
                        }
                    } else {
                        qcAlert.textContent = res.message || 'Không thể tạo khách hàng.';
                        qcAlert.classList.remove('d-none');
                        if (res.message && res.message.toLowerCase().includes('điện thoại')) {
                            qcPhoneInput.classList.add('is-invalid');
                            qcPhoneError.textContent = res.message;
                            qcPhoneError.classList.remove('d-none');
                        }
                    }
                } catch (err) {
                    qcAlert.textContent = 'Có lỗi xảy ra trong quá trình lưu. Vui lòng thử lại.';
                    qcAlert.classList.remove('d-none');
                } finally {
                    btnSaveQuickCustomer.disabled = false;
                    qcSpinner.classList.add('d-none');
                    qcIcon.classList.remove('d-none');
                }
            });
        }

        // Kiểm tra trước khi submit form
        const form = document.getElementById('salesOrderForm');
        if (form) {
            form.addEventListener('submit', function (e) {
                const submitter = e.submitter;
                const action = submitter ? submitter.value : '';

                const rows = linesTbody.querySelectorAll('tr');
                if (rows.length === 0) {
                    e.preventDefault();
                    alert('Đơn bán hàng phải có ít nhất một dòng sản phẩm. Vui lòng bấm "Thêm sản phẩm" trước khi lưu.');
                    return false;
                }

                if (action === 'submit') {
                    if (!reqDateInput || !reqDateInput.value) {
                        e.preventDefault();
                        alert('Vui lòng chọn Ngày yêu cầu xuất hàng khi gửi đơn.');
                        if (reqDateInput) reqDateInput.focus();
                        return false;
                    }
                }
            });
        }
    });
</script>

<!-- MODAL TẠO NHANH KHÁCH HÀNG -->
<div class="modal fade" id="quickCreateCustomerModal" tabindex="-1" aria-labelledby="quickCreateCustomerLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="quickCreateCustomerLabel">
                    <i class="bi bi-person-plus-fill text-primary me-2"></i>Tạo nhanh khách hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div id="quickCustomerAlert" class="alert alert-danger d-none" role="alert"></div>

                <div class="mb-3">
                    <label for="qcCustomerName" class="form-label fw-semibold">Tên khách hàng <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="qcCustomerName" maxlength="200" />
                    <div class="text-danger small mt-1 d-none" id="qcNameError">Vui lòng nhập tên khách hàng.</div>
                </div>

                <div class="mb-3">
                    <label for="qcNickname" class="form-label fw-semibold">Tên gợi nhớ</label>
                    <input type="text" class="form-control" id="qcNickname" maxlength="50" />
                </div>

                <div class="mb-3">
                    <label for="qcPhone" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="qcPhone" maxlength="10" />
                    <div class="text-danger small mt-1 d-none" id="qcPhoneError">Số điện thoại phải gồm 10 chữ số và bắt đầu bằng số 0.</div>
                </div>

                <div class="mb-3">
                    <label for="qcAddress" class="form-label fw-semibold">Địa chỉ <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="qcAddress" rows="2" maxlength="500"></textarea>
                    <div class="text-danger small mt-1 d-none" id="qcAddressError">Vui lòng nhập địa chỉ khách hàng.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveQuickCustomer">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="qcSpinner" role="status" aria-hidden="true"></span>
                    <i class="bi bi-check2-circle me-1" id="qcIcon"></i>Lưu khách hàng
                </button>
            </div>
        </div>
    </div>
</div>
