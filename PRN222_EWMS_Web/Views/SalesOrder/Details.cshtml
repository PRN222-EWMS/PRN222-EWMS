@model PRN222_EWMS_Web.ViewModels.Sales.SalesOrderDetailsViewModel
@using PRN222_EWMS_Web.ViewModels.Sales
@{ ViewData["Title"] = "Chi tiết " + Model.Code; }
<div class="sales-page">
<div class="workspace-heading"><div><p class="eyebrow">BÁN HÀNG / CHI TIẾT ĐƠN</p><h1>@Model.Code</h1><span class="sales-status">@SalesDisplay.Status(Model.Status)</span></div><div class="sales-toolbar">
    <a class="workspace-button sales-button-secondary" asp-action="Index">← Danh sách đơn bán hàng</a>
    @if (Model.CanEdit)
    {
        <a class="workspace-button" href="@Url.Content($"~/SalesOrder/Edit/{Model.Id}")">Sửa</a>
    }
</div></div>
@if(Model.HasShortage){<div class="sales-warning" role="status">Đơn hàng đang có thiếu nguồn đáp ứng. Cần kiểm tra phần nhu cầu còn lại.</div>}
@if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.CreatedByUserId.ToString())
{
    <p class="sales-muted-small mb-0">Bạn đang xem đơn của Sales khác. Chỉ người tạo đơn được phép chỉnh sửa khi đơn còn đủ điều kiện.</p>
}
else if (!Model.CanEdit)
{
    <p class="sales-muted-small mb-0">Đơn của bạn hiện không còn đủ điều kiện chỉnh sửa. Đơn đã có phiếu xuất được lưu sẽ khóa sửa thông tin đơn.</p>
}
<section class="workspace-card"><h2>Thông tin đơn hàng</h2><dl class="sales-details"><div><dt>Khách hàng</dt><dd>@Model.CustomerName</dd></div><div><dt>Điện thoại</dt><dd>@(Model.CustomerPhone ?? "—")</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.CustomerAddress ?? "—")</dd></div><div><dt>Kho xuất</dt><dd>@Model.WarehouseName</dd></div><div><dt>Người tạo</dt><dd>@Model.CreatedByName</dd></div><div><dt>Ngày đơn</dt><dd>@Model.OrderDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Ngày yêu cầu xuất</dt><dd>@(Model.RequestedDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div><div><dt>Thời điểm gửi (UTC)</dt><dd>@(Model.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div><div><dt>Thời điểm đóng (UTC)</dt><dd>@(Model.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div></dl>
@if(!string.IsNullOrWhiteSpace(Model.Note)){<h3 class="h6 mt-4">Ghi chú</h3><p class="sales-note">@Model.Note</p>}
@if(!string.IsNullOrWhiteSpace(Model.CloseReason)){<h3 class="h6 mt-4">Lý do đóng</h3><p class="sales-note">@Model.CloseReason</p>}
</section>
<section class="workspace-card"><h2>Sản phẩm yêu cầu</h2><p class="muted">Đã xuất chỉ tính các serial hợp lệ thuộc phiếu xuất hoàn tất.</p><div class="table-wrap"><table class="workspace-table"><thead><tr><th>Mã sản phẩm</th><th>Sản phẩm</th><th>Yêu cầu</th><th>Đã xuất</th><th>Đã hủy/đóng</th><th>Còn phải xuất</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.ProductCode</td><td>@line.ProductName</td><td>@line.RequestedQuantity</td><td>@line.IssuedQuantity</td><td>@line.CancelledQuantity</td><td><strong>@line.RemainingQuantity</strong></td></tr>}</tbody></table></div>@if(Model.Lines.Count == 0){<p class="sales-empty">Đơn chưa có sản phẩm.</p>}</section>
<section class="workspace-card"><h2>Các đợt xuất hàng</h2><div class="table-wrap"><table class="workspace-table"><thead><tr><th>Mã phiếu</th><th>Ngày xuất</th><th>Trạng thái</th><th>Số serial trên phiếu</th><th>Hoàn tất (UTC)</th></tr></thead><tbody>@foreach(var receipt in Model.Outbounds){<tr><td>@receipt.Code</td><td>@receipt.IssueDate.ToString("dd/MM/yyyy")</td><td><span class="sales-status">@SalesDisplay.Status(receipt.Status)</span></td><td>@receipt.Quantity</td><td>@(receipt.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td></tr>}</tbody></table></div>@if(Model.Outbounds.Count == 0){<p class="sales-empty">Chưa có phiếu xuất cho đơn này.</p>}</section>
</div>
