@model PRN222_EWMS_Web.ViewModels.Sales.SalesOrderDetailsViewModel
@using PRN222_EWMS_Web.ViewModels.Sales
@{ ViewData["Title"] = "Chi tiết " + Model.Code; }

<div class="sales-page order-workspace">
<div class="workspace-heading">
    <div>
        <p class="eyebrow">BÁN HÀNG / CHI TIẾT ĐƠN</p>
        <h1>@Model.Code</h1>
        <div class="d-flex align-items-center gap-2 mt-2">
            <span class="sales-status" data-status="@Model.Status">@SalesDisplay.Status(Model.Status)</span>
            @if (Model.HasShortage)
            {
                <span class="stock-badge badge-stock-zero">Thiếu nguồn</span>
            }
        </div>
    </div>
    <div class="sales-toolbar">
        @if (Model.CanReplaceSources)
        {
            <a class="workspace-button" asp-action="ReplaceSources" asp-route-id="@Model.Id">Bổ sung nguồn</a>
        }
        @if (Model.CanEdit && User.IsInRole("SALES_STAFF"))
        {
            <a class="workspace-button" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa đơn
            </a>
        }
        <a class="workspace-button sales-button-secondary" asp-action="Index">← Danh sách đơn bán hàng</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="sales-alert sales-alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="sales-warning" role="alert">@TempData["Error"]</div>
}

@if (Model.HasShortage)
{
    <div class="sales-warning" role="status">
        <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i> Chưa đủ nguồn cho phần còn phải xuất.
    </div>
}

@if (User.IsInRole("SALES_STAFF") && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.CreatedByUserId.ToString()
    && Model.Status is "SUBMITTED" or "PARTIALLY_FULFILLED")
{
    <p class="order-state-note"><i class="bi bi-lock" aria-hidden="true"></i> Đơn đã gửi, nội dung đã khóa.</p>
}

<section class="workspace-card">
    <h2>Thông tin đơn hàng</h2>
    <dl class="sales-details">
        <div><dt>Khách hàng</dt><dd class="fw-semibold">@Model.CustomerName</dd></div>
        <div><dt>Điện thoại</dt><dd>@(Model.CustomerPhone ?? "—")</dd></div>
        <div><dt>Địa chỉ</dt><dd>@(Model.CustomerAddress ?? "—")</dd></div>
        <div><dt>Kho xuất</dt><dd>@Model.WarehouseName</dd></div>
        <div><dt>Người tạo</dt><dd>@Model.CreatedByName</dd></div>
        <div><dt>Ngày đơn</dt><dd>@Model.OrderDate.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>Ngày yêu cầu xuất</dt><dd>@(Model.RequestedDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
        <div><dt>Thời điểm gửi (UTC)</dt><dd>@(Model.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
        <div><dt>Thời điểm đóng (UTC)</dt><dd>@(Model.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
    </dl>
    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <h3 class="h6 mt-4">Ghi chú</h3>
        <p class="sales-note">@Model.Note</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CloseReason))
    {
        <h3 class="h6 mt-4">Lý do đóng</h3>
        <p class="sales-note">@Model.CloseReason</p>
    }
</section>

<section class="workspace-card">
    <div class="order-section-title"><h2>Sản phẩm</h2><span class="order-count">@Model.Lines.Count sản phẩm</span></div>
    <div class="table-wrap">
        <table class="workspace-table">
            <thead>
                <tr>
                    <th>Mã sản phẩm</th>
                    <th>Sản phẩm</th>
                    <th style="text-align: right;">Yêu cầu</th>
                    <th style="text-align: right;">Đã xuất</th>
                    <th style="text-align: right;">Đã hủy/đóng</th>
                    <th style="text-align: right;">Còn phải xuất</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td><code>@line.ProductCode</code></td>
                        <td>@line.ProductName
                            @if (Model.Status is "SUBMITTED" or "PARTIALLY_FULFILLED" && line.Sources.Count > 0)
                            {
                                var missing = Math.Max(0, line.RemainingQuantity - line.Sources.Sum(s => s.HeldQuantity));
                                @if (missing > 0)
                                {
                                    <small class="d-block text-danger">Thiếu nguồn: @missing</small>
                                }
                            }
                        </td>
                        <td style="text-align: right;">@line.RequestedQuantity</td>
                        <td style="text-align: right;">@line.IssuedQuantity</td>
                        <td style="text-align: right;">@line.CancelledQuantity</td>
                        <td style="text-align: right;"><strong>@line.RemainingQuantity</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Lines.Count == 0)
    {
        <p class="sales-empty">Đơn chưa có sản phẩm.</p>
    }
    @foreach (var line in Model.Lines.Where(l => l.Sources.Count > 0))
    {
        <details class="order-source-history" open="@Model.HasShortage">
            <summary>@line.ProductCode · Nguồn hàng</summary>
            <div class="table-wrap">
                <table class="workspace-table">
                    <thead><tr><th>Nguồn</th><th class="text-end">Chọn ban đầu</th><th class="text-end">Đang giữ</th><th class="text-end">Đã xuất</th><th class="text-end">Đã chuyển / giải phóng</th></tr></thead>
                    <tbody>
                        @foreach (var source in line.Sources)
                        {
                            <tr>
                                <td>@source.Label</td>
                                <td class="text-end">@source.OriginalQuantity</td>
                                <td class="text-end"><strong>@source.HeldQuantity</strong></td>
                                <td class="text-end">@source.ConsumedQuantity</td>
                                <td class="text-end">@source.ReleasedQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</section>

@if (Model.CanCancel)
{
    <section class="workspace-card">
        <h2 class="mb-3">Hủy đơn hàng</h2>
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="flex-grow-1"><label class="form-label" for="cancelReason">Lý do hủy đơn</label><input class="form-control" id="cancelReason" name="reason" maxlength="1000" /></div>
            <button type="submit" class="workspace-button sales-button-danger">Hủy đơn hàng</button>
        </form>
    </section>
}

<section class="workspace-card">
    <div class="sales-section-heading">
        <h2>Phiếu xuất kho</h2>
        @if (User.IsInRole("WAREHOUSE_STAFF")
            && (Model.Status == "SUBMITTED" || Model.Status == "PARTIALLY_FULFILLED")
            && Model.Lines.Any(line => line.RemainingQuantity > 0))
        {
            <a class="workspace-button" href="@Url.Content($"~/Outbound/Create?salesOrderId={Model.Id}")">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Tạo phiếu xuất
            </a>
        }
    </div>
    <div class="table-wrap">
        <table class="workspace-table">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Ngày xuất</th>
                    <th>Trạng thái</th>
                    <th>Số serial trên phiếu</th>
                    <th>Hoàn tất (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var receipt in Model.Outbounds)
                {
                    <tr>
                        <td><code>@receipt.Code</code></td>
                        <td>@receipt.IssueDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="sales-status" data-status="@receipt.Status">@SalesDisplay.Status(receipt.Status)</span></td>
                        <td>@receipt.Quantity</td>
                        <td>@(receipt.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Outbounds.Count == 0)
    {
        <p class="sales-empty">Chưa có phiếu xuất cho đơn này.</p>
    }
</section>
</div>
