@model PRN222_EWMS_Web.ViewModels.Manager.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Manager";

    string StatusText(string status) => status switch
    {
        "DRAFT" => "Bản nháp",
        "CONFIRMED" => "Đã xác nhận",
        "PARTIALLY_RECEIVED" => "Đã nhận một phần",
        "RECEIVED" => "Đã nhận đủ",
        "SUBMITTED" => "Đã gửi",
        "PARTIALLY_FULFILLED" => "Đã đáp ứng một phần",
        "FULFILLED" => "Đã đáp ứng đủ",
        "CLOSED" => "Đã đóng",
        "CANCELLED" => "Đã hủy",
        "READY" => "Sẵn sàng",
        "PICKING" => "Đang lấy hàng",
        "DONE" => "Hoàn tất",
        _ => status
    };

    string PercentText(decimal? used, decimal? capacity)
    {
        if (!used.HasValue || !capacity.HasValue || capacity.Value <= 0)
            return "Chưa có dữ liệu";

        return (used.Value / capacity.Value * 100).ToString("0.#") + "%";
    }

    string Measure(decimal? value)
        => value.HasValue ? value.Value.ToString("0.###") : "—";
}

<div class="d-flex justify-content-between align-items-center
    flex-wrap gap-2 mb-4">
    <div>
        <h2 class="mb-1">Tổng quan quản lý kho</h2>
        <p class="text-muted mb-0">
            Theo dõi nghiệp vụ và sức chứa tại các kho.
        </p>
    </div>

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-outline-primary">
        Danh sách sản phẩm
    </a>
</div>

<form asp-action="Dashboard" method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <label asp-for="WarehouseId" class="form-label">Kho</label>
        <select asp-for="WarehouseId"
                asp-items="Model.Warehouses"
                class="form-select">
            <option value="">Tất cả kho</option>
        </select>
    </div>

    <div class="col-md-auto align-self-end">
        <button type="submit" class="btn btn-primary">
            Xem dữ liệu
        </button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Phiếu nhập nháp</div>
                <div class="fs-2 fw-bold">@Model.PendingInboundCount</div>
                <small>Chưa hoàn tất nhập kho</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Phiếu xuất chưa hoàn tất</div>
                <div class="fs-2 fw-bold">@Model.PendingOutboundCount</div>
                <small>Nháp, sẵn sàng hoặc đang lấy hàng</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Đơn mua chờ nhận đủ</div>
                <div class="fs-2 fw-bold">@Model.OpenPurchaseOrderCount</div>
                <small>Đã xác nhận hoặc đã nhận một phần</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Kiểm kê đang xử lý</div>
                <div class="fs-2 fw-bold">@Model.ActiveStocktakeCount</div>
                <small>Kiểm đếm, kiểm lại, rà soát hoặc chờ duyệt</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Trạng thái đơn mua</div>
            <div class="card-body">
                @if (Model.PurchaseStatuses.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có đơn mua.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Trạng thái</th>
                                <th class="text-end">Số đơn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PurchaseStatuses)
                            {
                                <tr>
                                    <td>@StatusText(item.Status)</td>
                                    <td class="text-end">@item.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Trạng thái đơn bán</div>
            <div class="card-body">
                @if (Model.SalesStatuses.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có đơn bán.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Trạng thái</th>
                                <th class="text-end">Số đơn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SalesStatuses)
                            {
                                <tr>
                                    <td>@StatusText(item.Status)</td>
                                    <td class="text-end">@item.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">10 phiếu nhập/xuất được tạo gần nhất</div>
    <div class="card-body">
        @if (Model.RecentReceipts.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có phiếu nhập/xuất.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Loại</th>
                            <th>Mã phiếu</th>
                            <th>Kho</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentReceipts)
                        {
                            <tr>
                                <td>@item.Type</td>
                                <td>@item.Code</td>
                                <td>@item.WarehouseName</td>
                                <td>@StatusText(item.Status)</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">Tổng quan sức chứa các kho</div>
    <div class="card-body">
        <p class="text-muted">
            Ô nền tính theo m², tầng kệ theo m³. Gần đầy khi đạt từ 80% sức chứa
            hoặc tải trọng; vị trí đã quá tải được đếm riêng.
        </p>

        @if (Model.WarehouseCapacities.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có kho để hiển thị.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <caption class="visually-hidden">Sức chứa tổng hợp theo kho</caption>
                    <thead>
                        <tr>
                            <th scope="col">Kho</th>
                            <th scope="col">Diện tích ô nền</th>
                            <th scope="col">Thể tích tầng kệ</th>
                            <th scope="col">Vị trí gần đầy</th>
                            <th scope="col">Vị trí quá tải</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in Model.WarehouseCapacities)
                        {
                            <tr>
                                <th scope="row">
                                    @warehouse.WarehouseName
                                    <div class="small text-muted fw-normal">
                                        @warehouse.LocationCount vị trí lưu trữ
                                    </div>
                                    @if (warehouse.MissingCapacityLocationCount > 0)
                                    {
                                        <div class="small text-danger fw-normal">
                                            @warehouse.MissingCapacityLocationCount vị trí thiếu dữ liệu sức chứa;
                                            số tổng hợp có thể chưa đầy đủ.
                                        </div>
                                    }
                                </th>
                                <td>
                                    @if (warehouse.TotalAreaM2 > 0)
                                    {
                                        <div>@Measure(warehouse.UsedAreaM2) / @Measure(warehouse.TotalAreaM2) m²</div>
                                        <small class="text-muted">@PercentText(warehouse.UsedAreaM2, warehouse.TotalAreaM2)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có sức chứa ô nền</span>
                                    }
                                </td>
                                <td>
                                    @if (warehouse.TotalVolumeM3 > 0)
                                    {
                                        <div>@Measure(warehouse.UsedVolumeM3) / @Measure(warehouse.TotalVolumeM3) m³</div>
                                        <small class="text-muted">@PercentText(warehouse.UsedVolumeM3, warehouse.TotalVolumeM3)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có sức chứa tầng kệ</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(warehouse.NearFullLocationCount > 0 ? "bg-warning text-dark" : "bg-secondary")">
                                        @warehouse.NearFullLocationCount
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(warehouse.OverloadedLocationCount > 0 ? "bg-danger" : "bg-success")">
                                        @warehouse.OverloadedLocationCount
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @foreach (var warehouse in Model.WarehouseCapacities)
            {
                var locations = Model.Capacities
                    .Where(c => c.WarehouseId == warehouse.WarehouseId).ToList();

                <details class="border rounded p-3 mt-3">
                    <summary>Xem chi tiết — @warehouse.WarehouseName</summary>
                    @if (locations.Count == 0)
                    {
                        <p class="text-muted mt-3 mb-0">Kho chưa có vị trí lưu trữ.</p>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm align-middle mb-0">
                                <caption class="visually-hidden">Chi tiết vị trí tại @warehouse.WarehouseName</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">ID vị trí</th>
                                        <th scope="col">Tên vị trí</th>
                                        <th scope="col">Loại</th>
                                        <th scope="col">Đã dùng / sức chứa</th>
                                        <th scope="col">Tỷ lệ</th>
                                        <th scope="col">Tải trọng</th>
                                        <th scope="col">Số serial</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in locations)
                                    {
                                        bool isFloor = item.CapacityMode == "FLOOR_AREA";
                                        decimal? used = isFloor ? item.UsedAreaM2 : item.UsedVolumeM3;
                                        decimal? total = isFloor ? item.CapacityAreaM2 : item.CapacityVolumeM3;
                                        string unit = isFloor ? "m²" : "m³";
                                        bool overloaded =
                                            (used.HasValue && total.HasValue && used.Value > total.Value) ||
                                            (item.MaxWeightKg.HasValue && item.UsedWeightKg > item.MaxWeightKg.Value);

                                        <tr class="@(overloaded ? "table-danger" : "")">
                                            <td>@item.LocationId</td>
                                            <th scope="row">@item.LocationName</th>
                                            <td>@(isFloor ? "Ô nền" : "Tầng kệ")</td>
                                            <td>@Measure(used) / @Measure(total) @unit</td>
                                            <td>
                                                @PercentText(used, total)
                                                @if (overloaded)
                                                {
                                                    <span class="badge bg-danger">Quá tải</span>
                                                }
                                            </td>
                                            <td>@Measure(item.UsedWeightKg) / @Measure(item.MaxWeightKg) kg</td>
                                            <td>@item.ItemCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>
            }
        }

        <p class="small text-muted mt-3 mb-0">
            Tỷ lệ tổng hợp không bảo đảm từng vị trí còn đủ chỗ.
            Hàng chưa gán vị trí chưa được tính vào sức chứa đã dùng.
            Dấu — nghĩa là chưa có dữ liệu; vị trí chưa khai báo giới hạn tải trọng
            chưa được kiểm tra quá tải theo kg.
        </p>
    </div>
</div>
