@model PRN222_EWMS_Web.ViewModels.Ceo.CeoPurchaseOrderDetailViewModel
@{ ViewData["Title"] = "Chi tiết tiến độ đơn mua"; }

<div class="ceo-po-page"><a asp-action="Index" class="ceo-po-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Tiến độ đơn mua</a><header class="ceo-po-header"><div><p class="ceo-po-kicker">CHI TIẾT TIẾN ĐỘ</p><h1>@Model.Code</h1><p>@Model.Supplier · @Model.Warehouse</p></div><span class="ceo-po-readonly"><i class="bi bi-eye" aria-hidden="true"></i> Chỉ xem</span></header>
    <div class="ceo-po-detail-meta"><div><span>Trạng thái</span><strong>@Model.Status</strong></div><div><span>Ngày đặt</span><strong>@Model.OrderDate.ToString("dd/MM/yyyy")</strong></div><div><span>Ngày nhận dự kiến</span><strong>@Model.ExpectedArrivalDate.ToString("dd/MM/yyyy")</strong></div></div>
    <div class="ceo-po-stats"><div><span>Đã đặt</span><strong>@Model.Ordered.ToString("N0")</strong></div><div><span>Đã nhận</span><strong>@Model.Received.ToString("N0")</strong></div><div><span>Còn chờ nhận</span><strong>@Model.Outstanding.ToString("N0")</strong></div><div><span>Đã đóng</span><strong>@Model.Closed.ToString("N0")</strong></div></div>
    <div class="ceo-po-summary-heading"><h2>Tiến độ theo sản phẩm</h2><span>@Model.Lines.Count sản phẩm</span></div><div class="ceo-po-table-wrap" role="region" aria-label="Tiến độ theo sản phẩm" tabindex="0"><table class="ceo-po-table ceo-po-lines"><thead><tr><th>Sản phẩm</th><th>Đã đặt</th><th>Đã nhận</th><th>Còn chờ</th><th>Đã đóng</th><th>Tiến độ</th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td><strong>@line.ProductCode</strong><small>@line.ProductName</small></td><td>@line.Ordered</td><td>@line.Received</td><td>@line.Outstanding</td><td>@line.Closed</td><td><progress max="@Math.Max(1, line.Ordered)" value="@Math.Min(line.Ordered, line.Received + line.Closed)"></progress><small>@(line.Ordered == 0 ? 0 : (int)Math.Round(100.0 * (line.Received + line.Closed) / line.Ordered))% đã xử lý</small></td></tr> }</tbody></table></div>
    <p class="ceo-po-footnote">Còn chờ nhận = Đã đặt − Đã nhận − Đã đóng. Số đã nhận là lượng đã hoàn tất nhập kho.</p>
</div>
