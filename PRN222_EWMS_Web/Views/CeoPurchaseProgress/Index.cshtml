@model PRN222_EWMS_Web.ViewModels.Ceo.CeoPurchaseProgressViewModel
@{ ViewData["Title"] = "Tiến độ đơn mua"; var filter = Model.Filter; var firstPage = Math.Max(1, Math.Min(filter.Page - 2, Model.TotalPages - 4)); var lastPage = Math.Min(Model.TotalPages, firstPage + 4); }

<div class="ceo-po-page">
    <header class="ceo-po-header"><div><p class="ceo-po-kicker">THEO DÕI MUA HÀNG</p><h1>Tiến độ đơn mua</h1><p>Theo dõi số lượng đã đặt, đã nhận, còn chờ nhận và đã đóng trên từng đơn mua.</p></div><span class="ceo-po-readonly"><i class="bi bi-eye" aria-hidden="true"></i> Chỉ xem</span></header>

    <form asp-action="Index" method="get" class="ceo-po-filter" aria-label="Lọc đơn mua"><label>Mã đơn mua<input name="search" value="@filter.Search" maxlength="100" placeholder="Tìm mã PO..." /></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="DRAFT" selected="@(filter.Status == "DRAFT")">Bản nháp</option><option value="CONFIRMED" selected="@(filter.Status == "CONFIRMED")">Đã xác nhận</option><option value="PARTIALLY_RECEIVED" selected="@(filter.Status == "PARTIALLY_RECEIVED")">Nhận một phần</option><option value="RECEIVED" selected="@(filter.Status == "RECEIVED")">Đã nhận đủ</option><option value="CLOSED" selected="@(filter.Status == "CLOSED")">Đã đóng</option><option value="CANCELLED" selected="@(filter.Status == "CANCELLED")">Đã hủy</option></select></label><label>Kho<select name="warehouseId"><option value="">Tất cả kho</option>@foreach (var warehouse in Model.Warehouses) { <option value="@warehouse.Id" selected="@(filter.WarehouseId == warehouse.Id)">@warehouse.Name</option> }</select></label><label>Nhà cung cấp<select name="supplierId"><option value="">Tất cả nhà cung cấp</option>@foreach (var supplier in Model.Suppliers) { <option value="@supplier.Id" selected="@(filter.SupplierId == supplier.Id)">@supplier.Name</option> }</select></label><button type="submit" class="ceo-po-button">Lọc</button><a asp-action="Index" class="ceo-po-reset">Đặt lại</a></form>

    <div class="ceo-po-summary-heading"><h2>Đơn mua phù hợp</h2><span>@Model.TotalCount đơn · số lượng bên dưới tính trên trang này</span></div>
    <div class="ceo-po-stats"><div><span>Đã đặt</span><strong>@Model.Ordered.ToString("N0")</strong></div><div><span>Đã nhận</span><strong>@Model.Received.ToString("N0")</strong></div><div><span>Còn chờ nhận</span><strong>@Model.Outstanding.ToString("N0")</strong></div><div><span>Đã đóng</span><strong>@Model.Closed.ToString("N0")</strong></div></div>

    <div class="ceo-po-table-wrap" role="region" aria-label="Danh sách tiến độ đơn mua" tabindex="0"><table class="ceo-po-table"><thead><tr><th>Đơn mua / Đối tác</th><th>Trạng thái</th><th>Đã đặt</th><th>Đã nhận</th><th>Còn chờ</th><th>Đã đóng</th><th>Tiến độ</th><th></th></tr></thead><tbody>
        @foreach (var order in Model.Orders)
        {
            <tr><td><a asp-action="Details" asp-route-id="@order.Id" class="ceo-po-code">@order.Code</a><small>@order.Supplier · @order.Warehouse</small><small>Ngày đặt @order.OrderDate.ToString("dd/MM/yyyy") · dự kiến @order.ExpectedArrivalDate.ToString("dd/MM/yyyy")</small></td><td><span class="ceo-po-status">@order.Status</span></td><td>@order.Ordered</td><td>@order.Received</td><td>@order.Outstanding</td><td>@order.Closed</td><td><progress max="@Math.Max(1, order.Ordered)" value="@Math.Min(order.Ordered, order.Received + order.Closed)"></progress><small>@(order.Ordered == 0 ? 0 : (int)Math.Round(100.0 * (order.Received + order.Closed) / order.Ordered))% đã xử lý</small></td><td><a asp-action="Details" asp-route-id="@order.Id" class="ceo-po-detail-link">Chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a></td></tr>
        }
        @if (Model.Orders.Count == 0) { <tr><td colspan="8" class="ceo-po-empty">Không có đơn mua phù hợp với bộ lọc.</td></tr> }
    </tbody></table></div>
    <nav class="ceo-po-pagination" aria-label="Phân trang đơn mua"><span>Trang @filter.Page / @Model.TotalPages</span><div>@if (filter.Page > 1) { <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-warehouseId="@filter.WarehouseId" asp-route-supplierId="@filter.SupplierId" asp-route-page="@(filter.Page - 1)">Trước</a> }@for (var number = firstPage; number <= lastPage; number++) { if (number == filter.Page) { <span aria-current="page">@number</span> } else { <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-warehouseId="@filter.WarehouseId" asp-route-supplierId="@filter.SupplierId" asp-route-page="@number">@number</a> } }@if (filter.Page < Model.TotalPages) { <a asp-action="Index" asp-route-search="@filter.Search" asp-route-status="@filter.Status" asp-route-warehouseId="@filter.WarehouseId" asp-route-supplierId="@filter.SupplierId" asp-route-page="@(filter.Page + 1)">Sau</a> }</div></nav>
</div>
