@model PRN222_EWMS_Web.ViewModels.Outbound.OutboundDetailsViewModel
@{
    ViewData["Title"] = "Phiếu xuất " + Model.IssueCode;
    var done = Model.Status == "DONE";
    var cancelled = Model.Status == "CANCELLED";
    var activeSerials = Model.Serials.Where(serial => serial.IsActive).ToList();
    var removedSerials = Model.Serials.Where(serial => !serial.IsActive).ToList();
    DateTime Local(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Utc).AddHours(7);
    string StatusLabel(string status) => status switch { "DRAFT" => "Nháp", "PICKING" => "Đang lấy hàng", "READY" => "Sẵn sàng, chưa xuất", "DONE" => "Đã xuất kho", "CANCELLED" => "Đã hủy", "SUBMITTED" => "Đã xác nhận", "PARTIALLY_FULFILLED" => "Đã xuất một phần", "FULFILLED" => "Đã xuất đủ", "CLOSED" => "Đã đóng", _ => status };
}
<div class="outbound-page">
    <header class="workspace-heading"><div><p class="eyebrow">CHI TIẾT PHIẾU XUẤT</p><h1>@Model.IssueCode</h1><p class="muted mb-0">@Model.WarehouseName · <span class="outbound-badge outbound-badge-@Model.Status.ToLowerInvariant()">@StatusLabel(Model.Status)</span></p></div><div class="outbound-toolbar"><a asp-action="Index" class="workspace-button sales-button-secondary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Phiếu xuất kho</a>@if (User.IsInRole("WAREHOUSE_STAFF") && Model.CanWork) { <a asp-action="Picking" asp-route-id="@Model.OutboundId" class="workspace-button">Tiếp tục xuất</a> }</div></header>
    <section class="workspace-card"><h2 class="h5 mb-3">Thông tin phiếu</h2><dl class="outbound-info-grid mb-0"><div><dt>Đơn bán hàng</dt><dd>@Model.Socode <small class="d-block muted">@StatusLabel(Model.SoStatus)</small></dd></div><div><dt>Khách hàng</dt><dd>@Model.CustomerName <small class="d-block muted">@(Model.CustomerPhone ?? "—")</small></dd></div><div><dt>Ngày yêu cầu xuất</dt><dd>@(Model.SoRequestedDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</dd></div><div><dt>Người tạo</dt><dd>@Model.CreatedByName <small class="d-block muted">@Local(Model.CreatedAt).ToString("HH:mm dd/MM/yyyy")</small></dd></div><div><dt>Người xuất</dt><dd>@(done ? Model.AssignedToName ?? "—" : "Chưa hoàn tất")</dd></div><div><dt>Đã xuất trên phiếu này</dt><dd class="text-success">@Model.TotalDoneInThisReceipt <small class="d-block muted">@(Model.CompletedAt.HasValue ? Local(Model.CompletedAt.Value).ToString("HH:mm dd/MM/yyyy") : "Chưa ghi nhận xuất kho")</small></dd></div></dl>@if (!string.IsNullOrWhiteSpace(Model.Note)) { <p class="muted text-break mt-3 mb-0">@Model.Note</p> }</section>
    <section><div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h2 class="h5 mb-0">Tiến độ toàn đơn @Model.Socode</h2><span class="muted">Đã xuất @Model.TotalDone · Còn phải xuất @Model.TotalRemaining</span></div><div class="table-wrap workspace-card p-0"><table class="workspace-table"><thead><tr><th>Sản phẩm</th><th>Đặt</th><th>Đã đóng/hủy</th><th>Đã xuất toàn SO</th><th>Còn phải xuất</th><th>Trong phiếu này</th>@if (!done && !cancelled) { <th>Có thể lấy ngay</th><th>Chưa có hàng để xuất</th><th>Hàng dự kiến về</th> }</tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td><strong>@line.ProductCode</strong><small class="d-block muted">@line.ProductName</small></td><td>@line.RequestedQuantity</td><td>@line.CancelledQuantity</td><td class="text-success">@line.DoneQuantity</td><td>@line.RemainingQuantity</td><td>@line.InThisReceiptCount</td>@if (!done && !cancelled) { <td>@line.MaxIssueNow</td><td>@Math.Max(0, line.RemainingQuantity - line.MaxIssueNow)</td><td>@line.IncomingReservedBalance</td> }</tr> }</tbody></table></div></section>
    <section class="workspace-card p-0 overflow-hidden"><div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap"><h2 class="h5 mb-0">@(done ? "Serial đã xuất" : cancelled ? "Serial trong phiếu" : "Serial đang chọn") <span class="outbound-badge outbound-badge-draft">@activeSerials.Count</span></h2>@if (!done && !cancelled) { <span class="outbound-badge outbound-badge-picking">Chưa trừ tồn kho</span> }</div><div class="table-wrap"><table class="workspace-table"><thead><tr><th>Serial</th><th>Sản phẩm</th><th>Nguồn xuất</th><th>Vị trí lấy hàng</th><th>Thời điểm chọn</th></tr></thead><tbody>@foreach (var item in activeSerials) { <tr><td><strong class="font-monospace">@item.SerialNumber</strong></td><td>@item.ProductCode<small class="d-block muted">@item.ProductName</small></td><td>@item.SourceCode</td><td>@(string.IsNullOrWhiteSpace(item.LocationPath) ? "—" : item.LocationPath)</td><td>@Local(item.ScannedAt).ToString("HH:mm dd/MM/yyyy")@if (!done && item.ClaimedByName is not null) { <small class="d-block muted">Người chọn: @item.ClaimedByName</small> }</td></tr> }@if (activeSerials.Count == 0) { <tr><td colspan="5" class="text-center muted py-5">Không có serial đang hiệu lực trong phiếu.</td></tr> }</tbody></table></div>
        @if (removedSerials.Count > 0) { <details class="p-3 border-top"><summary>Serial đã bỏ khỏi phiếu (@removedSerials.Count)</summary><ul class="mt-3 mb-0">@foreach (var item in removedSerials) { <li class="my-2"><strong>@item.SerialNumber</strong> · @item.ProductCode <small class="muted">· Chọn lúc @Local(item.ScannedAt).ToString("HH:mm dd/MM/yyyy")</small></li> }</ul></details> }
    </section>
</div>
