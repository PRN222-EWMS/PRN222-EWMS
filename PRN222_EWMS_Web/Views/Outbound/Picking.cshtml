@model PRN222_EWMS_Web.ViewModels.Outbound.PickingWorkbenchViewModel
@{
    ViewData["Title"] = "Xuất kho " + Model.IssueCode;
    var canAdd = Model.Lines.Any(line => line.CanPickMoreQuantity > 0);
    var invalidSelection = Model.Lines.Any(line => line.InThisReceiptCount > line.MaxIssueNow);
    DateTime Local(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Utc).AddHours(7);
}
<div class="outbound-page">
    <header class="workspace-heading">
        <div><p class="eyebrow">PHIẾU XUẤT KHO</p><h1>@Model.IssueCode</h1><p class="muted mb-0">@Model.Socode · @Model.CustomerName · @Model.WarehouseName</p></div>
        <div class="outbound-toolbar"><a asp-action="Index" class="workspace-button sales-button-secondary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Phiếu xuất kho</a><button type="button" class="workspace-button sales-button-danger" data-bs-toggle="modal" data-bs-target="#cancelPickingModal">Hủy phiếu</button><form asp-action="Complete" method="post" data-outbound-submit-once data-outbound-confirm="Xác nhận xuất @Model.TotalScanned serial trên phiếu @Model.IssueCode? Tồn kho sẽ giảm ngay."><input type="hidden" name="outboundId" value="@Model.OutboundId" /><input type="hidden" name="version" value="@Model.Version" /><button type="submit" class="workspace-button" disabled="@(Model.TotalScanned == 0 || invalidSelection)"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>Hoàn tất xuất kho</button></form></div>
    </header>
    @if (invalidSelection) { <div class="outbound-notice outbound-notice-warning" role="alert">Hạn mức đã thay đổi. Kiểm tra lại các serial đã chọn trước khi xuất.</div> }
    <section class="outbound-progress-section" aria-label="Hạn mức theo sản phẩm"><div class="row g-3">
        @foreach (var line in Model.Lines)
        {
            <div class="col-md-6 col-xl-4"><article class="workspace-card p-3 h-100"><h2 class="h6 mb-1">@line.ProductCode</h2><p class="muted mb-3">@line.ProductName</p><dl class="row row-cols-2 g-3 mb-0"><div class="col"><dt class="small muted fw-normal">Còn phải xuất</dt><dd class="mb-0 fw-semibold">@line.RemainingQuantity</dd></div><div class="col"><dt class="small muted fw-normal">Có thể lấy ngay</dt><dd class="mb-0 fw-semibold text-primary">@line.MaxIssueNow</dd></div><div class="col"><dt class="small muted fw-normal">Đã chọn phiếu này</dt><dd class="mb-0 fw-semibold">@line.InThisReceiptCount</dd></div><div class="col"><dt class="small muted fw-normal">Còn chọn thêm</dt><dd class="mb-0 fw-semibold text-primary">@line.CanPickMoreQuantity</dd></div><div class="col"><dt class="small muted fw-normal">Hàng dự kiến về</dt><dd class="mb-0">@line.IncomingReservedBalance</dd></div><div class="col"><dt class="small muted fw-normal">Chưa có hàng để xuất</dt><dd class="mb-0">@Math.Max(0, line.RemainingQuantity - line.MaxIssueNow)</dd></div></dl>
                <partial name="_SourceBalances" model="line" />
            </article></div>
        }
    </div></section>
    <div class="row g-4 outbound-work-grid">
        <div class="col-lg-5"><section class="workspace-card p-4"><h2 class="h5 mb-3"><i class="bi bi-upc-scan text-primary me-2" aria-hidden="true"></i>Quét serial</h2>
            @if (!canAdd) { <p class="muted">Không còn hạn mức chọn thêm trong đợt này.</p> }
            <form asp-action="ScanSerial" method="post" id="scanSerialForm" data-outbound-submit-once><input type="hidden" name="outboundId" value="@Model.OutboundId" /><input type="hidden" name="version" value="@Model.Version" />
                <partial name="_SerialCapture" model="@(new PRN222_EWMS_Web.ViewModels.Shared.SerialCaptureViewModel { SerialName = "serialNumber", MethodName = "captureMethod", HelpText = "Camera, ảnh tem hoặc máy quét barcode.", Hint = "Nhập serial và nhấn Enter để thêm." })" />
                <button type="submit" class="workspace-button w-100 mt-3" disabled="@(!canAdd)"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Thêm serial</button>
            </form>
        </section></div>
        <div class="col-lg-7"><section class="workspace-card p-0 overflow-hidden"><div class="p-3 border-bottom"><h2 class="h5 mb-0">Serial đã chọn <span class="outbound-badge outbound-badge-picking">@Model.TotalScanned</span></h2></div><div class="table-wrap"><table class="workspace-table outbound-selected-table"><thead><tr><th>Serial / Sản phẩm</th><th>Nguồn hàng</th><th>Đã chọn lúc</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.ScannedSerials.Where(serial => serial.IsActive))
            {
                <tr><td><strong class="font-monospace">@item.SerialNumber</strong><small class="d-block muted">@item.ProductCode · @item.ProductName</small></td><td><span class="small">@item.SourceCode</span>@if (!string.IsNullOrWhiteSpace(item.LocationPath)) { <small class="d-block muted">@item.LocationPath</small> }</td><td><small>@Local(item.ScannedAt).ToString("HH:mm dd/MM/yyyy")</small></td><td><form asp-action="RemoveSerial" method="post" data-outbound-submit-once><input type="hidden" name="outboundId" value="@Model.OutboundId" /><input type="hidden" name="serialItemId" value="@item.SerialItemId" /><input type="hidden" name="version" value="@Model.Version" /><button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Bỏ chọn serial @item.SerialNumber"><i class="bi bi-trash" aria-hidden="true"></i></button></form></td></tr>
            }
            @if (Model.TotalScanned == 0) { <tr><td colspan="4" class="text-center muted py-5">Chưa chọn serial nào.</td></tr> }
        </tbody></table></div></section></div>
    </div>
    <section class="workspace-card p-0 overflow-hidden">
        <header class="p-3 border-bottom"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3"><h2 class="h5 mb-0"><i class="bi bi-geo-alt text-primary me-2" aria-hidden="true"></i>Gợi ý vị trí và serial</h2><div><label for="outbound-serial-search" class="visually-hidden">Tìm serial, sản phẩm, vị trí hoặc nguồn</label><input type="search" id="outbound-serial-search" class="form-control" maxlength="150" placeholder="Serial, vị trí hoặc nguồn hàng..." /></div></div>
            @if (Model.Lines.Count > 1) { <div class="outbound-filters-bar mt-3" role="group" aria-label="Lọc gợi ý theo sản phẩm"><button type="button" class="outbound-filter-pill active" data-product-filter="ALL" aria-pressed="true">Tất cả sản phẩm</button>@foreach (var line in Model.Lines) { <button type="button" class="outbound-filter-pill" data-product-filter="@line.ProductId" aria-pressed="false">@line.ProductCode</button> }</div> }
        </header>
        <div class="table-wrap"><table class="workspace-table" id="suggestedSerialsTable"><thead><tr><th>Serial</th><th>Sản phẩm</th><th>Sản xuất</th><th>Vị trí lấy hàng</th><th>Nguồn hàng</th><th>Chọn</th></tr></thead><tbody>
            @foreach (var item in Model.SuggestedSerials)
            {
                var line = Model.Lines.FirstOrDefault(product => product.ProductId == item.ProductId);
                var selectable = item.CanSelect && !item.IsAlreadyPickedInSession && line?.CanPickMoreQuantity > 0;
                <tr class="suggested-serial-row @(item.IsAlreadyPickedInSession ? "outbound-picked-row" : item.IsPriority ? "outbound-priority-row" : "")" data-product-id="@item.ProductId" data-suggestion-search="@item.SerialNumber @item.ProductCode @item.ProductName @item.LocationPath @item.SourceCode"><td><strong class="font-monospace">@item.SerialNumber</strong>@if (item.IsPriority) { <span class="outbound-fifo-badge d-inline-flex mt-1"><i class="bi bi-star-fill me-1" aria-hidden="true"></i>Ưu tiên lấy</span> }</td><td><strong>@item.ProductCode</strong><small class="d-block muted">@item.ProductName</small></td><td><span class="outbound-mfg-chip">@item.MfgDateDisplay</span></td><td><span class="outbound-location-chip"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@item.LocationPath</span></td><td><span class="small">@item.SourceCode</span></td><td>@if (item.IsAlreadyPickedInSession) { <span class="outbound-badge outbound-badge-draft">Đã chọn</span> } else { <button type="button" class="workspace-button sales-button-small btn-quick-pick" data-serial="@item.SerialNumber" disabled="@(!selectable)">Chọn lấy</button> }</td></tr>
            }
            @if (Model.SuggestedSerials.Count == 0) { <tr><td colspan="6" class="text-center muted py-5">Chưa có serial đủ điều kiện để chọn.</td></tr> }
        </tbody></table></div><p id="outbound-suggestions-empty" class="muted text-center p-3 mb-0 d-none" role="status">Không có serial phù hợp bộ lọc.</p>
    </section>
</div>
<div class="modal fade outbound-modal" id="cancelPickingModal" tabindex="-1" aria-labelledby="cancelPickingModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="cancelPickingModalLabel">Hủy phiếu @Model.IssueCode?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body">Bỏ chọn @Model.TotalScanned serial và kết thúc phiếu này. Các serial chưa xuất được trả lại danh sách có thể chọn.</div><div class="modal-footer"><button type="button" class="workspace-button sales-button-secondary" data-bs-dismiss="modal">Giữ lại phiếu</button><form asp-action="CancelPicking" method="post" data-outbound-submit-once><input type="hidden" name="outboundId" value="@Model.OutboundId" /><input type="hidden" name="version" value="@Model.Version" /><button type="submit" class="workspace-button sales-button-danger">Xác nhận hủy</button></form></div></div></div></div>
@section Scripts { <partial name="_SerialCaptureScripts" /><script src="~/js/outbound.js" asp-append-version="true"></script> }
