@model PRN222_EWMS_Web.ViewModels.Outbound.PickingWorkbenchViewModel
@{
    ViewData["Title"] = "Phiên lấy hàng " + Model.IssueCode;
}

<div class="outbound-page">
    <div class="workspace-heading">
        <div>
            <p class="eyebrow">XUẤT KHO / BÀN NHẶT HÀNG</p>
            <h1>@Model.IssueCode</h1>
            <p class="muted">
                Đơn bán hàng: <strong class="text-dark">@Model.Socode</strong> · Khách hàng: <strong class="text-dark">@Model.CustomerName</strong> · Kho: <strong class="text-dark">@Model.WarehouseName</strong>
            </p>
        </div>
        <div class="outbound-toolbar">
            <a asp-action="Index" class="workspace-button sales-button-secondary sales-button-small" title="Tạm thoát ra danh sách phiếu xuất kho">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Danh sách phiếu xuất
            </a>
            <button type="button" class="workspace-button sales-button-danger sales-button-small" data-bs-toggle="modal" data-bs-target="#cancelPickingModal">
                <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Hủy phiên lấy hàng
            </button>
            <form asp-action="MarkReady" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="outboundId" value="@Model.OutboundId" />
                <button type="submit" class="workspace-button sales-button-small" @(Model.TotalScanned == 0 ? "disabled" : "")>
                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i> Hoàn thành nhặt hàng
                </button>
            </form>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="outbound-notice outbound-notice-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="outbound-notice outbound-notice-success" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @* 1. TIẾN ĐỘ TỪNG DÒNG HÀNG *@
    <div class="row g-3">
        @foreach (var line in Model.Lines)
        {
            var totalToFulfill = line.RemainingQuantity;
            var pickedNow = line.InThisReceiptCount;
            var isLineComplete = pickedNow >= totalToFulfill;
            var progressPercent = totalToFulfill > 0 ? Math.Min(100, (int)Math.Round((double)pickedNow * 100 / totalToFulfill)) : 100;

            <div class="col-md-6 col-lg-4">
                <div class="workspace-card h-100 p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong class="d-block text-dark">@line.ProductCode</strong>
                            <small class="muted">@line.ProductName</small>
                        </div>
                        @if (isLineComplete)
                        {
                            <span class="outbound-badge outbound-badge-done">
                                <i class="bi bi-check2"></i> Đã đủ
                            </span>
                        }
                        else
                        {
                            <span class="outbound-badge outbound-badge-picking">
                                Cần lấy: @totalToFulfill @line.Unit
                            </span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top" style="font-size: 13.5px;">
                        <span class="muted">Đã quét trong phiên:</span>
                        <strong class="fs-6 @(isLineComplete ? "text-success" : "text-primary")">
                            @pickedNow / @totalToFulfill @line.Unit (@progressPercent%)
                        </strong>
                    </div>

                    <div class="outbound-progress-wrap">
                        <div class="outbound-progress-bar">
                            <div class="outbound-progress-fill @(isLineComplete ? "complete" : "")" style="width: @(progressPercent)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        @* 2. KHUNG QUÉT MÃ SERIAL *@
        <div class="col-lg-5">
            <div class="workspace-card p-4">
                <h2 class="h5 fw-bold mb-3 d-flex align-items-center gap-2 text-dark">
                    <i class="bi bi-upc-scan text-primary"></i> Quét mã Serial thiết bị
                </h2>
                <p class="muted" style="font-size: 13.5px;">
                    Nhập hoặc quét mã vạch serial trên thân thiết bị. Hệ thống sẽ tự động đối chiếu tình trạng, kho và kiểm tra độc quyền giữ chỗ nhặt hàng.
                </p>

                <form asp-action="ScanSerial" method="post" id="scanSerialForm" class="mb-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="outboundId" value="@Model.OutboundId" />

                    <partial name="_SerialCapture" model="@(new PRN222_EWMS_Web.ViewModels.Shared.SerialCaptureViewModel {
                        SerialName = "serialNumber",
                        MethodName = "captureMethod",
                        HelpText = "Quét qua camera, đọc ảnh tem hoặc dùng máy quét barcode.",
                        Hint = "Nhập tay hoặc máy quét · Enter để thêm thiết bị."
                    })" />

                    <button class="workspace-button w-100 justify-content-center mt-3" type="submit">
                        <i class="bi bi-plus-lg me-1"></i> Xác nhận thêm Serial
                    </button>
                </form>
            </div>
        </div>

        @* 3. DANH SÁCH SERIAL ĐÃ QUÉT TRONG PHIÊN *@
        <div class="col-lg-7">
            <div class="workspace-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        Thiết bị đã quét trong phiên: <span class="text-primary">@Model.TotalScanned</span>
                    </h2>
                    <span class="muted" style="font-size: 12.5px;">
                        Tự động giữ chỗ nhặt hàng cho đến khi hoàn thành
                    </span>
                </div>

                <div>
                    @if (Model.ScannedSerials.Count == 0)
                    {
                        <div class="p-5 text-center muted">
                            <i class="bi bi-qr-code-scan fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-0">Chưa có thiết bị nào được quét. Hãy dùng máy quét hoặc nhập mã serial vào ô bên trái.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="workspace-table">
                                <thead>
                                    <tr>
                                        <th style="width: 45px;">STT</th>
                                        <th>Mã Serial</th>
                                        <th>Sản phẩm</th>
                                        <th>Tình trạng</th>
                                        <th>Thời điểm quét</th>
                                        <th style="text-align: right; width: 80px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var serialIndex = 1; }
                                    @foreach (var s in Model.ScannedSerials)
                                    {
                                        <tr>
                                            <td class="muted">@serialIndex</td>
                                            <td>
                                                <strong class="font-monospace text-dark">@s.SerialNumber</strong>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">@s.ProductCode</div>
                                                <small class="muted">@s.ProductName</small>
                                            </td>
                                            <td>
                                                <span class="outbound-condition-badge">
                                                    <i class="bi bi-check2"></i> @s.ItemCondition
                                                </span>
                                            </td>
                                            <td>
                                                <span class="muted small">
                                                    @s.ScannedAt.ToLocalTime().ToString("HH:mm:ss")
                                                </span>
                                            </td>
                                            <td style="text-align: right;">
                                                <form asp-action="RemoveSerial" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="outboundId" value="@Model.OutboundId" />
                                                    <input type="hidden" name="serialItemId" value="@s.SerialItemId" />
                                                    <button type="submit" class="workspace-button sales-button-small sales-button-danger" style="padding: 4px 10px;" title="Gỡ bỏ serial và giải phóng giữ chỗ" onclick="return confirm('Bạn có chắc muốn bỏ serial này khỏi phiên lấy hàng?');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        serialIndex++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* 4. GỢI Ý VỊ TRÍ & THIẾT BỊ ƯU TIÊN LẤY HÀNG (FIFO THEO NGÀY SẢN XUẤT) *@
    <div class="row mt-4">
        <div class="col-12">
            <div class="workspace-card p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-light">
                    <div>
                        <h2 class="h6 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-primary"></i> Gợi ý vị trí & Thiết bị ưu tiên lấy hàng (FIFO)
                        </h2>
                        <p class="muted mb-0" style="font-size: 13px;">
                            Hệ thống tự động sắp xếp theo <strong>Năm sản xuất cũ nhất lên trước</strong> và chỉ rõ vị trí lưu trữ trên ô kệ.
                        </p>
                    </div>

                    @* Bộ lọc nhanh theo sản phẩm nếu đơn có nhiều dòng *@
                    @if (Model.Lines.Count > 1)
                    {
                        <div class="outbound-filters-bar" role="group" aria-label="Lọc theo sản phẩm">
                            <button type="button" class="outbound-filter-pill active" data-product-filter="ALL">Tất cả sản phẩm</button>
                            @foreach (var line in Model.Lines)
                            {
                                <button type="button" class="outbound-filter-pill" data-product-filter="@line.ProductId">
                                    @line.ProductCode
                                </button>
                            }
                        </div>
                    }
                </div>

                <div>
                    @if (Model.SuggestedSerials.Count == 0)
                    {
                        <div class="p-5 text-center muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-0">Không tìm thấy thiết bị nào ở trạng thái hợp lệ trong kho để lấy cho đơn hàng này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="workspace-table" id="suggestedSerialsTable">
                                <thead>
                                    <tr>
                                        <th style="width: 45px;">STT</th>
                                        <th style="min-width: 170px;">Mã Serial</th>
                                        <th style="min-width: 220px;">Sản phẩm</th>
                                        <th style="min-width: 130px;">Ngày / Năm SX</th>
                                        <th style="min-width: 240px;">Vị trí cất hàng (Pick Path)</th>
                                        <th style="width: 110px;">Tình trạng</th>
                                        <th style="text-align: right; min-width: 140px;">Thao tác 1-chạm</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var suggIndex = 1; }
                                    @foreach (var s in Model.SuggestedSerials)
                                    {
                                        <tr class="suggested-serial-row @(s.IsAlreadyPickedInSession ? "outbound-picked-row" : (s.IsPriority ? "outbound-priority-row" : ""))" data-product-id="@s.ProductId">
                                            <td class="muted fw-semibold">@suggIndex</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <strong class="font-monospace text-dark fs-6">@s.SerialNumber</strong>
                                                    @if (s.IsPriority)
                                                    {
                                                        <span class="outbound-fifo-badge" title="Năm sản xuất cũ nhất - Khuyến nghị xuất trước theo FIFO">
                                                            <i class="bi bi-star-fill me-1"></i>Xuất trước (FIFO)
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">[@s.ProductCode] @s.ProductName</div>
                                            </td>
                                            <td>
                                                <span class="outbound-mfg-chip">
                                                    <i class="bi bi-calendar3 me-1"></i>@s.MfgDateDisplay
                                                </span>
                                            </td>
                                            <td>
                                                <span class="outbound-location-chip">
                                                    <i class="bi bi-geo-alt-fill text-muted me-1"></i>@s.LocationPath
                                                </span>
                                            </td>
                                            <td>
                                                <span class="outbound-condition-badge">
                                                    <i class="bi bi-check2"></i> @s.ItemCondition
                                                </span>
                                            </td>
                                            <td style="text-align: right;">
                                                @if (s.IsAlreadyPickedInSession)
                                                {
                                                    <span class="outbound-badge outbound-badge-draft">
                                                        <i class="bi bi-check2 me-1"></i>Đã quét xong
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="workspace-button sales-button-small btn-quick-pick"
                                                            data-serial="@s.SerialNumber"
                                                            title="Tự động điền serial @s.SerialNumber và xác nhận nhặt ngay">
                                                        <i class="bi bi-box-arrow-in-down me-1"></i> Chọn lấy
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                        suggIndex++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* MODAL HỦY PHIÊN LẤY HÀNG *@
<div class="modal fade outbound-modal" id="cancelPickingModal" tabindex="-1" aria-labelledby="cancelPickingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark" id="cancelPickingModalLabel">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i> Xác nhận hủy phiên lấy hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Bạn có chắc chắn muốn hủy phiên lấy hàng cho phiếu <strong>@Model.IssueCode</strong>?</p>
                <div class="outbound-notice outbound-notice-warning" style="font-size: 13px;">
                    <i class="bi bi-info-circle flex-shrink-0"></i>
                    <span>Toàn bộ <strong>@Model.TotalScanned</strong> thiết bị đã quét sẽ được gỡ bỏ và giải phóng để các nhân viên khác có thể thao tác.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="workspace-button sales-button-secondary sales-button-small" data-bs-dismiss="modal">Đóng</button>
                <form asp-action="CancelPicking" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="outboundId" value="@Model.OutboundId" />
                    <button type="submit" class="workspace-button sales-button-small sales-button-danger">Xác nhận hủy</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_SerialCaptureScripts" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Xử lý nút 1-chạm: Chọn lấy serial từ bảng gợi ý
            var pickButtons = document.querySelectorAll('.btn-quick-pick');
            pickButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var serial = this.getAttribute('data-serial');
                    if (!serial) return;

                    var serialInput = document.querySelector('[data-serial-input]') || document.getElementById('serialNumber');
                    if (serialInput) {
                        serialInput.value = serial;

                        var methodInput = document.querySelector('[data-capture-method]');
                        if (methodInput) {
                            methodInput.value = 'QUICK_SELECT';
                        }

                        var form = document.getElementById('scanSerialForm');
                        if (form) {
                            this.disabled = true;
                            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang lấy...';
                            form.submit();
                        }
                    }
                });
            });

            // Xử lý bộ lọc nhanh theo sản phẩm trên bảng gợi ý
            var filterBtns = document.querySelectorAll('[data-product-filter]');
            filterBtns.forEach(function (fBtn) {
                fBtn.addEventListener('click', function () {
                    filterBtns.forEach(function (b) {
                        b.classList.remove('active');
                    });
                    this.classList.add('active');

                    var targetPid = this.getAttribute('data-product-filter');
                    var rows = document.querySelectorAll('.suggested-serial-row');
                    rows.forEach(function (r) {
                        if (targetPid === 'ALL' || r.getAttribute('data-product-id') === targetPid) {
                            r.style.display = '';
                        } else {
                            r.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}