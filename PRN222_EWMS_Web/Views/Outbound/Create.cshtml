@model PRN222_EWMS_Web.ViewModels.Outbound.CreateOutboundViewModel
@{ ViewData["Title"] = "Tạo phiếu xuất kho"; }

<div class="outbound-page">
    <header class="workspace-heading">
        <div><p class="eyebrow">XUẤT KHO</p><h1>Chọn đơn bán hàng cần xuất</h1></div>
        <a class="workspace-button sales-button-secondary" asp-action="Index"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Phiếu xuất kho</a>
    </header>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.EligibleOrders.Count == 0)
    {
        <section class="workspace-card text-center py-5"><i class="bi bi-inbox fs-1 muted" aria-hidden="true"></i><h2 class="h5 mt-3">Chưa có đơn cần xuất tại kho của bạn</h2><a asp-action="Index" class="workspace-link">Quay lại danh sách phiếu</a></section>
    }
    else
    {
        <div class="workspace-card"><label for="outbound-order-search" class="form-label">Tìm đơn bán hàng</label><input id="outbound-order-search" class="form-control" type="search" maxlength="150" placeholder="Mã SO hoặc khách hàng..." /></div>
        @foreach (var order in Model.EligibleOrders)
        {
            var selected = Model.SelectedSalesOrderId == order.SalesOrderId;
            <article class="workspace-card p-4 @(selected ? "border-primary" : "")" data-outbound-order data-search="@order.Socode @order.CustomerName">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div><h2 class="h5 mb-2">@order.Socode <span class="outbound-badge @(order.IsPickingActive ? "outbound-badge-picking" : order.TotalMaxIssueNow > 0 ? "outbound-badge-ready" : "outbound-badge-draft")">@(order.IsPickingActive ? "Đang lấy hàng" : order.TotalMaxIssueNow > 0 ? "Có hàng để xuất" : order.TotalIncoming > 0 ? "Chờ hàng về" : "Chưa có hàng đủ điều kiện")</span></h2><p class="muted mb-1">@order.CustomerName · @(order.CustomerPhone ?? "—")</p><small class="muted">Ngày yêu cầu xuất: @(order.RequestedDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</small></div>
                    <div>
                        @if (order.IsPickingActive && order.ActiveOutboundId.HasValue)
                        {
                            <a asp-action="Picking" asp-route-id="@order.ActiveOutboundId" class="workspace-button"><i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Tiếp tục @order.ActiveIssueCode</a>
                        }
                        else
                        {
                            <form asp-action="StartPicking" method="post" data-outbound-submit-once>
                                <input type="hidden" name="salesOrderId" value="@order.SalesOrderId" /><input type="hidden" name="requestToken" value="@Model.RequestToken" />
                                <button type="submit" class="workspace-button" disabled="@(order.TotalMaxIssueNow <= 0)"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Tạo phiếu và lấy hàng</button>
                            </form>
                        }
                    </div>
                </div>
                <dl class="outbound-info-grid mb-0 mt-4"><div><dt>Còn phải xuất</dt><dd>@order.TotalRemaining</dd></div><div><dt>Có thể lấy ngay</dt><dd class="text-primary">@order.TotalMaxIssueNow</dd></div><div><dt>Hàng dự kiến về</dt><dd>@order.TotalIncoming</dd></div><div><dt>Chưa có hàng để xuất</dt><dd>@order.Lines.Sum(line => Math.Max(0, line.RemainingQuantity - line.MaxIssueNow))</dd></div></dl>
                <details class="mt-3" open="@selected"><summary class="workspace-link px-0">Sản phẩm và nguồn hàng</summary><div class="table-wrap mt-2"><table class="workspace-table"><thead><tr><th>Sản phẩm</th><th>Đã xuất</th><th>Còn phải xuất</th><th>Có thể lấy ngay</th><th>Chưa có hàng để xuất</th><th>Hàng dự kiến về</th></tr></thead><tbody>
                    @foreach (var line in order.Lines)
                    {
                        <tr><td><strong>@line.ProductCode</strong><small class="d-block muted">@line.ProductName</small>@foreach (var source in line.Sources) { <small class="d-block muted">@(source.SupplyState == "INCOMING" ? "Dự kiến từ PO" : "Nguồn thực tế") · @source.SourceCode: @source.Balance</small> }</td><td>@line.DoneQuantity</td><td>@line.RemainingQuantity</td><td class="fw-bold text-primary">@line.MaxIssueNow</td><td>@Math.Max(0, line.RemainingQuantity - line.MaxIssueNow)</td><td>@line.IncomingReservedBalance</td></tr>
                    }
                </tbody></table></div></details>
            </article>
        }
        <p id="outbound-orders-empty" class="muted d-none" role="status">Không tìm thấy đơn phù hợp.</p>
    }
</div>
@section Scripts { <script src="~/js/outbound.js" asp-append-version="true"></script> }
