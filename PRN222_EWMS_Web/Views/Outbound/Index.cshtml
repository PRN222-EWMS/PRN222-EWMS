@model PRN222_EWMS_Web.ViewModels.Outbound.OutboundListViewModel
@{
    ViewData["Title"] = "Phiếu xuất kho";
    var isStaff = User.IsInRole("WAREHOUSE_STAFF");
    var totalPages = Math.Max(1, Model.TotalPages);
    var firstPage = Math.Max(1, Math.Min(Model.PageIndex - 2, totalPages - 4));
    var lastPage = Math.Min(totalPages, firstPage + 4);
    DateTime Local(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Utc).AddHours(7);
    string StatusLabel(string status) => status switch { "DRAFT" => "Nháp", "PICKING" => "Đang lấy hàng", "READY" => "Sẵn sàng, chưa xuất", "DONE" => "Đã xuất kho", "CANCELLED" => "Đã hủy", _ => status };
}
<div class="outbound-page">
    <header class="workspace-heading"><div><p class="eyebrow">XUẤT KHO</p><h1>Phiếu xuất kho</h1><p class="muted mb-0">@(isStaff ? "Các đợt xuất tại kho làm việc của bạn." : "Theo dõi từng đợt xuất và tiến độ đơn bán hàng.")</p></div>@if (Model.CanCreate) { <a asp-action="Create" class="workspace-button"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Tạo phiếu xuất kho</a> }</header>
    <section class="workspace-card">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4"><label for="outbound-search" class="form-label">Mã phiếu / SO / Khách hàng</label><input id="outbound-search" name="search" value="@Model.SearchTerm" class="form-control" maxlength="100" /></div>
            <div class="col-md-4"><label for="outbound-status" class="form-label">Trạng thái</label><select id="outbound-status" name="status" class="form-select"><option value="">Tất cả</option>@foreach (var status in new[] { "DRAFT", "PICKING", "READY", "DONE", "CANCELLED" }) { <option value="@status" selected="@(Model.Status == status)">@StatusLabel(status)</option> }</select></div>
            <div class="col-md-4"><label for="outbound-warehouse" class="form-label">Kho xuất</label>@if (isStaff) { <input id="outbound-warehouse" class="form-control" value="@(Model.Warehouses.FirstOrDefault()?.Name ?? "Chưa được gán kho")" readonly /> } else { <select id="outbound-warehouse" name="warehouseId" class="form-select"><option value="">Tất cả kho</option>@foreach (var warehouse in Model.Warehouses) { <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.Name</option> }</select> }</div>
            <div class="col-md-4"><label for="outbound-from" class="form-label">Ngày tạo từ</label><input type="date" id="outbound-from" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4"><label for="outbound-to" class="form-label">Đến ngày</label><input type="date" id="outbound-to" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4 d-flex align-items-end gap-2"><button type="submit" class="workspace-button">Lọc</button><a asp-action="Index" class="workspace-link">Đặt lại</a></div>
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        </form>
    </section>
    <section class="workspace-card p-0 overflow-hidden"><div class="table-wrap" tabindex="0" role="region" aria-label="Danh sách phiếu xuất"><table class="workspace-table outbound-receipts-table"><thead><tr><th>Phiếu / Đơn bán</th><th>Khách hàng</th><th>Kho xuất</th><th>Serial trong phiếu</th><th>Ngày tạo</th><th>Người tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            <tr><td><a asp-action="Details" asp-route-id="@item.OutboundId" class="outbound-code-badge">@item.IssueCode</a><small class="d-block muted mt-1">@item.Socode</small></td><td>@item.CustomerName</td><td>@item.WarehouseName</td><td><strong>@item.ItemCount</strong><small class="d-block muted">@(item.Status == "DONE" ? "Đã xuất chính thức" : item.Status == "CANCELLED" ? "Đã hủy" : "Đang chọn")</small></td><td>@Local(item.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@item.CreatedByName</td><td><span class="outbound-badge outbound-badge-@item.Status.ToLowerInvariant()">@StatusLabel(item.Status)</span></td><td><div class="d-flex gap-2 flex-wrap"><a asp-action="Details" asp-route-id="@item.OutboundId">Chi tiết</a>@if (isStaff && item.CanWork) { <a asp-action="Picking" asp-route-id="@item.OutboundId">Tiếp tục xuất</a> }</div></td></tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-center muted py-5">Không có phiếu xuất phù hợp.</td></tr> }
    </tbody></table></div>
    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3" aria-label="Phân trang phiếu xuất"><span class="muted">Trang @Model.PageIndex / @totalPages · @Model.TotalItems phiếu</span><div class="d-flex flex-wrap gap-2">@if (Model.PageIndex > 1) { <a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-warehouseId="@Model.WarehouseId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="workspace-link">Trước</a> }@for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++) { if (pageNumber == Model.PageIndex) { <span class="workspace-button sales-button-small" aria-current="page">@pageNumber</span> } else { <a asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-warehouseId="@Model.WarehouseId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="workspace-link">@pageNumber</a> } }@if (Model.PageIndex < totalPages) { <a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-warehouseId="@Model.WarehouseId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="workspace-link">Sau</a> }</div></nav>
    }
    </section>
</div>
