@model PRN222_EWMS_Web.ViewModels.Products.ProductListViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">Danh sách sản phẩm</h2>
    <div class="d-flex flex-wrap gap-2 ms-auto">
        @if (User.IsInRole("PURCHASING_STAFF"))
        {
            <a asp-action="Create" class="btn btn-primary">Thêm sản phẩm</a>
        }
        @if (User.IsInRole("MANAGER"))
        {
            <a asp-controller="ManagerDashboard"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">
                ← Về tổng quan
            </a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="@(Model.CanFilterWarehouse ? "col-md-7" : "col-md-10")">
        <label asp-for="Keyword" class="form-label">Tìm sản phẩm</label>
        <input asp-for="Keyword" class="form-control" placeholder="Nhập mã, tên hoặc model" />
    </div>
    @if (Model.CanFilterWarehouse)
    {
        <div class="col-md-3">
            <label asp-for="WarehouseId" class="form-label">Kho</label>
            <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                <option value="">Tất cả kho</option>
            </select>
        </div>
    }
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
    </div>
</form>

<p class="small text-muted">
    Tổng tồn gồm hàng tốt và hàng hỏng đang trong kho. Hàng hỏng là một phần của tổng tồn.
    Số liệu này chưa phải lượng hàng có thể xuất.
</p>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Mã</th>
                <th scope="col">Tên sản phẩm</th>
                <th scope="col">Model</th>
                <th scope="col">Danh mục</th>
                <th scope="col">Thương hiệu</th>
                <th scope="col" class="text-end">Tổng tồn</th>
                <th scope="col" class="text-end">Hàng hỏng</th>
                <th scope="col">Trạng thái</th>
                <th scope="col"><span class="visually-hidden">Thao tác</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var product = item.Product;
                <tr>
                    <td>@product.ProductCode</td>
                    <td>@product.ProductName</td>
                    <td>@product.Model</td>
                    <td>@product.Category.CategoryName</td>
                    <td>@product.Brand.BrandName</td>
                    <td class="text-end">@item.TotalStock</td>
                    <td class="text-end">
                        @if (item.DamagedStock > 0)
                        {
                            <span class="badge bg-danger">@item.DamagedStock</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </td>
                    <td>
                        @(product.Status switch
                        {
                            "ACTIVE" => "Đang hoạt động",
                            "INACTIVE" => "Ngừng hoạt động",
                            _ => product.Status
                        })
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@product.ProductId">Chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Items.Count == 0)
{
    <p>Không tìm thấy sản phẩm phù hợp.</p>
}
