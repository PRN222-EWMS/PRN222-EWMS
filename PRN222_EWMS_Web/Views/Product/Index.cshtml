@model PRN222_EWMS_Web.ViewModels.Products.ProductListViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Danh sách sản phẩm</h1>
    <div class="d-flex flex-wrap gap-2 ms-auto">
        @if (User.IsInRole("PURCHASING_STAFF"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm sản phẩm</a>
        }
        @if (User.IsInRole("MANAGER"))
        {
            <a asp-controller="ManagerDashboard"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">
                ← Về tổng quan
            </a>
        }
    </div>
</div>

<section class="workspace-card mb-4" aria-label="Bộ lọc sản phẩm">
<form asp-action="Index" method="get" class="row g-3 align-items-end">
    <div class="col-lg">
        <label asp-for="Keyword" class="form-label">Tìm sản phẩm</label>
        <input asp-for="Keyword" class="form-control" placeholder="Nhập mã, tên hoặc model" />
    </div>
    @if (Model.CanFilterWarehouse)
    {
        <div class="col-lg-2">
            <label asp-for="WarehouseId" class="form-label">Kho</label>
            <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                <option value="">Tất cả kho</option>
            </select>
        </div>
    }
    <div class="col-lg-2">
        <label asp-for="Status" class="form-label">Trạng thái</label>
        <select asp-for="Status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="ACTIVE">Đang hoạt động</option>
            <option value="INACTIVE">Ngừng hoạt động</option>
        </select>
    </div>
    <div class="col-lg-auto d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search" aria-hidden="true"></i> Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i> Xóa lọc
        </a>
    </div>
</form>
</section>

<section class="workspace-card" aria-label="Danh sách sản phẩm">
<p class="small text-muted">
    Tổng tồn gồm hàng tốt và hàng hỏng đang trong kho. Hàng hỏng là một phần của tổng tồn.
    Số liệu này chưa phải lượng hàng có thể xuất.
</p>

<div class="table-wrap" tabindex="0" role="region" aria-label="Bảng sản phẩm, có thể cuộn ngang">
    <table class="workspace-table">
        <thead>
            <tr>
                <th scope="col">Mã</th>
                <th scope="col">Tên sản phẩm</th>
                <th scope="col">Model</th>
                <th scope="col">Danh mục</th>
                <th scope="col">Thương hiệu</th>
                <th scope="col" class="text-end">Tổng tồn</th>
                <th scope="col" class="text-end">Hàng hỏng</th>
                <th scope="col">Trạng thái</th>
                <th scope="col">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var product = item.Product;
                <tr>
                    <td>@product.ProductCode</td>
                    <td>@product.ProductName</td>
                    <td>@product.Model</td>
                    <td>@product.Category.CategoryName</td>
                    <td>@product.Brand.BrandName</td>
                    <td class="text-end">@item.TotalStock</td>
                    <td class="text-end">
                        @if (item.DamagedStock > 0)
                        {
                            <span class="badge bg-danger">@item.DamagedStock</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </td>
                    <td>
                        @(product.Status switch
                        {
                            "ACTIVE" => "Đang hoạt động",
                            "INACTIVE" => "Ngừng hoạt động",
                            _ => product.Status
                        })
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@product.ProductId" class="workspace-button workspace-button-small"><i class="bi bi-eye" aria-hidden="true"></i> Chi tiết</a>
                        @if (User.IsInRole("PURCHASING_STAFF"))
                        {
                            <a asp-action="Edit" asp-route-id="@product.ProductId" class="workspace-button workspace-button-small workspace-button-secondary ms-1"><i class="bi bi-pencil-square" aria-hidden="true"></i> Sửa</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Items.Count == 0)
{
    <p class="text-muted mt-3 mb-0">Không tìm thấy sản phẩm phù hợp.</p>
}
</section>
