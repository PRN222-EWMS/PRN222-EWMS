@model PRN222_EWMS_Web.Models.Product
@using System.Text.Json

@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    var specifications = new List<KeyValuePair<string, string>>();

    var labels = new Dictionary<string, string>
    {
        ["LoaiMay"] = "Loại máy",
        ["KhoiLuongGiat"] = "Khối lượng giặt",
        ["CongNghe"] = "Công nghệ",
        ["MauSac"] = "Màu sắc",
        ["BaoHanh"] = "Bảo hành"
    };

    bool isJsonObject = false;

    if (!string.IsNullOrWhiteSpace(Model.Specifications))
    {
        try
        {
            using var document = JsonDocument.Parse(Model.Specifications);

            if (document.RootElement.ValueKind == JsonValueKind.Object)
            {
                foreach (var property in document.RootElement.EnumerateObject())
                {
                    var label = labels.TryGetValue(property.Name, out var name)
                        ? name
                        : property.Name;

                    specifications.Add(
                        new KeyValuePair<string, string>(
                            label,
                            property.Value.ToString()));
                }

                isJsonObject = true;
            }
        }
        catch (JsonException)
        {
            // Thông số dạng văn bản thường sẽ được hiển thị nguyên văn.
        }
    }

    var statusLabel = Model.Status switch
    {
        "ACTIVE" => "Đang hoạt động",
        "INACTIVE" => "Ngừng hoạt động",
        _ => Model.Status
    };
}

<div class="mx-auto" style="max-width: 1200px;">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div class="mw-100">
        <p class="text-muted small mb-2">@Model.ProductCode</p>
        <h1 class="text-break mb-3">@Model.ProductName</h1>
        <span class="badge rounded-pill px-3 py-2 @(Model.Status == "ACTIVE" ? "bg-success" : "bg-secondary")">
            @statusLabel
        </span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Danh sách sản phẩm
        </a>
        @if (User.IsInRole("PURCHASING_STAFF"))
        {
            <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary rounded-pill">
                <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Sửa sản phẩm
            </a>
        }
    </div>
</div>

<section class="workspace-card mb-4" aria-labelledby="product-info-heading">
    <h2 id="product-info-heading" class="h5 mb-4">Thông tin chung</h2>
    <dl class="row g-4 mb-0">
        <div class="col-12 col-sm-6 col-lg-4">
            <dt class="text-muted small fw-normal mb-1">Mã sản phẩm</dt>
            <dd class="fw-semibold text-break mb-0">@Model.ProductCode</dd>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <dt class="text-muted small fw-normal mb-1">Model</dt>
            <dd class="text-break mb-0">@Model.Model</dd>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <dt class="text-muted small fw-normal mb-1">Danh mục</dt>
            <dd class="text-break mb-0">@(Model.Category?.CategoryName ?? "Chưa có")</dd>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <dt class="text-muted small fw-normal mb-1">Thương hiệu</dt>
            <dd class="text-break mb-0">@(Model.Brand?.BrandName ?? "Chưa có")</dd>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <dt class="text-muted small fw-normal mb-1">Đơn vị</dt>
            <dd class="text-break mb-0">@Model.Unit</dd>
        </div>
    </dl>

    <section class="border-top mt-4 pt-4" aria-labelledby="product-packaging-heading">
        <h2 id="product-packaging-heading" class="h5 mb-4">Đóng gói &amp; vận chuyển</h2>
        <dl class="row g-4 mb-0">
            <div class="col-12 col-sm-6">
                <dt class="text-muted small fw-normal mb-1">Dài × Rộng × Cao</dt>
                <dd class="mb-0">
                    @Model.LengthCm.ToString("0.##") × @Model.WidthCm.ToString("0.##") × @Model.HeightCm.ToString("0.##")
                    <span class="text-muted">cm</span>
                </dd>
            </div>
            <div class="col-12 col-sm-6">
                <dt class="text-muted small fw-normal mb-1">Trọng lượng</dt>
                <dd class="mb-0">@Model.GrossWeightKg.ToString("0.###") <span class="text-muted">kg</span></dd>
            </div>
        </dl>
    </section>
</section>

<section class="workspace-card" aria-labelledby="product-specifications-heading">
    <h2 id="product-specifications-heading" class="h5 mb-3">Thông số kỹ thuật</h2>
    @if (isJsonObject && specifications.Count > 0)
    {
        <div class="table-wrap" tabindex="0" role="region" aria-label="Thông số kỹ thuật, có thể cuộn ngang">
            <table class="workspace-table">
                <tbody>
                    @foreach (var specification in specifications)
                    {
                        <tr>
                            <th scope="row" class="w-50 text-break">@specification.Key</th>
                            <td class="text-break">@specification.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (isJsonObject || string.IsNullOrWhiteSpace(Model.Specifications))
    {
        <p class="text-muted small mb-0">Chưa có thông số kỹ thuật.</p>
    }
    else
    {
        <div class="text-break" style="white-space: pre-wrap;">@Model.Specifications</div>
    }
</section>
</div>
