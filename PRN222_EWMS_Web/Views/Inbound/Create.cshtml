@model PRN222_EWMS_Web.ViewModels.Inbound.InboundCreateViewModel
@{ ViewData["Title"] = "Tạo phiếu nhập kho"; var selected = Model.Orders.FirstOrDefault(order => order.Id == Model.PurchaseOrderId); }

<div class="inbound-page inbound-create-page">
    <a asp-action="Index" class="inbound-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Phiếu nhập kho</a>
    <header class="inbound-page-header"><div><h1>Tạo phiếu nhập</h1><p>@(selected is null ? "Chọn PO đã xác nhận, còn số lượng được tiếp nhận trong kho của bạn." : "Xác nhận PO đã chọn từ danh sách đơn mua cần nhận.")</p></div></header>

    @if (Model.PurchaseOrderId > 0 && selected is null)
    {
        <div class="inbound-form-card"><p class="text-danger mb-2">Đơn mua này không còn đủ điều kiện nhận hoặc không thuộc kho của bạn.</p><a asp-action="PurchaseOrders">Xem đơn mua cần nhận</a></div>
    }
    else
    {
        <form asp-action="Create" method="post" data-submit-once>
            <input type="hidden" asp-for="RequestToken" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <section class="inbound-form-card">
                <h2>Đơn mua hàng</h2>
                <div class="inbound-create-grid">
                    <div>
                        @if (selected is not null)
                        {
                            <label>Đơn mua hàng</label><input type="hidden" asp-for="PurchaseOrderId" />
                            <div class="inbound-selected-po"><strong>@selected.Code</strong><span>@selected.Supplier · @selected.Warehouse</span><small>Còn @selected.Remaining thiết bị có thể nhận</small></div>
                        }
                        else
                        {
                            <label asp-for="PurchaseOrderId">Đơn mua hàng</label>
                            <select asp-for="PurchaseOrderId" required><option value="">Chọn PO</option>@foreach (var order in Model.Orders) { <option value="@order.Id">@order.Code · @order.Supplier · còn @order.Remaining</option> }</select>
                        }
                    </div>
                    <div><label asp-for="Note">Ghi chú</label><textarea asp-for="Note" maxlength="1000" rows="2" placeholder="Ghi chú thêm cho phiếu nhập (nếu có)"></textarea></div>
                </div>
                @if (Model.Orders.Count == 0) { <p class="inbound-inline-note">Chưa có PO đủ điều kiện. PO cần được xác nhận, thuộc kho của bạn và còn số lượng nhận.</p> }
            </section>
            <div class="inbound-create-footer"><p>Phiếu mới ở trạng thái DRAFT. Chỉ khi hoàn tất, serial mới được ghi nhận vào tồn kho chính thức.</p><button type="submit" class="inbound-primary" disabled="@(Model.Orders.Count == 0)">Tạo phiếu và tiếp nhận <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
        </form>
    }
</div>
<script src="~/js/inbound.js" asp-append-version="true" defer></script>
