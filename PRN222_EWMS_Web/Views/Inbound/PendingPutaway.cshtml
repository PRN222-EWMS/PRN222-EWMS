@model PRN222_EWMS_Web.ViewModels.Inbound.InboundPendingPutawayViewModel
@{ ViewData["Title"] = "Chờ xếp kho"; }
<div class="workspace-heading"><div><p class="eyebrow">VẬN HÀNH KHO</p><h1>Chờ Putaway</h1><p class="muted">Thiết bị đã nhận nhưng chưa có vị trí lưu kho.</p></div><a class="workspace-link" asp-action="Index">Phiếu nhập</a></div>
<section class="workspace-card">@if (Model.Items.Count == 0) { <p class="muted">Không có Serial chờ xếp kho.</p> } else { <div class="table-wrap"><table class="workspace-table"><thead><tr><th>Serial</th><th>Sản phẩm</th><th>Tình trạng</th><th>Kho</th><th>Phiếu nhập</th><th>Thời gian nhận</th><th>Vị trí</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Serial</td><td>@item.ProductCode — @item.ProductName</td><td>@item.Condition</td><td>@item.Warehouse</td><td><a asp-action="Details" asp-route-id="@item.InboundId">@item.InboundCode</a></td><td>@item.ReceivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>Chưa xếp kho</td></tr> }</tbody></table></div> }</section>
