@{
    var useInlineNotifications = ViewContext.RouteData.Values["controller"]?.ToString() is "CustomerReturnOrder" or "Supplier";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EWMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ewms-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
        @if (ViewContext.RouteData.Values["controller"]?.ToString()
        is "Inbound" or "Putaway" or "Outbound" or "WarehouseTransfer" or "Stocktake")
    {
        <link rel="stylesheet" href="~/css/serial-capture.css" asp-append-version="true" />
    }
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Putaway")
    {
        <link rel="stylesheet" href="~/css/putaway.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Inbound", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/inbound.css" asp-append-version="true" />
    }
    @if (ViewContext.RouteData.Values["controller"]?.ToString() is "Outbound" or "WarehouseTransfer")
    {
        <link rel="stylesheet" href="~/css/outbound.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Transfer", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/transfer.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "ReturnReceive", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/return-receive.css" asp-append-version="true" />
    }
    @if (User.IsInRole("ADMIN"))
    {
        <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "AuditLog", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/audit-log.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "CeoPurchaseProgress", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/ceo-purchase-progress.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "ManagerInbound", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/manager-inbound.css" asp-append-version="true" />
    }
    @if (User.IsInRole("SALES_STAFF") || ViewContext.RouteData.Values["controller"]?.ToString() == "Supplier" ||
        ((User.IsInRole("MANAGER") || User.IsInRole("WAREHOUSE_STAFF")) &&
         (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "SalesOrder", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "CustomerReturnOrder", StringComparison.OrdinalIgnoreCase))))
    {
        <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
    }
    @if (User.IsInRole("PURCHASING_STAFF") || User.IsInRole("MANAGER"))
    {
        <link rel="stylesheet" href="~/css/purchasing.css" asp-append-version="true" />
    }
    @if (User.IsInRole("WAREHOUSE_STAFF") || User.IsInRole("MANAGER") || User.IsInRole("CEO"))
    {
        <link rel="stylesheet" href="~/css/warehouse.css" asp-append-version="true" />
    }
    @if (ViewContext.RouteData.Values["controller"]?.ToString() is "Product" or "ManagerTransfer" or "WarehouseTransfer" or "Transfer")
    {
        <link rel="stylesheet" href="~/css/product-transfer.css" asp-append-version="true" />
    }
    @if (ViewContext.RouteData.Values["controller"]?.ToString() is "SalesOrder" or "PurchaseOrder" or "Outbound")
    {
        <link rel="stylesheet" href="~/css/order-workspace.css" asp-append-version="true" />
    }
</head>
<body class="ewms-shell">
    <partial name="_Sidebar" />
    <div class="ewms-page">
        <header class="ewms-topbar">
            <button type="button" class="ewms-icon-button" id="ewmsToggleSidebar" aria-label="Mở hoặc thu gọn menu" aria-controls="ewmsSidebar" aria-expanded="true">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>
            <div class="ewms-breadcrumb"><span>EWMS</span><i class="bi bi-chevron-right"></i><strong>@(ViewData["Title"] ?? "Tổng quan")</strong></div>
            <div class="ewms-topbar-end">
                <span class="ewms-header-label">Warehouse Management</span><span class="ewms-header-dot"></span>
            </div>
        </header>
        <main class="ewms-content" id="main-content">
            <div id="inlineNotifications" class="toast-container @(useInlineNotifications ? "position-static w-100 mb-3" : "position-fixed bottom-0 end-0 p-3")" style="z-index: 1090;">
                @if (TempData["Success"] != null)
                {
                    <div id="toastSuccess" class="toast @(useInlineNotifications ? "w-100 shadow-none" : "shadow-lg") align-items-center border-0 bg-white" role="alert" aria-live="polite" aria-atomic="true" data-bs-autohide="true" data-bs-delay="3000">
                        <div class="d-flex border-start border-success border-4 rounded-start">
                            <div class="toast-body d-flex align-items-center gap-2 text-dark">
                                <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0" aria-hidden="true"></i>
                                <div>@TempData["Success"]</div>
                            </div>
                            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div id="toastError" class="toast @(useInlineNotifications ? "w-100 shadow-none" : "shadow-lg") align-items-center border-0 bg-white" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="3000">
                        <div class="d-flex border-start border-danger border-4 rounded-start">
                            <div class="toast-body d-flex align-items-center gap-2 text-dark">
                                <i class="bi bi-exclamation-triangle-fill text-danger fs-5 flex-shrink-0" aria-hidden="true"></i>
                                <div>@TempData["Error"]</div>
                            </div>
                            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                }
            </div>
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ewms-sidebar.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inline = @Json.Serialize(useInlineNotifications);
            document.querySelectorAll('.toast-container .toast').forEach(function (el) {
                var toast = new bootstrap.Toast(el, { animation: !inline, autohide: !inline, delay: 3000 });
                toast.show();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
