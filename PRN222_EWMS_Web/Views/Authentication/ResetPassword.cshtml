@model PRN222_EWMS_Web.ViewModels.Authentication.ResetPasswordViewModel
@{ Layout = "_LoginLayout"; ViewData["Title"] = "Đặt lại mật khẩu"; ViewData["FullWidthAuth"] = true; }
<partial name="_RecoveryIntro" />
<section class="login-card recovery-card" aria-labelledby="reset-heading">
    <div class="login-card-icon" aria-hidden="true">📦</div>
    <h2 id="reset-heading">Mật khẩu mới.</h2>
    <p class="login-card-description">Chọn mật khẩu mới dài từ 8 đến 128 ký tự để truy cập EWMS.</p>
    <form asp-action="ResetPassword" method="post" class="workspace-form login-form">
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>
        <div><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
        <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <button class="workspace-button login-submit" type="submit">Đổi mật khẩu</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
