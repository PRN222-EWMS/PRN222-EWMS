@{ Layout = "_LoginLayout"; ViewData["Title"] = "Tạm thời không thể đặt lại mật khẩu"; ViewData["FullWidthAuth"] = true; }
<partial name="_RecoveryIntro" />
<section class="login-card recovery-card" aria-labelledby="unavailable-heading">
    <div class="login-card-icon" aria-hidden="true">📦</div>
    <h2 id="unavailable-heading">Hệ thống đang bận.</h2>
    <p class="login-card-description">Chưa thể kiểm tra liên kết vì cơ sở dữ liệu phản hồi quá lâu. Vui lòng thử lại sau; nếu liên kết đã hết hạn, hãy yêu cầu liên kết mới.</p>
    <a class="workspace-button login-submit recovery-action" asp-action="ForgotPassword">Yêu cầu liên kết mới</a>
    <a class="recovery-back" asp-action="Login">Quay lại đăng nhập</a>
</section>
