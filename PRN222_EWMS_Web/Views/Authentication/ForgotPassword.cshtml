@model PRN222_EWMS_Web.ViewModels.Authentication.ForgotPasswordViewModel
@{ Layout = "_LoginLayout"; ViewData["Title"] = "Quên mật khẩu"; ViewData["FullWidthAuth"] = true; }
<partial name="_RecoveryIntro" />
<section class="login-card recovery-card" aria-labelledby="forgot-heading">
    <div class="login-card-icon" aria-hidden="true">📦</div>
    <h2 id="forgot-heading">Quên mật khẩu?</h2>
    <p class="login-card-description">Nhập email của tài khoản EWMS. Chúng tôi sẽ gửi liên kết đặt lại mật khẩu nếu tài khoản đang hoạt động.</p>
    <form asp-action="ForgotPassword" method="post" class="workspace-form login-form">
        <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>
        <div><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" autofocus /><span asp-validation-for="Email"></span></div>
        <button class="workspace-button login-submit" type="submit">Gửi liên kết</button>
    </form>
    <a class="recovery-back" asp-action="Login">Quay lại đăng nhập</a>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
