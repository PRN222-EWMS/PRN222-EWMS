@{ Layout = "_LoginLayout"; ViewData["Title"] = "Liên kết không hợp lệ"; ViewData["FullWidthAuth"] = true; }
<partial name="_RecoveryIntro" />
<section class="login-card recovery-card" aria-labelledby="invalid-heading">
    <div class="login-card-icon" aria-hidden="true">📦</div>
    <h2 id="invalid-heading">Liên kết đã hết hạn.</h2>
    <p class="login-card-description">Liên kết chỉ có hiệu lực trong 1 phút và không thể dùng lại sau khi đổi mật khẩu. Hãy yêu cầu liên kết mới.</p>
    <a class="workspace-button login-submit recovery-action" asp-action="ForgotPassword">Gửi lại liên kết</a>
    <a class="recovery-back" asp-action="Login">Quay lại đăng nhập</a>
</section>
