@{ Layout = "_LoginLayout"; ViewData["Title"] = "Kiểm tra email"; ViewData["FullWidthAuth"] = true; }
<partial name="_RecoveryIntro" />
<section class="login-card recovery-card" aria-labelledby="sent-heading">
    <div class="login-card-icon" aria-hidden="true">📦</div>
    <h2 id="sent-heading">Kiểm tra email.</h2>
    <p class="login-card-description">Nếu email thuộc tài khoản đang hoạt động, bạn sẽ nhận được liên kết đặt lại mật khẩu.</p>
    <p class="recovery-note">Liên kết có hiệu lực trong 1 phút kể từ lúc gửi. Hãy kiểm tra cả thư mục Spam.</p>
    <a class="workspace-button login-submit recovery-action" asp-action="Login">Quay lại đăng nhập</a>
</section>
