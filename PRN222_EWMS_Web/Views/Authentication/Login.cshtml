@model PRN222_EWMS_Web.ViewModels.Authentication.LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Đăng nhập";
    ViewData["FullWidthAuth"] = true;
}
<section class="login-intro" aria-labelledby="login-intro-title">
    <p class="login-eyebrow">ELECTRONICS WAREHOUSE MANAGEMENT</p>
    <h1 id="login-intro-title">Mọi thứ.<br />Đúng chỗ.</h1>
    <p class="login-description">Một không gian chung cho đơn mua hàng,<br />nhận hàng và vận hành kho mỗi ngày.</p>
    <div class="login-art" aria-hidden="true">
        <div class="login-document login-document-order">
            <span class="login-sticker login-sticker-document">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v5h4M9 12h6M9 16h6" /></svg>
            </span>
            <strong>Đơn mua hàng</strong>
            <span class="login-document-line"></span>
            <span class="login-document-line login-document-line-short"></span>
            <span class="login-document-state"><span></span>Sẵn sàng nhận hàng</span>
        </div>
        <div class="login-document login-document-stock">
            <span class="login-sticker login-sticker-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3 7 9-4 9 4v11l-9 4-9-4zM3 7l9 4 9-4M12 11v11M7.5 5l9 4" /></svg>
            </span>
            <strong>Đúng hàng. Đúng vị trí.</strong>
            <span class="login-document-caption">Mỗi serial đều được theo dõi.</span>
            <svg class="login-document-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6" /></svg>
        </div>
    </div>
</section>
<section class="login-card" aria-labelledby="login-title">
    <div class="login-card-icon" aria-hidden="true">📦</div>
    <h2 id="login-title">Chào mừng trở lại.</h2>
    <p class="login-card-description">Đăng nhập để tiếp tục công việc của bạn.</p>
    @if (TempData["Success"] is string message)
    {
        <div class="workspace-notice" role="status">@message</div>
    }
    @if (TempData["GoogleError"] is string googleError)
    {
        <div class="validation-message" role="alert">@googleError</div>
    }
    <form asp-action="Login" method="post" class="workspace-form login-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>
        <div><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="username" autofocus /><span asp-validation-for="Email"></span></div>
        <div><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span></div>
        <label class="checkbox-row"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
        <a asp-action="ForgotPassword">Quên mật khẩu?</a>
        <button class="workspace-button login-submit" type="submit">Đăng nhập<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></button>
    </form>
    <form asp-action="GoogleLogin" method="post" class="workspace-form login-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <button class="workspace-button login-google" type="submit">
            <svg class="login-google-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59A14.4 14.4 0 0 1 9.75 24c0-1.59.27-3.13.76-4.59l-7.98-6.19A23.87 23.87 0 0 0 0 24c0 3.87.93 7.53 2.56 10.78l7.97-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.18 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
            <span>Đăng nhập bằng Google</span>
        </button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
