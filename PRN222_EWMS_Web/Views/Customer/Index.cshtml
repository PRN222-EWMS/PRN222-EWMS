@model PRN222_EWMS_Web.ViewModels.Sales.CustomerListViewModel
@{ ViewData["Title"] = "Khách hàng"; }
<div class="sales-page">
<div class="workspace-heading"><div><p class="eyebrow">DANH MỤC DÙNG CHUNG</p><h1>Khách hàng</h1><p class="muted">Tra cứu và cập nhật thông tin liên hệ của khách hàng.</p></div><a class="workspace-button" asp-action="Create">Tạo khách hàng</a></div>
@if(TempData["Success"] is string message){<div class="workspace-notice" role="status">@message</div>}
<section class="workspace-card"><form method="get" asp-action="Index" class="sales-filters"><div><label for="Search">Tìm khách hàng</label><input id="Search" name="Search" value="@Model.Search" maxlength="200" placeholder="Tên hoặc số điện thoại" /></div><div class="sales-toolbar"><button class="workspace-button" type="submit">Tìm kiếm</button><a class="workspace-button sales-button-secondary" asp-action="Index">Xóa bộ lọc</a></div></form>
<div class="table-wrap"><table class="workspace-table"><thead><tr><th>ID</th><th>Khách hàng</th><th>Điện thoại</th><th>Địa chỉ</th><th>Thao tác</th></tr></thead><tbody>@foreach(var customer in Model.Items){<tr><td class="sales-id">@customer.Id</td><td><a class="workspace-button sales-button-small" asp-action="Details" asp-route-id="@customer.Id">@customer.CustomerName</a></td><td>@(customer.Phone ?? "—")</td><td>@(customer.Address ?? "—")</td><td><div class="sales-actions"><a class="workspace-button sales-button-small" asp-action="Details" asp-route-id="@customer.Id">Chi tiết</a><a class="workspace-button sales-button-small" asp-action="Edit" asp-route-id="@customer.Id">Sửa</a></div></td></tr>}</tbody></table></div>
@if(Model.Items.Count == 0){<p class="sales-empty">Không có khách hàng phù hợp.</p>}
<div class="sales-pagination"><span class="muted">@Model.TotalCount khách hàng · Trang @Model.Page / @Model.TotalPages</span><nav aria-label="Phân trang khách hàng">@if(Model.Page > 1){<a class="workspace-button sales-button-small" asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search">Trước</a>}@if(Model.Page < Model.TotalPages){<a class="workspace-button sales-button-small" asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search">Sau</a>}</nav></div>
</section></div>
