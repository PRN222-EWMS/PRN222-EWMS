@model PRN222_EWMS_Web.ViewModels.Sales.CustomerFormViewModel
@{ ViewData["Title"] = "Sửa khách hàng"; }
<div class="sales-page"><div class="workspace-heading"><div><p class="eyebrow">KHÁCH HÀNG / CHỈNH SỬA</p><h1>Sửa khách hàng</h1><p class="muted">Cập nhật thông tin liên hệ hiện tại của khách hàng #@Model.Id.</p></div></div>
<section class="workspace-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="workspace-form"><input asp-for="Id" type="hidden" /><partial name="_Form" model="Model" /><div class="form-actions"><button type="submit" class="workspace-button">Lưu thay đổi</button><a class="workspace-button sales-button-secondary" asp-action="Details" asp-route-id="@Model.Id">Hủy</a></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
