@model PRN222_EWMS_Web.ViewModels.Customer.EditCustomerViewModel
@{ ViewData["Title"] = "Sửa khách hàng"; }
<div class="sales-page">
    <div class="workspace-heading"><div><p class="eyebrow">BÁN HÀNG / KHÁCH HÀNG</p><h1>Sửa khách hàng</h1><p class="muted">Cập nhật thông tin định danh và liên hệ của khách hàng #@Model.Id.</p></div><a class="workspace-button sales-button-secondary" asp-action="Details" asp-route-id="@Model.Id" asp-route-search="@Model.ReturnFilter.Search" asp-route-page="@Model.ReturnFilter.Page">← Quay lại</a></div>
    <section class="workspace-card" aria-label="Form chỉnh sửa khách hàng">
        <form id="editCustomerForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="workspace-form mt-0" data-validation-retry="@((!ViewData.ModelState.IsValid || Model.HasDuplicatePhoneWarning).ToString().ToLowerInvariant())">
            <input asp-for="Id" type="hidden" />
            <partial name="_Form" model="Model" />
            <div class="form-actions justify-content-end"><button id="saveCustomerButton" type="submit" class="workspace-button" disabled><i class="bi bi-save" aria-hidden="true"></i> Lưu thay đổi</button><a class="workspace-button sales-button-secondary" asp-action="Details" asp-route-id="@Model.Id" asp-route-search="@Model.ReturnFilter.Search" asp-route-page="@Model.ReturnFilter.Page">Hủy</a></div>
        </form>
    </section>
</div>
<div class="modal fade" id="confirmCustomerEditModal" tabindex="-1" aria-labelledby="confirmCustomerEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="confirmCustomerEditLabel">Xác nhận cập nhật khách hàng</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body">Bạn có chắc chắn muốn cập nhật thông tin khách hàng này không?</div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="button" class="workspace-button" id="confirmCustomerSave">Xác nhận</button></div>
    </div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('editCustomerForm');
            const saveButton = document.getElementById('saveCustomerButton');
            const confirmButton = document.getElementById('confirmCustomerSave');
            const modal = new bootstrap.Modal(document.getElementById('confirmCustomerEditModal'));
            const fields = Array.from(form.querySelectorAll('input[name]:not([type="hidden"]):not([disabled]), textarea[name]'));
            const valueOf = field => field.type === 'checkbox' ? field.checked : field.value.trim();
            const original = new Map(fields.map(field => [field.name, valueOf(field)]));
            const validationRetry = form.dataset.validationRetry === 'true';
            const duplicateConfirmation = form.querySelector('input[type="checkbox"][name="ConfirmDuplicatePhone"]');
            let confirmed = false;
            function updateSaveButton() {
                const changed = fields.some(field => valueOf(field) !== original.get(field.name));
                const canRetry = validationRetry && (!duplicateConfirmation || duplicateConfirmation.checked);
                saveButton.disabled = !(changed || canRetry);
            }
            fields.forEach(field => {
                field.addEventListener('input', updateSaveButton);
                field.addEventListener('change', updateSaveButton);
            });
            updateSaveButton();
            form.addEventListener('submit', function (event) {
                if (saveButton.disabled) { event.preventDefault(); return; }
                if (!form.checkValidity() || (window.jQuery && !window.jQuery(form).valid())) {
                    event.preventDefault();
                    confirmed = false;
                    form.reportValidity();
                    return;
                }
                if (confirmed) { confirmed = false; return; }
                event.preventDefault();
                modal.show();
            });
            confirmButton.addEventListener('click', function () {
                confirmed = true;
                modal.hide();
                form.requestSubmit(saveButton);
                confirmed = false;
            });
        });
    </script>
}
