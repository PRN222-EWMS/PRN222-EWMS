@model PRN222_EWMS_Web.ViewModels.Customer.CustomerDetailsViewModel
@using PRN222_EWMS_Web.ViewModels.Sales
@{ ViewData["Title"] = "Chi tiết khách hàng"; }
<div class="sales-page">
    <div class="workspace-heading"><div><p class="eyebrow">BÁN HÀNG / KHÁCH HÀNG</p><h1>@Model.DisplayName</h1><p class="muted">Khách hàng #@Model.Id</p></div><div class="sales-toolbar"><a class="workspace-button sales-button-secondary" asp-action="Index" asp-route-search="@Model.ReturnFilter.Search" asp-route-page="@Model.ReturnFilter.Page">← Danh sách</a><a class="workspace-button" asp-action="Edit" asp-route-id="@Model.Id" asp-route-search="@Model.ReturnFilter.Search" asp-route-page="@Model.ReturnFilter.Page"><i class="bi bi-pencil" aria-hidden="true"></i> Sửa thông tin</a></div></div>
    @if (TempData["Success"] is string message) { <div class="workspace-notice" role="status">@message</div> }
    <section class="workspace-card" aria-label="Thông tin khách hàng"><h2>Thông tin liên hệ</h2><dl class="sales-details"><div><dt>Tên khách hàng</dt><dd>@Model.CustomerName</dd></div><div><dt>Tên gợi nhớ</dt><dd>@(Model.Nickname ?? "—")</dd></div><div><dt>Điện thoại</dt><dd>@(Model.Phone ?? "—")</dd></div><div><dt>Email</dt><dd>@(Model.Email ?? "—")</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.Address ?? "—")</dd></div></dl></section>
    <section class="workspace-card" aria-label="Đơn bán hàng của khách hàng"><h2>Đơn bán hàng liên quan</h2>
        <div class="table-wrap"><table class="workspace-table"><thead><tr><th scope="col">Mã đơn</th><th scope="col">Ngày đơn</th><th scope="col">Kho xuất</th><th scope="col">Người tạo</th><th scope="col">Trạng thái đơn</th></tr></thead><tbody>
        @foreach (var order in Model.Orders)
        {
            <tr><td><a class="sales-code-badge" asp-controller="SalesOrder" asp-action="Details" asp-route-id="@order.Id">@order.Code</a></td><td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@order.WarehouseName</td><td>@order.CreatedByName</td><td><span class="sales-status">@SalesDisplay.Status(order.Status)</span>@if (order.HasShortage) { <div class="sales-muted-small">Thiếu nguồn</div> }</td></tr>
        }
        </tbody></table></div>
        @if (Model.Orders.Count == 0) { <p class="sales-empty">Khách hàng chưa có đơn bán hàng.</p> }
    </section>
</div>
