@model PRN222_EWMS_Web.ViewModels.Sales.CustomerDetailsViewModel
@using PRN222_EWMS_Web.ViewModels.Sales
@{ ViewData["Title"] = "Chi tiết khách hàng"; }
<div class="sales-page"><div class="workspace-heading"><div><p class="eyebrow">KHÁCH HÀNG / CHI TIẾT</p><h1>@Model.CustomerName</h1><p class="muted">Khách hàng #@Model.Id</p></div><div class="sales-toolbar"><a class="workspace-button sales-button-secondary" asp-action="Index">← Danh sách</a><a class="workspace-button" asp-action="Edit" asp-route-id="@Model.Id">Sửa thông tin</a></div></div>
@if(TempData["Success"] is string message){<div class="workspace-notice" role="status">@message</div>}
<section class="workspace-card"><h2>Thông tin liên hệ</h2><dl class="sales-details"><div><dt>Tên khách hàng</dt><dd>@Model.CustomerName</dd></div><div><dt>Điện thoại</dt><dd>@(Model.Phone ?? "—")</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.Address ?? "—")</dd></div></dl></section>
<section class="workspace-card"><h2>Đơn bán hàng liên quan</h2><div class="table-wrap"><table class="workspace-table"><thead><tr><th>Mã đơn</th><th>Ngày đơn</th><th>Kho xuất</th><th>Người tạo</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var order in Model.Orders){<tr><td><a class="workspace-button sales-button-small" asp-controller="SalesOrder" asp-action="Details" asp-route-id="@order.Id">@order.Code</a></td><td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@order.WarehouseName</td><td>@order.CreatedByName</td><td><span class="sales-status">@SalesDisplay.Status(order.Status)</span>@if(order.HasShortage){<div class="sales-muted-small">Thiếu nguồn</div>}</td></tr>}</tbody></table></div>@if(Model.Orders.Count == 0){<p class="sales-empty">Khách hàng chưa có đơn bán hàng.</p>}</section></div>
