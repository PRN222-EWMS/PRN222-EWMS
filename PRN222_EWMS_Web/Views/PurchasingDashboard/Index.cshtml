@model PRN222_EWMS_Web.ViewModels.Purchasing.PurchasingDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Mua hàng";
}

<div class="po-page">
    <div class="workspace-heading">
        <div>
            <p class="eyebrow">PURCHASING WORKSPACE</p>
            <h1>Tổng quan mua hàng</h1>
            <p class="muted">Xin chào <strong>@Model.UserFullName</strong>, theo dõi tiến độ đơn mua hàng và đối tác cung ứng của bộ phận.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="workspace-button" asp-controller="PurchaseOrder" asp-action="Create">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Tạo đơn mua hàng
            </a>
            <a class="workspace-button sales-button-secondary" asp-controller="Supplier" asp-action="Create">
                <i class="bi bi-truck me-1" aria-hidden="true"></i> Thêm nhà cung cấp
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="po-stats">
        <a class="po-stat" asp-controller="PurchaseOrder" asp-action="Index" asp-route-Status="DRAFT">
            <span>Đơn nháp cần xác nhận</span>
            <strong>@Model.DraftCount</strong>
        </a>
        <a class="po-stat" asp-controller="PurchaseOrder" asp-action="Index" asp-route-Status="CONFIRMED">
            <span>Chờ kho tiếp nhận</span>
            <strong>@Model.WaitingInboundCount</strong>
        </a>
        <a class="po-stat @(Model.OverdueCount > 0 ? "border-danger text-danger" : "")" asp-controller="PurchaseOrder" asp-action="Index">
            <span class="@(Model.OverdueCount > 0 ? "text-danger" : "")">Đơn quá hạn giao</span>
            <strong class="@(Model.OverdueCount > 0 ? "text-danger" : "")">@Model.OverdueCount</strong>
        </a>
        <a class="po-stat" asp-controller="Supplier" asp-action="Index" asp-route-Status="ACTIVE">
            <span>Nhà cung cấp hoạt động</span>
            <strong>@Model.ActiveSupplierCount</strong>
        </a>
    </div>

    <!-- Recent & Urgent POs -->
    <section class="workspace-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="mb-1" style="font-size: 20px; font-weight: 700;">Đơn mua hàng gần đây</h2>
                <p class="muted mb-0">Theo dõi tiến độ nhận hàng và các mốc thời gian giao hàng quan trọng.</p>
            </div>
            <div>
                <a class="workspace-button sales-button-secondary" asp-controller="PurchaseOrder" asp-action="Index">
                    Xem tất cả đơn mua hàng
                </a>
            </div>
        </div>

        @if (Model.RecentOrders.Count == 0)
        {
            <div class="sales-empty">
                <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                <span>Chưa có đơn mua hàng nào trong hệ thống.</span>
                <div class="mt-3">
                    <a class="workspace-button" asp-controller="PurchaseOrder" asp-action="Create">Tạo đơn mua hàng đầu tiên</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="workspace-table">
                    <thead>
                        <tr>
                            <th>Mã đơn (PO)</th>
                            <th>Nhà cung cấp</th>
                            <th>Kho tiếp nhận</th>
                            <th>Người tạo</th>
                            <th>Ngày đặt / Dự kiến đến</th>
                            <th>Tiến độ nhận hàng</th>
                            <th>Trạng thái</th>
                            <th style="text-align: right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            var statusText = order.Status switch
                            {
                                "DRAFT" => "Bản nháp",
                                "CONFIRMED" => "Đã xác nhận",
                                "PARTIALLY_RECEIVED" => "Đang nhận 1 phần",
                                "RECEIVED" => "Đã nhận đủ",
                                "CLOSED" => "Đã đóng",
                                "CANCELLED" => "Đã hủy",
                                _ => order.Status
                            };

                            var statusClass = order.Status switch
                            {
                                "DRAFT" => "po-status-draft",
                                "CONFIRMED" => "po-status-confirmed",
                                "PARTIALLY_RECEIVED" => "po-status-partially",
                                "RECEIVED" => "po-status-received",
                                "CLOSED" => "po-status-closed",
                                "CANCELLED" => "po-status-cancelled",
                                _ => "po-status-draft"
                            };

                            <tr>
                                <td>
                                    <a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@order.PurchaseOrderId" class="fw-semibold text-primary text-decoration-none">
                                        @order.Pocode
                                    </a>
                                </td>
                                <td>
                                    <div>@order.SupplierName</div>
                                </td>
                                <td>
                                    <div>@order.WarehouseName</div>
                                </td>
                                <td>
                                    <div>@order.CreatedByName</div>
                                </td>
                                <td>
                                    <div>@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div class="muted small">
                                        Đến: @order.ExpectedArrivalDate.ToString("dd/MM/yyyy")
                                    </div>
                                    @if (order.IsOverdue)
                                    {
                                        <div class="po-overdue-tag">
                                            <i class="bi bi-clock-history" aria-hidden="true"></i> Quá hạn giao
                                        </div>
                                    }
                                </td>
                                <td style="min-width: 180px;">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Đã nhận: <strong>@order.TotalReceivedQuantity</strong>/@order.TotalOrderedQuantity</span>
                                        <span>@order.ProgressPercent%</span>
                                    </div>
                                    <div class="po-progress-wrap">
                                        <div class="po-progress-bar">
                                            <div class="po-progress-fill @(order.TotalReceivedQuantity < order.TotalOrderedQuantity ? "partial" : "")" 
                                                 style="width: @(order.ProgressPercent)%"></div>
                                        </div>
                                    </div>
                                    <div class="small muted mt-1">
                                        Còn lại: <span class="fw-medium text-dark">@order.TotalRemainingQuantity</span>
                                        @if (order.TotalClosedQuantity > 0)
                                        {
                                            <span class="text-secondary">(Đóng: @order.TotalClosedQuantity)</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="po-status @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a class="workspace-button sales-button-small" asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@order.PurchaseOrderId" title="Xem chi tiết">
                                        Chi tiết
                                    </a>
                                    @if (order.CanEdit)
                                    {
                                        <a class="workspace-link p-1 text-secondary" asp-controller="PurchaseOrder" asp-action="Edit" asp-route-id="@order.PurchaseOrderId" title="Chỉnh sửa">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
