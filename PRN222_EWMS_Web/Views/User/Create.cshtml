@model PRN222_EWMS_Web.ViewModels.Admin.CreateAccountViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
    var warehouseRoleId = Model.Roles.FirstOrDefault(r => r.Text == "WAREHOUSE_STAFF")?.Value;
    var isWarehouseStaff = warehouseRoleId is not null && Model.RoleId.ToString() == warehouseRoleId;
}
<div class="workspace-heading"><div><p class="eyebrow">QUẢN TRỊ / NGƯỜI DÙNG</p><h1>Tạo tài khoản</h1><p class="muted">Cấp tài khoản và vai trò cho thành viên mới.</p></div></div>
<section class="workspace-card">
<form asp-action="Create" method="post" class="workspace-form" data-warehouse-role-id="@warehouseRoleId">
    <div asp-validation-summary="All" class="validation-message" role="alert"></div>
    <div class="form-grid">
        <div><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
        <div><label asp-for="Username"></label><input asp-for="Username" autocomplete="off" /><span asp-validation-for="Username"></span></div>
        <div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
        <div><label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" /><span asp-validation-for="Phone"></span></div>
        <div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
        <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <div><label asp-for="RoleId"></label><select asp-for="RoleId" asp-items="Model.Roles"><option value="">Chọn vai trò</option></select><span asp-validation-for="RoleId"></span></div>
        <div><label asp-for="WarehouseId"></label><select asp-for="WarehouseId" asp-items="Model.Warehouses" disabled="@(!isWarehouseStaff)" required="@isWarehouseStaff" aria-describedby="warehouse-help"><option value="">@(isWarehouseStaff ? "Chọn kho làm việc" : "Chỉ dành cho nhân viên kho")</option></select><span asp-validation-for="WarehouseId"></span><small class="muted" id="warehouse-help">Chỉ áp dụng cho WAREHOUSE_STAFF.</small></div>
    </div>
    <div class="form-actions"><button class="workspace-button" type="submit">Tạo tài khoản</button><a class="workspace-link" asp-action="Index">Hủy</a></div>
</form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-account.js" asp-append-version="true"></script>
}
