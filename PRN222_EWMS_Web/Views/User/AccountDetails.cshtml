@model PRN222_EWMS_Web.ViewModels.Admin.AccountDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="workspace-heading">
    <div>
        <p class="eyebrow">QUẢN TRỊ / TÀI KHOẢN</p>
        <h1>Chi tiết tài khoản</h1>
        <p class="muted">Thông tin hồ sơ, vai trò và trạng thái tài khoản.</p>
    </div>
    <a class="workspace-link" asp-controller="AccountList" asp-action="Index"
       asp-route-search="@Model.ReturnFilter.Search" asp-route-roleId="@Model.ReturnFilter.RoleId"
       asp-route-status="@Model.ReturnFilter.Status" asp-route-warehouseId="@Model.ReturnFilter.WarehouseId"
       asp-route-page="@Model.ReturnFilter.Page">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại danh sách
    </a>
</div>

<section class="workspace-card" aria-label="Thông tin tài khoản">
    <div class="workspace-heading">
        <div>
            <p class="eyebrow">TÀI KHOẢN</p>
            <h2>@Model.FullName</h2>
        </div>
        <span class="badge rounded-pill @Model.StatusClass">@Model.StatusLabel</span>
    </div>

    <dl class="profile-details">
        <div>
            <dt>Email</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cung cấp" : Model.Email)</dd>
        </div>
        <div>
            <dt>Số điện thoại</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cung cấp" : Model.Phone)</dd>
        </div>
        <div>
            <dt>Vai trò</dt>
            <dd><span class="role-badge">@Model.RoleName</span></dd>
        </div>
        <div>
            <dt>Kho làm việc</dt>
            <dd>@Model.WarehouseDisplay</dd>
        </div>
        <div>
            <dt>Ngày tạo</dt>
            <dd>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </div>
    </dl>
</section>
